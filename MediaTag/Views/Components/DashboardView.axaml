<UserControl
    x:Class="MediaTag.Views.Components.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:components="clr-namespace:MediaTag.ViewModels.Components"
    xmlns:converters="clr-namespace:MediaTag.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Name="UserControl"
    x:DataType="components:DashboardViewModel"
    Loaded="UserControl_OnLoaded">
    <UserControl.Resources>
        <SolidColorBrush x:Key="ClaudeCanvasBrush" Color="#F7F3EA" />
        <SolidColorBrush x:Key="ClaudePanelBrush" Color="#FFFDF8" />
        <SolidColorBrush x:Key="ClaudeRailBrush" Color="#1E1E1A" />
        <SolidColorBrush x:Key="ClaudeTextBrush" Color="#2F2A24" />
        <SolidColorBrush x:Key="ClaudeMutedBrush" Color="#7E766B" />
        <SolidColorBrush x:Key="ClaudeBorderBrush" Color="#DDD5C8" />
        <SolidColorBrush x:Key="ClaudeAccentBrush" Color="#C96442" />
        <SolidColorBrush x:Key="ClaudeAccentForegroundBrush" Color="#FFFFFF" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource ClaudeMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.download-action">
            <Setter Property="Foreground" Value="{StaticResource ClaudeMutedBrush}" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />

            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#14000000" />
                <Setter Property="Foreground" Value="{StaticResource ClaudeTextBrush}" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid Background="{StaticResource ClaudeCanvasBrush}" ColumnDefinitions="64,*">
        <!--  Rail  -->
        <Border Grid.Column="0" Background="{StaticResource ClaudeRailBrush}">
            <Grid Margin="8" RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0" Spacing="8">
                    <Border
                        Width="40"
                        Height="40"
                        Background="{StaticResource ClaudeAccentBrush}"
                        CornerRadius="8">
                        <materialIcons:MaterialIcon
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                            Kind="Download" />
                    </Border>

                    <Button
                        Padding="8"
                        Command="{Binding ShowAuthSetupCommand}"
                        Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                        IsVisible="{OnPlatform False,
                                               Windows=True}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.AuthTooltip}">
                        <materialIcons:MaterialIcon
                            Width="24"
                            Height="24"
                            Kind="AccountKey" />
                    </Button>

                    <Button
                        Padding="8"
                        Command="{Binding ShowSettingsCommand}"
                        Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.SettingsTooltip}">
                        <materialIcons:MaterialIcon
                            Width="24"
                            Height="24"
                            Kind="Settings" />
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    IsVisible="{Binding !!Downloads.Count}"
                    Spacing="8">
                    <Button
                        Padding="8"
                        Command="{Binding ShowDownloadsListViewCommand}"
                        Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                        IsEnabled="{Binding !IsDownloadsListView}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.ListViewTooltip}">
                        <materialIcons:MaterialIcon
                            Width="24"
                            Height="24"
                            Kind="ViewList" />
                    </Button>

                    <Button
                        Padding="8"
                        Command="{Binding ShowDownloadsGridViewCommand}"
                        Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                        IsEnabled="{Binding !IsDownloadsGridView}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        ToolTip.Tip="{Binding LocalizationManager.GridViewTooltip}">
                        <materialIcons:MaterialIcon
                            Width="24"
                            Height="24"
                            Kind="ViewGrid" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Main  -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <!--  Composer  -->
            <StackPanel
                Grid.Row="0"
                MaxWidth="880"
                Margin="48,44,48,24"
                HorizontalAlignment="Center"
                Spacing="18">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Georgia"
                    FontSize="34"
                    Foreground="{StaticResource ClaudeTextBrush}"
                    IsVisible="{Binding !Downloads.Count}"
                    Text="{Binding LocalizationManager.DashboardPromptTitle}" />

                <Border
                    Padding="12"
                    Background="{StaticResource ClaudePanelBrush}"
                    BorderBrush="{StaticResource ClaudeBorderBrush}"
                    BorderThickness="1"
                    BoxShadow="0 18 40 0 #1A000000"
                    CornerRadius="8">
                    <Grid RowDefinitions="Auto,Auto">
                        <TextBox
                            x:Name="QueryTextBox"
                            Grid.Row="0"
                            AcceptsReturn="True"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="16"
                            Foreground="{StaticResource ClaudeTextBrush}"
                            MaxLines="5"
                            MinHeight="72"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            Text="{Binding Query}"
                            Theme="{DynamicResource SoloTextBox}"
                            ToolTip.Tip="{Binding LocalizationManager.QueryTooltip}"
                            Watermark="{Binding LocalizationManager.QueryWatermark}" />

                        <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="Auto,*,Auto">
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <materialIcons:MaterialIcon
                                    Width="20"
                                    Height="20"
                                    Foreground="{StaticResource ClaudeMutedBrush}"
                                    Kind="LinkVariant" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{StaticResource ClaudeMutedBrush}"
                                    Text="{Binding LocalizationManager.QueryWatermark}" />
                            </StackPanel>

                            <ProgressBar
                                Grid.Column="1"
                                Height="2"
                                Margin="16,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                IsIndeterminate="{Binding IsProgressIndeterminate}"
                                Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />

                            <Button
                                x:Name="ProcessQueryButton"
                                Grid.Column="2"
                                Width="40"
                                Height="40"
                                Padding="8"
                                Background="{StaticResource ClaudeTextBrush}"
                                Command="{Binding ProcessQueryCommand}"
                                Foreground="{StaticResource ClaudeAccentForegroundBrush}"
                                IsDefault="True"
                                Theme="{DynamicResource MaterialFlatButton}"
                                ToolTip.Tip="{Binding LocalizationManager.ProcessQueryTooltip}">
                                <materialIcons:MaterialIcon
                                    Width="22"
                                    Height="22"
                                    Kind="ArrowUp" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <!--  Empty state  -->
            <StackPanel
                Grid.Row="1"
                Margin="48,0,48,0"
                HorizontalAlignment="Center"
                IsVisible="{Binding !Downloads.Count}"
                Orientation="Horizontal"
                Spacing="10">
                <materialIcons:MaterialIcon
                    Width="18"
                    Height="18"
                    Foreground="{StaticResource ClaudeMutedBrush}"
                    Kind="KeyboardReturn" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource ClaudeMutedBrush}"
                    Inlines="{Binding LocalizationManager.DashboardPlaceholder, Converter={x:Static converters:MarkdownToInlinesConverter.Instance}}"
                    TextAlignment="Center" />
            </StackPanel>

            <!--  Downloads  -->
            <Grid
                Grid.Row="2"
                Margin="32,0,32,24"
                IsVisible="{Binding !!Downloads.Count}">
                <Border
                    Background="{StaticResource ClaudePanelBrush}"
                    BorderBrush="{StaticResource ClaudeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Panel>
                        <DataGrid
                            Background="Transparent"
                            BorderThickness="0"
                            ColumnWidth="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding IsDownloadsListView}"
                            ItemsSource="{Binding Downloads}"
                            VerticalScrollBarVisibility="Visible">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding RemoveSuccessfulDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveSuccessful}" />
                                    <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveInactive}" />
                                    <Separator />
                                    <MenuItem Command="{Binding RestartFailedDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRestartFailed}" />
                                    <Separator />
                                    <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <!--  Thumbnail  -->
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="52"
                                                Height="52"
                                                ClipToBounds="True"
                                                CornerRadius="6">
                                                <Image
                                                    Stretch="UniformToFill"
                                                    asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  File name  -->
                                <DataGridTemplateColumn
                                    Width="*"
                                    Header="{Binding #UserControl.DataContext.LocalizationManager.DownloadsFileColumnHeader}"
                                    SortMemberPath="FileName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontSize="14"
                                                Foreground="{StaticResource ClaudeTextBrush}"
                                                Text="{Binding FileName}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding FileName}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Status  -->
                                <DataGridTemplateColumn
                                    MinWidth="110"
                                    Header="{Binding #UserControl.DataContext.LocalizationManager.DownloadsStatusColumnHeader}"
                                    SortMemberPath="Progress.Current.Fraction">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,Auto">
                                                <ProgressBar
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                    IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                    Theme="{DynamicResource MaterialCircularProgressBar}"
                                                    Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />

                                                <TextBlock
                                                    x:Name="StatusTextBlock"
                                                    Grid.Column="1"
                                                    Classes.canceled="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Canceled}}"
                                                    Classes.completed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Completed}}"
                                                    Classes.enqueued="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Enqueued}}"
                                                    Classes.failed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Failed}}"
                                                    Classes.started="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                    PointerReleased="StatusTextBlock_OnPointerReleased"
                                                    TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Styles>
                                                        <Style Selector="TextBlock">
                                                            <Style Selector="^.enqueued">
                                                                <Setter Property="Foreground" Value="{StaticResource ClaudeMutedBrush}" />
                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusEnqueued}" />
                                                            </Style>
                                                            <Style Selector="^.started">
                                                                <Setter Property="Foreground" Value="{StaticResource ClaudeAccentBrush}" />
                                                                <Setter Property="Text" Value="{Binding Progress.Current}" />
                                                            </Style>
                                                            <Style Selector="^.completed">
                                                                <Setter Property="Foreground" Value="#247A3D" />
                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCompleted}" />
                                                            </Style>
                                                            <Style Selector="^.canceled">
                                                                <Setter Property="Foreground" Value="#A05D17" />
                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCanceled}" />
                                                            </Style>
                                                            <Style Selector="^.failed">
                                                                <Setter Property="Foreground" Value="#B33422" />
                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusFailed}" />
                                                                <Setter Property="ToolTip.Tip">
                                                                    <Template>
                                                                        <TextBlock>
                                                                            <Run FontWeight="SemiBold" Text="{Binding LocalizationManager.ClickToCopyErrorTooltip}" />
                                                                            <LineBreak />
                                                                            <LineBreak />
                                                                            <Run Text="{Binding ErrorMessage}" />
                                                                        </TextBlock>
                                                                    </Template>
                                                                </Setter>
                                                                <Setter Property="Cursor" Value="Hand" />
                                                            </Style>
                                                        </Style>
                                                    </TextBlock.Styles>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!--  Buttons  -->
                                <DataGridTemplateColumn MinWidth="116">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button
                                                    Classes="download-action"
                                                    Padding="4"
                                                    Command="{Binding ShowFileCommand}"
                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                                                    <materialIcons:MaterialIcon
                                                        Width="22"
                                                        Height="22"
                                                        Kind="FileFindOutline" />
                                                </Button>
                                                <Button
                                                    Classes="download-action"
                                                    Padding="4"
                                                    Command="{Binding OpenFileCommand}"
                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    ToolTip.Tip="{Binding LocalizationManager.PlayTooltip}">
                                                    <materialIcons:MaterialIcon
                                                        Width="22"
                                                        Height="22"
                                                        Kind="PlayCircleOutline" />
                                                </Button>
                                                <Button
                                                    Classes="download-action"
                                                    Padding="4"
                                                    Command="{Binding CancelCommand}"
                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                    <materialIcons:MaterialIcon
                                                        Width="22"
                                                        Height="22"
                                                        Kind="CloseCircleOutline" />
                                                </Button>
                                                <Button
                                                    Classes="download-action"
                                                    Padding="4"
                                                    Command="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).RestartDownloadCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding IsCanceledOrFailed}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                    <materialIcons:MaterialIcon
                                                        Width="22"
                                                        Height="22"
                                                        Kind="Restart" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Disabled"
                            IsVisible="{Binding IsDownloadsGridView}"
                            SizeChanged="DownloadsGrid_OnSizeChanged"
                            VerticalScrollBarVisibility="Auto">
                            <ScrollViewer.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding RemoveSuccessfulDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveSuccessful}" />
                                    <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveInactive}" />
                                    <Separator />
                                    <MenuItem Command="{Binding RestartFailedDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRestartFailed}" />
                                    <Separator />
                                    <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                                </ContextMenu>
                            </ScrollViewer.ContextMenu>

                            <ItemsControl ItemsSource="{Binding Downloads}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).DownloadGridItemWidth}"
                                            Height="184"
                                            Margin="4"
                                            Padding="8"
                                            Background="{StaticResource ClaudePanelBrush}"
                                            BorderBrush="{StaticResource ClaudeBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6">
                                            <Grid RowDefinitions="Auto,*,Auto,Auto">
                                                <Border
                                                    Grid.Row="0"
                                                    Height="88"
                                                    ClipToBounds="True"
                                                    CornerRadius="5">
                                                    <Image
                                                        Stretch="UniformToFill"
                                                        asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />
                                                </Border>

                                                <TextBlock
                                                    Grid.Row="1"
                                                    Margin="0,8,0,6"
                                                    FontSize="13"
                                                    Foreground="{StaticResource ClaudeTextBrush}"
                                                    Text="{Binding FileName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip.Tip="{Binding FileName}" />

                                                <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                    <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                                        <ProgressBar
                                                            Grid.Column="0"
                                                            Width="18"
                                                            Height="18"
                                                            Margin="0,0,6,0"
                                                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                            IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                            Theme="{DynamicResource MaterialCircularProgressBar}"
                                                            Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />

                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Classes.canceled="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Canceled}}"
                                                            Classes.completed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Completed}}"
                                                            Classes.enqueued="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Enqueued}}"
                                                            Classes.failed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Failed}}"
                                                            Classes.started="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                            FontSize="12"
                                                            MaxWidth="96"
                                                            PointerReleased="StatusTextBlock_OnPointerReleased"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock">
                                                                    <Style Selector="^.enqueued">
                                                                        <Setter Property="Foreground" Value="{StaticResource ClaudeMutedBrush}" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusEnqueued}" />
                                                                    </Style>
                                                                    <Style Selector="^.started">
                                                                        <Setter Property="Foreground" Value="{StaticResource ClaudeAccentBrush}" />
                                                                        <Setter Property="Text" Value="{Binding Progress.Current}" />
                                                                    </Style>
                                                                    <Style Selector="^.completed">
                                                                        <Setter Property="Foreground" Value="#247A3D" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCompleted}" />
                                                                    </Style>
                                                                    <Style Selector="^.canceled">
                                                                        <Setter Property="Foreground" Value="#A05D17" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCanceled}" />
                                                                    </Style>
                                                                    <Style Selector="^.failed">
                                                                        <Setter Property="Foreground" Value="#B33422" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusFailed}" />
                                                                        <Setter Property="ToolTip.Tip">
                                                                            <Template>
                                                                                <TextBlock>
                                                                                    <Run FontWeight="SemiBold" Text="{Binding LocalizationManager.ClickToCopyErrorTooltip}" />
                                                                                    <LineBreak />
                                                                                    <LineBreak />
                                                                                    <Run Text="{Binding ErrorMessage}" />
                                                                                </TextBlock>
                                                                            </Template>
                                                                        </Setter>
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </Style>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                        </TextBlock>
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="2"
                                                            Command="{Binding ShowFileCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="20"
                                                                Height="20"
                                                                Kind="FileFindOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="2"
                                                            Command="{Binding OpenFileCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.PlayTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="20"
                                                                Height="20"
                                                                Kind="PlayCircleOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="2"
                                                            Command="{Binding CancelCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="20"
                                                                Height="20"
                                                                Kind="CloseCircleOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="2"
                                                            Command="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).RestartDownloadCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding IsCanceledOrFailed}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="20"
                                                                Height="20"
                                                                Kind="Restart" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <ProgressBar
                                                    Grid.Row="3"
                                                    Height="2"
                                                    Margin="0,8,0,0"
                                                    IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                    Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Panel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
