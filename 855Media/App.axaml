<Application
    x:Class="_855Media.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:framework="clr-namespace:_855Media.Framework"
    xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    xmlns:materialControls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:materialStyles="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
    Name="855Media"
    ActualThemeVariantChanged="Application_OnActualThemeVariantChanged">
    <Application.DataTemplates>
        <framework:ViewManager />
    </Application.DataTemplates>

    <Application.Styles>
        <!--  This theme is used as a stub to pre-load default resources, the actual colors are set through code  -->
        <materialStyles:MaterialTheme
            BaseTheme="Dark"
            PrimaryColor="Grey"
            SecondaryColor="DeepOrange" />
        <materialIcons:MaterialIconStyles />
        <dialogHostAvalonia:DialogHostStyles />

        <!-- Global Modern Typography & Animations -->
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.18" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>

        <!--  Combo box  -->
        <Style Selector="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif" />
            <Setter Property="FontSize" Value="14" />

            <Style Selector="^ /template/ Panel#PART_RootPanel">
                <Setter Property="Height" Value="22" />
            </Style>

            <Style Selector="^ /template/ ToggleButton">
                <Style Selector="^:checked, ^:unchecked">
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />

                    <Style Selector="^ ContentPresenter#contentPresenter">
                        <Setter Property="Margin" Value="12,8" />
                    </Style>
                </Style>
            </Style>
        </Style>

        <!--  Context menu  -->
        <Style Selector="ContextMenu">
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Data grid  -->
        <Style Selector="DataGrid">
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDividerBrush}" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="AreSeparatorsVisible" Value="False" />
        </Style>

        <Style Selector="DataGridRow">
            <Style Selector="^:selected /template/ Rectangle#BackgroundRectangle">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:pointerover /template/ Rectangle#BackgroundRectangle">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!--  Dialog host  -->
        <Style Selector="dialogHostAvalonia|DialogHost">
            <Setter Property="DialogMargin" Value="0" />
        </Style>

        <Style Selector="dialogHostAvalonia|DialogOverlayPopupHost">
            <Setter Property="Margin" Value="24" />
            <Setter Property="Background" Value="{DynamicResource AntigravityPanelBrush}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!--  Snack bar host  -->
        <Style Selector="materialControls|SnackbarHost">
            <Setter Property="SnackbarHorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Style Selector="^ /template/ ItemsControl#PART_SnackbarHostItemsContainer materialControls|Card">
                <Setter Property="Background" Value="{DynamicResource MaterialDarkBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource MaterialDarkForegroundBrush}" />
            </Style>

            <Style Selector="^ /template/ ItemsControl#PART_SnackbarHostItemsContainer Button">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryHueMidBrush}" />
            </Style>
        </Style>

        <!--  Progress bar  -->
        <Style Selector="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AntigravityAccentBrush}" />
            <Setter Property="materialAssists:TransitionAssist.DisableTransitions" Value="True" />

            <Style Selector="^:horizontal">
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </Style>

        <!--  Slider  -->
        <Style Selector="Slider">
            <Style Selector="^ /template/ ProgressBar#PART_ProgressLayer">
                <Style Selector="^:horizontal">
                    <Style Selector="^ Panel#PART_InnerPanel">
                        <Setter Property="Height" Value="2" />

                        <Style Selector="^ Border#PART_InactiveState">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Height" Value="2" />
                        </Style>

                        <Style Selector="^ Border#PART_Indicator">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </Style>
                </Style>
            </Style>

            <Style Selector="^ /template/ Track#PART_Track">
                <Style Selector="^:horizontal">
                    <Setter Property="Margin" Value="4,0" />
                </Style>

                <Style Selector="^ Border#PART_HoverEffect">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="24" />
                </Style>

                <Style Selector="^ Border#PART_ThumbGrip">
                    <Setter Property="Width" Value="12" />
                    <Setter Property="Height" Value="12" />
                </Style>
            </Style>
        </Style>

        <!--  Run  -->
        <Style Selector="Run">
            <Setter Property="BaselineAlignment" Value="Center" />
        </Style>

        <!--  Text box  -->
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="14" />
        </Style>

        <!--  Toggle switch  -->
        <Style Selector="ToggleSwitch">
            <Setter Property="materialAssists:ToggleSwitchAssist.SwitchThumbOffBackground" Value="{DynamicResource ToggleBackgroundBrush}" />
        </Style>

        <!--  Tooltip  -->
        <Style Selector="ToolTip">
            <Setter Property="TextElement.FontSize" Value="14" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
            <Setter Property="TextElement.FontStyle" Value="Normal" />
            <Setter Property="TextElement.FontStretch" Value="Normal" />
        </Style>

        <!--  Flyout presenter  -->
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ToggleBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityCanvasBrush" Color="#121316" />
                    <SolidColorBrush x:Key="AntigravityPanelBrush" Color="#1E1F23" />
                    <SolidColorBrush x:Key="AntigravityElevatedBrush" Color="#26272C" />
                    <SolidColorBrush x:Key="AntigravityCardBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="AntigravityRailBrush" Color="#16171A" />
                    <SolidColorBrush x:Key="AntigravityTextBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AntigravityMutedBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="AntigravityBorderBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="AntigravityAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityAccentForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="AntigravityRailIconBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="YouTubeSearchButtonBackgroundBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="MusePillHoverBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="MusePillActiveBrush" Color="#3F4148" />
                    <SolidColorBrush x:Key="MusePillBorderBrush" Color="#52545D" />
                    <SolidColorBrush x:Key="MuseDividerBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="MuseCloseBtnBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="MusePillActiveForegroundBrush" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="MuseGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#4A4C54" />
                        <GradientStop Offset="1.0" Color="#2E3036" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseCyanGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#4A4C54" />
                        <GradientStop Offset="1.0" Color="#2E3036" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseSubtleCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#26272C" />
                        <GradientStop Offset="1.0" Color="#1E1F23" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToggleBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityCanvasBrush" Color="#121316" />
                    <SolidColorBrush x:Key="AntigravityPanelBrush" Color="#1E1F23" />
                    <SolidColorBrush x:Key="AntigravityElevatedBrush" Color="#26272C" />
                    <SolidColorBrush x:Key="AntigravityCardBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="AntigravityRailBrush" Color="#16171A" />
                    <SolidColorBrush x:Key="AntigravityTextBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AntigravityMutedBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="AntigravityBorderBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="AntigravityAccentBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityAccentForegroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="AntigravityRailIconBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="YouTubeSearchButtonBackgroundBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="MusePillHoverBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="MusePillActiveBrush" Color="#3F4148" />
                    <SolidColorBrush x:Key="MusePillBorderBrush" Color="#52545D" />
                    <SolidColorBrush x:Key="MuseDividerBrush" Color="#33353B" />
                    <SolidColorBrush x:Key="MuseCloseBtnBrush" Color="#2E3036" />
                    <SolidColorBrush x:Key="MusePillActiveForegroundBrush" Color="#FFFFFF" />
                    <LinearGradientBrush x:Key="MuseGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#4A4C54" />
                        <GradientStop Offset="1.0" Color="#2E3036" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseCyanGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#4A4C54" />
                        <GradientStop Offset="1.0" Color="#2E3036" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseSubtleCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#26272C" />
                        <GradientStop Offset="1.0" Color="#1E1F23" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToggleBackgroundBrush" Color="#000000" />
                    <SolidColorBrush x:Key="AntigravityCanvasBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="AntigravityPanelBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityElevatedBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="AntigravityCardBrush" Color="#F0F0F2" />
                    <SolidColorBrush x:Key="AntigravityRailBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="AntigravityTextBrush" Color="#09090B" />
                    <SolidColorBrush x:Key="AntigravityMutedBrush" Color="#71717A" />
                    <SolidColorBrush x:Key="AntigravityBorderBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="AntigravityAccentBrush" Color="#09090B" />
                    <SolidColorBrush x:Key="AntigravityAccentForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AntigravityRailIconBrush" Color="#71717A" />
                    <SolidColorBrush x:Key="YouTubeSearchButtonBackgroundBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="MusePillHoverBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="MusePillActiveBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="MusePillBorderBrush" Color="#D4D4D8" />
                    <SolidColorBrush x:Key="MuseDividerBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="MuseCloseBtnBrush" Color="#E4E4E7" />
                    <SolidColorBrush x:Key="MusePillActiveForegroundBrush" Color="#09090B" />
                    <LinearGradientBrush x:Key="MuseGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#E4E4E7" />
                        <GradientStop Offset="1.0" Color="#D4D4D8" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseCyanGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0.0" Color="#E4E4E7" />
                        <GradientStop Offset="1.0" Color="#D4D4D8" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="MuseSubtleCardBrush" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0.0" Color="#FFFFFF" />
                        <GradientStop Offset="1.0" Color="#FAFAFA" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--  Text box  -->
            <ControlTheme
                x:Key="CompactTextBox"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="{x:Type TextBox}">
                <Styles>
                    <Style Selector="TextBox">
                        <Setter Property="Height" Value="22" />

                        <Style Selector="^ /template/ Panel#PART_TextFieldPanel">
                            <Setter Property="MinHeight" Value="0" />
                        </Style>

                        <Style Selector="^ /template/ Panel#PART_TextContainer">
                            <Setter Property="Margin" Value="0" />
                        </Style>
                    </Style>
                </Styles>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>
</Application>
