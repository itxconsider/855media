<UserControl
    x:Class="_855Media.Views.Components.DubbingView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:dubbing="clr-namespace:_855Media.Core.Dubbing;assembly=855Media.Core"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    x:DataType="components:DubbingViewModel"
    DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- ========================================================================= -->
        <!-- ROW 0: SINGLE SLEEK MASTER STUDIO HEADER                                  -->
        <!-- ========================================================================= -->
        <Border
            Grid.Row="0"
            Padding="16,8"
            Background="#0B0F19"
            BorderBrush="{DynamicResource AntigravityBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <!-- Left: Studio Identity & Project Management -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon
                        Kind="MovieEditOutline"
                        Width="22"
                        Height="22"
                        Foreground="{DynamicResource AntigravityAccentBrush}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Text="DUB PRO"
                        FontWeight="Bold"
                        FontSize="13"
                        Foreground="{DynamicResource AntigravityTextBrush}"
                        VerticalAlignment="Center"
                        LetterSpacing="0.5" />

                    <!-- Project Name Input -->
                    <TextBox
                        Text="{Binding ProjectName}"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        MinWidth="120"
                        MaxWidth="200"
                        Height="28"
                        Padding="8,3"
                        Background="#161F30"
                        BorderBrush="#2A3850"
                        CornerRadius="5"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Click to rename project" />

                    <!-- Saved/Unsaved Status Badge -->
                    <Border
                        CornerRadius="4"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding CurrentProjectPath, TargetNullValue='Project has not been saved to disk yet'}">
                        <TextBlock
                            Text="{Binding ProjectStatusBadge}"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource AntigravityMutedBrush}" />
                    </Border>

                    <!-- Clean Project Menu Dropdown -->
                    <Button
                        Classes="flat"
                        CornerRadius="5"
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Project file actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open Project..." Command="{Binding OpenProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="#38BDF8" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save Project (Ctrl+S)" Command="{Binding SaveProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save Project As..." Command="{Binding SaveProjectAsCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSaveEditOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            <TextBlock Text="Project ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: Video Capsule & Language Pairing -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- If no video loaded: Large easy-to-see Open Video button -->
                    <Button
                        Command="{Binding BrowseVideoFileCommand}"
                        IsVisible="{Binding VideoFilePath, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                        Classes="accent"
                        Theme="{DynamicResource MaterialOutlineButton}"
                        CornerRadius="6"
                        Height="32"
                        Padding="12,0"
                        ToolTip.Tip="Open movie or video file to dub">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <materialIcons:MaterialIcon Kind="VideoPlusOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Open Video..." FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- If video is loaded: Sleek source capsule -->
                    <Border
                        IsVisible="{Binding VideoFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Background="#111827"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="MovieOutline" Width="15" Height="15" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <TextBlock
                                Text="{Binding VideoFilePath}"
                                FontWeight="SemiBold"
                                FontSize="11.5"
                                MaxWidth="180"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding VideoFilePath}" />

                            <Button
                                Command="{Binding BrowseVideoFileCommand}"
                                Theme="{DynamicResource MaterialFlatButton}"
                                Padding="3"
                                Height="22"
                                Width="22"
                                ToolTip.Tip="Change source video">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </Button>

                            <Rectangle Width="1" Height="16" Fill="#374151" Margin="2,0" />

                            <!-- Source Language -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="From:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                <ComboBox
                                    ItemsSource="{Binding AvailableSourceLanguages}"
                                    SelectedItem="{Binding SourceLanguage}"
                                    Width="95"
                                    Height="26"
                                    FontSize="11"
                                    CornerRadius="4" />
                            </StackPanel>

                            <TextBlock Text="➔" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />

                            <!-- Default Khmer Voice -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Voice:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                <ComboBox
                                    ItemsSource="{Binding AvailableVoices}"
                                    SelectedItem="{Binding SelectedVoice}"
                                    Width="145"
                                    Height="26"
                                    FontSize="11"
                                    CornerRadius="4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: The 3 Primary Studio Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <!-- 1-Click Auto-Prep Studio Button (The Magic Button) -->
                    <Button
                        Command="{Binding AutoPrepareAllCommand}"
                        IsEnabled="{Binding !IsAutoPreparing}"
                        Theme="{DynamicResource MaterialSolidButton}"
                        Background="#7C3AED"
                        Foreground="White"
                        CornerRadius="7"
                        Height="32"
                        Padding="12,0"
                        ToolTip.Tip="Complete 1-Click Studio Setup: Speech Scan / Subtitles ➔ Clean Phrasing ➔ Translate to Khmer ➔ Assign Cast &amp; Voices ➔ Acting Tones ➔ Scene Snapshots">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LightningBolt" Width="15" Height="15" Foreground="#FDE047" IsVisible="{Binding !IsAutoPreparing}" />
                            <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="13" Height="13" IsIndeterminate="True" Foreground="White" IsVisible="{Binding IsAutoPreparing}" />
                            <TextBlock Text="⚡ Auto-Prep Studio" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="White" IsVisible="{Binding !IsAutoPreparing}" />
                            <TextBlock Text="Prepping..." FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="White" IsVisible="{Binding IsAutoPreparing}" />
                        </StackPanel>
                    </Button>

                    <!-- Batch Pre-Dub Button -->
                    <Button
                        Command="{Binding SynthesizeAllLinesCommand}"
                        IsEnabled="{Binding !IsPreSynthesizing}"
                        Theme="{DynamicResource MaterialOutlineButton}"
                        CornerRadius="7"
                        Height="32"
                        Padding="10,0"
                        BorderBrush="#D97706"
                        Foreground="#F59E0B"
                        ToolTip.Tip="Pre-synthesize all Khmer voice clips to audition">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="14" Height="14" Foreground="#F59E0B" />
                            <TextBlock Text="Pre-Dub All" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Master Export Button -->
                    <Button
                        Command="{Binding StartDubbingCommand}"
                        IsVisible="{Binding !IsProcessing}"
                        Theme="{DynamicResource MaterialSolidButton}"
                        Background="{DynamicResource AntigravityAccentBrush}"
                        Foreground="{DynamicResource AntigravityAccentForegroundBrush}"
                        CornerRadius="7"
                        Height="32"
                        Padding="14,0"
                        ToolTip.Tip="Render and export final dubbed movie video">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="MoviePlay" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                            <TextBlock Text="Master Export" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                        </StackPanel>
                    </Button>

                    <!-- Cancel Button -->
                    <Button
                        Command="{Binding CancelDubbingCommand}"
                        IsVisible="{Binding IsProcessing}"
                        Theme="{DynamicResource MaterialFlatButton}"
                        Foreground="#FF5252"
                        CornerRadius="7"
                        Height="32"
                        Padding="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" />
                            <TextBlock Text="Cancel" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Dropdown for Secondary Tools -->
                    <Button
                        Classes="flat"
                        CornerRadius="5"
                        Height="32"
                        Padding="7,0"
                        ToolTip.Tip="Additional studio tools">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Open Output Folder" Command="{Binding OpenOutputFolderCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extend Video Timeline (+)" Command="{Binding ExtendCurrentVideoCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="MoviePlusOutline" Width="15" Height="15" Foreground="#38BDF8" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extract Scene Thumbnails" Command="{Binding ExtractSceneThumbnailsCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ImageMultipleOutline" Width="15" Height="15" Foreground="#10B981" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Scan Audio Speech (Whisper)" Command="{Binding ScanAudioToTextCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Microphone" Width="15" Height="15" Foreground="#F59E0B" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Load Example Dual Dialogue" Command="{Binding LoadExampleDialogueCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LightbulbOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <materialIcons:MaterialIcon Kind="DotsVertical" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- ROW 1: MAIN STUDIO WORKSPACE (TWO-PANEL CLEAN LAYOUT)                     -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" Margin="16,12">
            <!-- ===================================================================== -->
            <!-- LEFT PANEL: STUDIO MONITOR + ACTIVE LINE INSPECTOR                    -->
            <!-- ===================================================================== -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" Margin="0,0,14,0">
                <!-- 1. STUDIO PROGRAM MONITOR (Embedded Video/Audio Player) -->
                <Border
                    Grid.Row="0"
                    Background="{DynamicResource AntigravityPanelBrush}"
                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10"
                    Margin="0,0,0,10">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <!-- Monitor Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="PlayCircle" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="STUDIO MONITOR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                <Border CornerRadius="3" Background="#10B981" Padding="4,1" Margin="4,0,0,0" IsVisible="{Binding IsMonitorPlaying}">
                                    <TextBlock Text="PLAYING" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                <Button
                                    Command="{Binding PlayFullMovieCommand}"
                                    Theme="{DynamicResource MaterialFlatButton}"
                                    Padding="3"
                                    Height="22"
                                    Width="22"
                                    ToolTip.Tip="Play full source movie in monitor">
                                    <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                </Button>
                                <Button
                                    Command="{Binding StopMonitorCommand}"
                                    IsEnabled="{Binding HasActiveMedia}"
                                    Theme="{DynamicResource MaterialFlatButton}"
                                    Padding="3"
                                    Height="22"
                                    Width="22"
                                    ToolTip.Tip="Stop playback">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </Button>
                                <Button
                                    Command="{Binding OpenInExternalPlayerCommand}"
                                    IsEnabled="{Binding HasActiveMedia}"
                                    Theme="{DynamicResource MaterialFlatButton}"
                                    Padding="3"
                                    Height="22"
                                    Width="22"
                                    ToolTip.Tip="Open current media in external player">
                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Embedded Player Surface (16:9 Aspect Ratio) -->
                        <Border
                            Grid.Row="1"
                            Height="185"
                            Background="#000000"
                            CornerRadius="5"
                            ClipToBounds="True"
                            BorderBrush="#1E293B"
                            BorderThickness="1">
                            <Panel>
                                <!-- Idle / Standby Poster -->
                                <Grid IsVisible="{Binding !HasActiveMedia}">
                                    <Image
                                        asyncImageLoader:ImageLoader.Source="{Binding SelectedSegment.ThumbnailPath}"
                                        Stretch="UniformToFill"
                                        Opacity="0.4"
                                        IsVisible="{Binding SelectedSegment.ThumbnailPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="30" Height="30" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Monitor Standby" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click any line cut or audition voice to play" FontSize="9.5" Foreground="#64748B" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Embedded Chromium Video/Audio Player -->
                                <WebView
                                    x:Name="StudioMediaPlayer"
                                    IsVisible="{Binding HasActiveMedia}"
                                    WebViewCreated="StudioMediaPlayer_OnWebViewCreated" />
                            </Panel>
                        </Border>

                        <!-- Monitor Media Info Bar -->
                        <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding ActiveMediaTitle}"
                                FontSize="10.5"
                                FontWeight="Medium"
                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button
                                    Command="{Binding PlaySceneCommand}"
                                    CommandParameter="{Binding SelectedSegment}"
                                    Theme="{DynamicResource MaterialOutlineButton}"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    ToolTip.Tip="Replay selected scene cut video in monitor">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="MovieOutline" Width="11" Height="11" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        <TextBlock Text="Scene" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Command="{Binding PlayDubbedClipCommand}"
                                    CommandParameter="{Binding SelectedSegment}"
                                    Theme="{DynamicResource MaterialOutlineButton}"
                                    Padding="6,2"
                                    CornerRadius="4"
                                    ToolTip.Tip="Play synthesized Khmer voice in monitor">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="VolumeHigh" Width="11" Height="11" Foreground="#10B981" />
                                        <TextBlock Text="Voice" FontSize="9.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. ACTIVE DIALOGUE INSPECTOR (Instant Focus on Selected Line) -->
                <ScrollViewer Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                        <!-- Inspector Content: Visible when a line is selected -->
                        <Border
                            IsVisible="{Binding HasSelectedSegment}"
                            Background="{DynamicResource AntigravityPanelBrush}"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                            <StackPanel Spacing="8">
                                <!-- Inspector Header: Line Index & Timecode -->
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border
                                            Background="{Binding SelectedSegment.SpeakerColor}"
                                            CornerRadius="4"
                                            Padding="5,1.5">
                                            <TextBlock
                                                Text="{Binding SelectedSegment.Index, StringFormat='#{0}'}"
                                                FontSize="9.5"
                                                FontWeight="Bold"
                                                Foreground="White" />
                                        </Border>
                                        <TextBlock
                                            Text="{Binding SelectedSegment.StartTime, StringFormat='{}{0:mm\\:ss\\.ff}'}"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock Text="➔" FontSize="9" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding SelectedSegment.EndTime, StringFormat='{}{0:mm\\:ss\\.ff}'}"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding SelectedSegment.DurationSeconds, StringFormat='({0:F1}s)'}"
                                            FontSize="10"
                                            Foreground="#38BDF8"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Quick Timing Alignment Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                        <Button
                                            Command="{Binding NudgeStartTimeCommand}"
                                            CommandParameter="-0.5"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            Padding="3,1"
                                            CornerRadius="3"
                                            ToolTip.Tip="Nudge start -0.5s">
                                            <TextBlock Text="-0.5s" FontSize="8.5" />
                                        </Button>
                                        <Button
                                            Command="{Binding AutoAlignSpeechStartCommand}"
                                            CommandParameter="{Binding SelectedSegment}"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            BorderBrush="#38BDF8"
                                            Padding="4,1"
                                            CornerRadius="3"
                                            ToolTip.Tip="Auto-align speech start: detects silence/intro music and snaps start to actor's voice onset">
                                            <materialIcons:MaterialIcon Kind="Target" Width="10" Height="10" Foreground="#38BDF8" />
                                        </Button>
                                        <Button
                                            Command="{Binding NudgeEndTimeCommand}"
                                            CommandParameter="+0.5"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            Padding="3,1"
                                            CornerRadius="3"
                                            ToolTip.Tip="Nudge end +0.5s">
                                            <TextBlock Text="+0.5s" FontSize="8.5" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Separator Height="1" Background="#1E293B" Margin="0,2" />

                                <!-- Speaker & Acting Emotion Selectors -->
                                <Grid ColumnDefinitions="*,*">
                                    <!-- Character Speaker -->
                                    <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                        <TextBlock Text="Character Actor" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <ComboBox
                                            ItemsSource="{Binding Characters}"
                                            SelectedItem="{Binding SelectedSegmentCharacter, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                            Height="28"
                                            CornerRadius="5"
                                            FontSize="11">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="dubbing:MovieCharacter">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ColorTag}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Acting Tone / Emotion -->
                                    <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                        <TextBlock Text="Acting Tone / Nuance" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <ComboBox
                                            ItemsSource="{Binding AvailableEmotions}"
                                            SelectedItem="{Binding SelectedSegmentEmotion, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"
                                            Height="28"
                                            CornerRadius="5"
                                            FontSize="11">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate DataType="dubbing:ActorEmotionConfig">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Original Dialogue Text -->
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Original Dialogue" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding ImproveOriginalDialogueCommand}"
                                            CommandParameter="{Binding SelectedSegment}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            Padding="4,1"
                                            Height="20"
                                            ToolTip.Tip="Clean noise tags ([Music], stutters) and format phrasing">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="11" Height="11" Foreground="#38BDF8" />
                                                <TextBlock Text="Clean Text" FontSize="9" Foreground="#38BDF8" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Text="{Binding SelectedSegment.OriginalText, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        MaxHeight="50"
                                        FontSize="11.5"
                                        Background="#131D33"
                                        BorderBrush="#1E293B"
                                        CornerRadius="5"
                                        Padding="6,4" />
                                </StackPanel>

                                <!-- Khmer Translation Text -->
                                <StackPanel Spacing="2">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="Khmer Translation" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding TranslateSelectedLineCommand}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            Padding="4,1"
                                            Height="20"
                                            Margin="0,0,4,0"
                                            ToolTip.Tip="Translate this line to Khmer">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="Translate" Width="11" Height="11" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Translate" FontSize="9" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding PolishKhmerDialogueCommand}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            Padding="4,1"
                                            Height="20"
                                            ToolTip.Tip="Polish Khmer phrasing into natural Cambodian cinema dialogue">
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="AutoFix" Width="11" Height="11" Foreground="#10B981" />
                                                <TextBlock Text="Polish" FontSize="9" Foreground="#10B981" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBox
                                        Text="{Binding SelectedSegment.KhmerText, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        MaxHeight="55"
                                        FontSize="12"
                                        Background="#131D33"
                                        BorderBrush="#1E293B"
                                        CornerRadius="5"
                                        Padding="6,4" />
                                </StackPanel>

                                <!-- Audition & Auto-Fit Action Buttons -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding PlayDubbedClipCommand}"
                                        CommandParameter="{Binding SelectedSegment}"
                                        Theme="{DynamicResource MaterialSolidButton}"
                                        Background="#059669"
                                        Foreground="White"
                                        Height="30"
                                        CornerRadius="5"
                                        Margin="0,0,6,0"
                                        ToolTip.Tip="Audition synthesized Khmer speech in Studio Monitor">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="13" Height="13" Foreground="White" />
                                            <TextBlock Text="▶ Audition Voice" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding AutoFitSegmentAudioCommand}"
                                        CommandParameter="{Binding SelectedSegment}"
                                        Theme="{DynamicResource MaterialOutlineButton}"
                                        BorderBrush="#D97706"
                                        Foreground="#F59E0B"
                                        Height="30"
                                        CornerRadius="5"
                                        ToolTip.Tip="Auto-fit audio tempo to match scene duration">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="12" Height="12" Foreground="#F59E0B" />
                                            <TextBlock Text="Auto-Fit" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Empty State Notice when no line is selected -->
                        <Border
                            IsVisible="{Binding !HasSelectedSegment}"
                            Background="{DynamicResource AntigravityPanelBrush}"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CursorDefaultClickOutline" Width="24" Height="24" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No Dialogue Selected" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Click any line or scene card to inspect, audition voice, and adjust timing." FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. COLLAPSIBLE AUDIO & AI SETTINGS (Expander: Clean & Out of the Way) -->
                <Border
                    Grid.Row="2"
                    Background="{DynamicResource AntigravityPanelBrush}"
                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Expander IsExpanded="False" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="TuneVertical" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="⚙️ Advanced Audio &amp; AI Settings" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" />
                            </StackPanel>
                        </Expander.Header>

                        <StackPanel Spacing="10" Margin="4,4,4,8">
                            <!-- Voice Cloning (RVC) Toggle & Settings -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="RVC Voice Cloning" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <TextBlock Text="Transform speech into cloned actor voice" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableVoiceCloning}" />
                            </Grid>

                            <StackPanel Spacing="6" IsVisible="{Binding EnableVoiceCloning}">
                                <ComboBox
                                    ItemsSource="{Binding AvailableRvcModels}"
                                    SelectedItem="{Binding SelectedRvcModel}"
                                    HorizontalAlignment="Stretch"
                                    Height="28"
                                    PlaceholderText="Select .pth voice model...">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="11" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <Grid ColumnDefinitions="*,40">
                                    <TextBlock Grid.Column="0" Text="Pitch Shift (Semitones)" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding PitchShift}" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                </Grid>
                                <Slider Minimum="-12" Maximum="12" Value="{Binding PitchShift}" TickFrequency="1" IsSnapToTickEnabled="True" Height="24" />
                            </StackPanel>

                            <Separator Height="1" Background="#1E293B" />

                            <!-- Dynamic BGM Ducking & Stems -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="Dynamic BGM Ducking" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <TextBlock Text="Lower movie music under speech" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDynamicDucking}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="AI Vocal Stem Isolation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <TextBlock Text="Demucs vocal separation" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAiStemSeparation}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Border>
            </Grid>

            <!-- ===================================================================== -->
            <!-- RIGHT PANEL: CLEAN UNIFIED STUDIO WORKSPACE TABS                      -->
            <!-- ===================================================================== -->
            <Border
                Grid.Column="1"
                Background="{DynamicResource AntigravityPanelBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
                <Grid RowDefinitions="Auto,*">
                    <!-- Tab Navigation Header Bar -->
                    <TabControl Grid.Row="0" Grid.RowSpan="2" SelectedIndex="{Binding SelectedStudioTab}">
                        <TabControl.Styles>
                            <Style Selector="TabItem">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="14,8" />
                            </Style>
                        </TabControl.Styles>

                        <!-- ========================================================= -->
                        <!-- TAB 1: DIALOGUE EDITOR (The Primary Editor)               -->
                        <!-- ========================================================= -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="ScriptTextOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    <TextBlock Text="Dialogue Editor" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                                <!-- Clean Dialogue Action Bar -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                                    <!-- Left: Search Box & Line Count -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox
                                            Text="{Binding SearchFilter, Mode=TwoWay}"
                                            Watermark="🔍 Search dialogue..."
                                            Width="170"
                                            Height="28"
                                            FontSize="11"
                                            Padding="6,3"
                                            CornerRadius="5"
                                            Background="#131D33"
                                            BorderBrush="#1E293B" />

                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Segments.Count, StringFormat='{}{0} Lines'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Center: Live Operation Badges -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border IsVisible="{Binding IsScanningAudio}" Background="#1E3A8A" CornerRadius="8" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="#60A5FA" />
                                                <TextBlock Text="Scanning Speech..." FontSize="10" Foreground="#93C5FD" />
                                            </StackPanel>
                                        </Border>
                                        <Border IsVisible="{Binding IsTranslating}" Background="#581C87" CornerRadius="8" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="#C084FC" />
                                                <TextBlock Text="Translating to Khmer..." FontSize="10" Foreground="#E9D5FF" />
                                            </StackPanel>
                                        </Border>
                                        <Border IsVisible="{Binding IsExtractingScenes}" Background="#064E3B" CornerRadius="8" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="#34D399" />
                                                <TextBlock Text="Extracting Scenes..." FontSize="10" Foreground="#6EE7B7" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Right: Primary Actions & Dropdown Menus -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button
                                            Command="{Binding AddSegmentCommand}"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="8,0"
                                            ToolTip.Tip="Add a new dialogue line">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                                <TextBlock Text="Add Line" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Command="{Binding ImportSubtitlesCommand}"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="8,0"
                                            ToolTip.Tip="Import .srt or .vtt subtitles">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" />
                                                <TextBlock Text="Import SRT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Command="{Binding AutoTranslateAllCommand}"
                                            IsEnabled="{Binding !IsTranslating}"
                                            Classes="accent"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="8,0"
                                            ToolTip.Tip="{Binding TranslationTooltip}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Translate" Width="13" Height="13" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Translate All" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Clean Actions Dropdown Menu -->
                                        <Button
                                            Classes="flat"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="8,0"
                                            ToolTip.Tip="More dialogue processing tools">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Merge Broken Sentence Fragments" Command="{Binding MergeSentencesCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="CallMerge" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Auto-Fit All Audio to Scene Durations" Command="{Binding AutoFitAllSegmentsAudioCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="15" Height="15" Foreground="#F59E0B" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Clean All Original Dialogue (Remove tags &amp; stutters)" Command="{Binding ImproveOriginalDialogueCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="15" Height="15" Foreground="#38BDF8" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Polish All Khmer Phrasing (Cinema Dialogue)" Command="{Binding PolishKhmerDialogueCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" Foreground="#10B981" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="Auto-Assign Cast &amp; Voices" Command="{Binding AutoDetectSpeakersCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="AccountSearchOutline" Width="15" Height="15" Foreground="#A78BFA" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Auto-Detect Acting Emotions" Command="{Binding AutoDetectEmotionsCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="EmoticonExcitedOutline" Width="15" Height="15" Foreground="#EC4899" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Alternate A/B Dialogue Turns" Command="{Binding AlternateSpeakersCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="15" Height="15" Foreground="#38BDF8" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <TextBlock Text="Tools ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Clean Export Dropdown Menu -->
                                        <Button
                                            Classes="flat"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="8,0"
                                            ToolTip.Tip="Export subtitle or audio deliverables">
                                            <Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="Export Khmer Subtitles (.srt / .vtt)" Command="{Binding ExportKhmerSubtitlesCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="SubtitlesOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Export Bilingual Dual Subtitles (.srt)" Command="{Binding ExportBilingualSubtitlesCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="Translate" Width="15" Height="15" Foreground="#38BDF8" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Export Clean Dubbed Vocal Track (.wav)" Command="{Binding ExportDubbedVocalTrackCommand}">
                                                        <MenuItem.Icon>
                                                            <materialIcons:MaterialIcon Kind="MicrophoneVariant" Width="15" Height="15" Foreground="#10B981" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                <materialIcons:MaterialIcon Kind="ExportVariant" Width="13" Height="13" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Export ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Delete Line Button -->
                                        <Button
                                            Command="{Binding RemoveSegmentCommand}"
                                            CommandParameter="{Binding SelectedSegment}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            CornerRadius="5"
                                            Height="28"
                                            Padding="6,0"
                                            Foreground="#EF4444"
                                            ToolTip.Tip="Delete selected line">
                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Batch Action Bar (Visible when multiple rows are checked) -->
                                <Border
                                    Grid.Row="1"
                                    IsVisible="{Binding HasSelectedRows}"
                                    Background="#0F172A"
                                    BorderBrush="{DynamicResource AntigravityAccentBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,5"
                                    Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Background="#1D4ED8" CornerRadius="10" Padding="6,2">
                                                <TextBlock Text="{Binding SelectedSegmentsCount, StringFormat='{}{0} Selected'}" FontWeight="Bold" FontSize="10.5" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="Batch:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <ComboBox
                                                ItemsSource="{Binding Characters}"
                                                SelectedItem="{Binding BatchSelectedCharacter, Mode=TwoWay}"
                                                PlaceholderText="Assign Speaker..."
                                                Height="26"
                                                MinWidth="140"
                                                CornerRadius="5"
                                                FontSize="10.5">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="dubbing:MovieCharacter">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding ColorTag}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <ComboBox
                                                ItemsSource="{Binding AvailableEmotions}"
                                                SelectedItem="{Binding BatchSelectedEmotion, Mode=TwoWay}"
                                                PlaceholderText="Set Acting Tone..."
                                                Height="26"
                                                MinWidth="140"
                                                CornerRadius="5"
                                                FontSize="10.5">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate DataType="dubbing:ActorEmotionConfig">
                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="11" Height="11" Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <Button
                                                Command="{Binding AutoFitSelectedAudioCommand}"
                                                Theme="{DynamicResource MaterialOutlineButton}"
                                                CornerRadius="5"
                                                Height="26"
                                                Padding="6,0">
                                                <TextBlock Text="Auto-Fit Duration" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Command="{Binding ToggleSelectAllCommand}" Theme="{DynamicResource MaterialFlatButton}" Height="24" Padding="6,0">
                                                <TextBlock Text="Toggle All" FontSize="10" Foreground="#38BDF8" />
                                            </Button>
                                            <Button Command="{Binding DeselectAllSegmentsCommand}" Theme="{DynamicResource MaterialFlatButton}" Height="24" Padding="6,0">
                                                <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="#94A3B8" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- The Dialogue DataGrid -->
                                <DataGrid
                                    Grid.Row="2"
                                    ItemsSource="{Binding DisplayedSegments}"
                                    SelectedItem="{Binding SelectedSegment}"
                                    SelectionMode="Extended"
                                    SelectionChanged="OnSegmentsSelectionChanged"
                                    AutoGenerateColumns="False"
                                    CanUserResizeColumns="True"
                                    GridLinesVisibility="Horizontal"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    CornerRadius="6"
                                    VerticalScrollBarVisibility="Visible"
                                    HorizontalScrollBarVisibility="Auto">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Auto-Align Speech Start (Trim Silence/Music)" Command="{Binding AutoAlignSpeechStartCommand}" CommandParameter="{Binding SelectedSegment}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Target" Width="15" Height="15" Foreground="#38BDF8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Auto-Fit Audio Duration to Scene" Command="{Binding AutoFitSegmentAudioCommand}" CommandParameter="{Binding SelectedSegment}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="15" Height="15" Foreground="#F59E0B" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Clean Original Dialogue (Remove tags &amp; stutters)" Command="{Binding ImproveOriginalDialogueCommand}" CommandParameter="{Binding SelectedSegment}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="15" Height="15" Foreground="#38BDF8" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Translate This Line to Khmer" Command="{Binding TranslateSelectedLineCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Translate" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Delete Line" Command="{Binding RemoveSegmentCommand}" CommandParameter="{Binding SelectedSegment}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="#EF4444" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <!-- Selection Checkbox -->
                                        <DataGridTemplateColumn Width="34" CanUserResize="False">
                                            <DataGridTemplateColumn.Header>
                                                <CheckBox
                                                    IsChecked="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).IsAllSegmentsSelected, Mode=TwoWay}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36" IsReadOnly="True" />

                                        <!-- Scene Thumbnail & Clip Preview -->
                                        <DataGridTemplateColumn Header="Scene" Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <Button
                                                        Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlaySceneCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Preview scene clip in monitor">
                                                        <Border
                                                            Width="78"
                                                            Height="44"
                                                            CornerRadius="4"
                                                            ClipToBounds="True"
                                                            Background="#0F172A"
                                                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                            BorderThickness="1"
                                                            Margin="2"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                            <Grid>
                                                                <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                                <Border Width="18" Height="18" CornerRadius="9" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <Border Background="#B3000000" CornerRadius="2" Padding="2,0.5" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                                    <TextBlock Text="{Binding StartTime, StringFormat='{}{0:mm\\:ss}'}" FontSize="7.5" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" Width="65" IsReadOnly="True" />
                                        <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" Width="65" IsReadOnly="True" />

                                        <!-- Speaker Column -->
                                        <DataGridTemplateColumn Header="Speaker" Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="5,2" Margin="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding SpeakerColor}" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SpeakerName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding SpeakerColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Acting Emotion Column -->
                                        <DataGridTemplateColumn Header="Tone" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <Border Background="#111827" CornerRadius="4" Padding="4,2" Margin="3" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding EmotionDisplayName}" FontSize="10" Foreground="{Binding EmotionColor}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Original Dialogue Text -->
                                        <DataGridTemplateColumn Header="Original Dialogue" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <TextBlock
                                                        Text="{Binding OriginalText}"
                                                        TextWrapping="Wrap"
                                                        FontSize="11.5"
                                                        Foreground="White"
                                                        VerticalAlignment="Center"
                                                        Padding="4,2"
                                                        ToolTip.Tip="{Binding OriginalText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Khmer Translation Text -->
                                        <DataGridTemplateColumn Header="Khmer Translation" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <TextBox
                                                        Text="{Binding KhmerText, Mode=TwoWay}"
                                                        TextWrapping="Wrap"
                                                        FontSize="11.5"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        Foreground="{DynamicResource AntigravityTextBrush}"
                                                        VerticalAlignment="Center"
                                                        Padding="4,2"
                                                        ToolTip.Tip="{Binding KhmerText}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Quick Row Actions -->
                                        <DataGridTemplateColumn Header="Actions" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:SubtitleSegment">
                                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <!-- Audition Voice Button -->
                                                        <Button
                                                            Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlayDubbedClipCommand}"
                                                            CommandParameter="{Binding}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            Padding="4,2"
                                                            CornerRadius="4"
                                                            ToolTip.Tip="Audition voice clip">
                                                            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="13" Height="13" Foreground="#10B981" />
                                                        </Button>

                                                        <!-- Auto-Align Button -->
                                                        <Button
                                                            Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AutoAlignSpeechStartCommand}"
                                                            CommandParameter="{Binding}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            Padding="4,2"
                                                            CornerRadius="4"
                                                            ToolTip.Tip="Auto-align speech start">
                                                            <materialIcons:MaterialIcon Kind="Target" Width="13" Height="13" Foreground="#38BDF8" />
                                                        </Button>

                                                        <!-- Delete Button -->
                                                        <Button
                                                            Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveSegmentCommand}"
                                                            CommandParameter="{Binding}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            Padding="4,2"
                                                            CornerRadius="4"
                                                            ToolTip.Tip="Delete line">
                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" Foreground="#EF4444" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Empty State Guidance Overlay -->
                                <Border
                                    Grid.Row="2"
                                    IsVisible="{Binding !HasSegments}"
                                    Background="#F2090D16"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="24"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="480">
                                        <Border Width="56" Height="56" CornerRadius="28" Background="#1E1B4B" HorizontalAlignment="Center" BorderBrush="#7C3AED" BorderThickness="2">
                                            <materialIcons:MaterialIcon Kind="AutoAwesome" Width="26" Height="26" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                                            <TextBlock Text="Movie AI Dubbing Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" HorizontalAlignment="Center" />
                                            <TextBlock Text="Load your movie or video to automatically transcribe speech, translate to natural Khmer, and assign voice actors in 1 click." FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                            <Button
                                                Command="{Binding AutoPrepareAllCommand}"
                                                IsEnabled="{Binding !IsAutoPreparing}"
                                                Theme="{DynamicResource MaterialSolidButton}"
                                                Background="#7C3AED"
                                                Foreground="White"
                                                CornerRadius="7"
                                                Padding="14,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="LightningBolt" Width="15" Height="15" Foreground="#FDE047" />
                                                    <TextBlock Text="⚡ 1-Click Auto-Prep" FontWeight="Bold" FontSize="12" Foreground="White" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Command="{Binding ImportSubtitlesCommand}"
                                                Theme="{DynamicResource MaterialOutlineButton}"
                                                CornerRadius="7"
                                                Padding="12,8">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="15" Height="15" />
                                                    <TextBlock Text="Import Subtitles" FontSize="12" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Button
                                                Command="{Binding LoadExampleDialogueCommand}"
                                                Theme="{DynamicResource MaterialFlatButton}"
                                                CornerRadius="7"
                                                Padding="10,8">
                                                <TextBlock Text="Load Example" FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- TAB 2: VISUAL TIMELINE                                    -->
                        <!-- ========================================================= -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="TimelineClockOutline" Width="15" Height="15" Foreground="#38BDF8" />
                                    <TextBlock Text="Visual Timeline" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                                <!-- Timeline Zoom & Nudge Toolbar -->
                                <Border
                                    Grid.Row="0"
                                    Background="#0F172A"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Active Segment Indicator -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Background="{Binding SelectedSegment.SpeakerColor, TargetNullValue='#475569'}" CornerRadius="3" Padding="5,1.5">
                                                <TextBlock Text="{Binding SelectedSegment.Index, StringFormat='#{0}', TargetNullValue='No Line'}" FontSize="9.5" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <TextBlock Text="{Binding SelectedSegment.StartTime, StringFormat='{}{0:mm\\:ss\\.ff}', TargetNullValue='--:--'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="➔" FontSize="9" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding SelectedSegment.EndTime, StringFormat='{}{0:mm\\:ss\\.ff}', TargetNullValue='--:--'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Zoom Controls -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Zoom:" FontSize="10.5" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                            <Button Command="{Binding ZoomOutTimelineCommand}" Theme="{DynamicResource MaterialOutlineButton}" Padding="5,2" CornerRadius="4">
                                                <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="13" Height="13" />
                                            </Button>
                                            <TextBlock Text="{Binding TimelineZoom, StringFormat='{}{0:P0}'}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Width="38" TextAlignment="Center" />
                                            <Button Command="{Binding ZoomInTimelineCommand}" Theme="{DynamicResource MaterialOutlineButton}" Padding="5,2" CornerRadius="4">
                                                <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="13" Height="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Multi-Track Synchronized Layout -->
                                <Border
                                    Grid.Row="1"
                                    Background="#0A0F1D"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <!-- Fixed Left Track Headers -->
                                        <Border
                                            Grid.Column="0"
                                            Background="#0C1222"
                                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="6,8"
                                            Width="160"
                                            Margin="0,0,8,0">
                                            <StackPanel Spacing="6">
                                                <Border Height="26" Background="#131D33" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                                    <TextBlock Text="🎬 TRACKS" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Track 1 Header: Video -->
                                                <Border Height="90" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="13" Height="13" Foreground="#38BDF8" />
                                                            <TextBlock Text="TRACK 1: VIDEO" FontSize="8.5" FontWeight="Bold" Foreground="#38BDF8" />
                                                        </StackPanel>
                                                        <TextBlock Text="Scene Cut Preview" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Track 2 Header: Dialogue -->
                                                <Border Height="72" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="MessageTextOutline" Width="13" Height="13" Foreground="#A78BFA" />
                                                            <TextBlock Text="TRACK 2: DIALOGUE" FontSize="8.5" FontWeight="Bold" Foreground="#A78BFA" />
                                                        </StackPanel>
                                                        <TextBlock Text="Subtitles &amp; Speech Onset" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Track 3 Header: Dubbed Voice -->
                                                <Border Height="72" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="6,4">
                                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="MicrophoneOutline" Width="13" Height="13" Foreground="#34D399" />
                                                            <TextBlock Text="TRACK 3: DUBBED" FontSize="8.5" FontWeight="Bold" Foreground="#34D399" />
                                                        </StackPanel>
                                                        <TextBlock Text="Khmer Neural &amp; RVC" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Track 4 Header: Ducking -->
                                                <Border Height="28" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="4" Padding="6,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Kind="TuneVertical" Width="12" Height="12" Foreground="#F472B6" />
                                                        <TextBlock Text="TRACK 4: DUCKING" FontSize="8" FontWeight="Bold" Foreground="#F472B6" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Horizontally-Scrollable Synchronized Segment Columns -->
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding Segments}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="dubbing:SubtitleSegment">
                                                        <Border
                                                            Width="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).TimelineColumnWidth}"
                                                            Background="#0D1424"
                                                            BorderBrush="#1E293B"
                                                            BorderThickness="1"
                                                            CornerRadius="5"
                                                            Padding="5">
                                                            <StackPanel Spacing="6">
                                                                <!-- Column Header: Timecode & Selection -->
                                                                <Button
                                                                    Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).SelectSegmentCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="#131D33"
                                                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="5,2"
                                                                    Height="26"
                                                                    HorizontalAlignment="Stretch"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="Click to inspect in Studio Monitor">
                                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                                        <Border Grid.Column="0" Background="{Binding SpeakerColor}" CornerRadius="3" Padding="3,1" Margin="0,0,4,0">
                                                                            <TextBlock Text="{Binding Index, StringFormat='#{0}'}" FontSize="8" FontWeight="Bold" Foreground="White" />
                                                                        </Border>
                                                                        <TextBlock Grid.Column="1" Text="{Binding StartTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}" FontSize="8" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>

                                                                <!-- Track 1: Scene Cut Video Snapshot -->
                                                                <Border Height="90" CornerRadius="4" ClipToBounds="True" Background="#000" BorderBrush="{Binding SpeakerColor}" BorderThickness="1.5">
                                                                    <Grid>
                                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                                        <Button
                                                                            Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlaySceneCommand}"
                                                                            CommandParameter="{Binding}"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center"
                                                                            Background="#B3000000"
                                                                            BorderBrush="White"
                                                                            BorderThickness="1"
                                                                            CornerRadius="16"
                                                                            Width="32"
                                                                            Height="32"
                                                                            Padding="0"
                                                                            Cursor="Hand"
                                                                            ToolTip.Tip="Play scene cut in monitor">
                                                                            <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" Foreground="White" Margin="1,0,0,0" />
                                                                        </Button>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Track 2: Dialogue Lines & Auto-Align -->
                                                                <Border Height="72" CornerRadius="4" Background="#182032" BorderBrush="{Binding SpeakerColor}" BorderThickness="1.5" Padding="5,3">
                                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                                            <TextBlock Text="{Binding SpeakerName}" FontSize="9" FontWeight="Bold" Foreground="{Binding SpeakerColor}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding DurationSeconds, StringFormat='{}{0:F1}s'}" FontSize="7.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                        </Grid>
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Text="{Binding OriginalText}"
                                                                            FontSize="8.5"
                                                                            Foreground="White"
                                                                            TextWrapping="Wrap"
                                                                            MaxLines="2"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip.Tip="{Binding OriginalText}" />
                                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                                            <TextBlock Grid.Column="0" Text="{Binding StartTime, StringFormat='At {0:mm\\:ss\\.ff}'}" FontSize="7.5" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                                            <Button
                                                                                Grid.Column="1"
                                                                                Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AutoAlignSpeechStartCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="2,0"
                                                                                Height="14"
                                                                                Cursor="Hand"
                                                                                ToolTip.Tip="Auto-align speech start: trims intro silence/music">
                                                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                                                    <materialIcons:MaterialIcon Kind="Target" Width="8" Height="8" Foreground="#38BDF8" />
                                                                                    <TextBlock Text="Align" FontSize="7.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Track 3: Dubbed Khmer Voice Clip -->
                                                                <Border Height="72" CornerRadius="4" Background="#111D2E" BorderBrush="{Binding SyncStatusColor}" BorderThickness="1.5" Padding="5,3">
                                                                    <Grid RowDefinitions="Auto,*,Auto">
                                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                                                                            <Button
                                                                                Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlayDubbedClipCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                Background="Transparent"
                                                                                BorderThickness="0"
                                                                                Padding="0"
                                                                                Cursor="Hand"
                                                                                ToolTip.Tip="Audition dubbed audio">
                                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="11" Height="11" Foreground="{Binding SyncStatusColor}" />
                                                                                    <TextBlock Text="Audition" FontSize="7.5" Foreground="{DynamicResource AntigravityAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Button>
                                                                            <Border Grid.Column="2" Background="{Binding SyncStatusColor}" CornerRadius="2" Padding="2,0.5">
                                                                                <TextBlock Text="{Binding SyncStatus}" FontSize="7" FontWeight="Bold" Foreground="White" />
                                                                            </Border>
                                                                        </Grid>
                                                                        <TextBlock
                                                                            Grid.Row="1"
                                                                            Text="{Binding KhmerText}"
                                                                            FontSize="8.5"
                                                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                                                            TextWrapping="Wrap"
                                                                            MaxLines="2"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            VerticalAlignment="Center"
                                                                            ToolTip.Tip="{Binding KhmerText}" />
                                                                        <TextBlock
                                                                            Grid.Row="2"
                                                                            Text="{Binding AudioDurationSeconds, StringFormat='Audio: {0:F1}s'}"
                                                                            FontSize="7.5"
                                                                            Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Track 4: Ducking Profile -->
                                                                <Border Height="28" CornerRadius="3" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" Padding="2">
                                                                    <Grid VerticalAlignment="Center">
                                                                        <Border Height="10" CornerRadius="2" Background="#EC4899" Opacity="0.85" />
                                                                        <TextBlock Text="Ducked -25dB" FontSize="6.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- TAB 3: CAST & VOICE ACTORS                                -->
                        <!-- ========================================================= -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="AccountMultipleOutline" Width="15" Height="15" Foreground="#EC4899" />
                                    <TextBlock Text="Cast &amp; Voices" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                                <!-- Cast Toolbar -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Character Voice Casting &amp; Emotion Nuances" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        <TextBlock Text="Assign distinct Khmer neural voices, RVC clone models, and acting tones to each movie character" FontSize="10.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Command="{Binding AddCharacterCommand}"
                                            Classes="accent"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Padding="8,4"
                                            ToolTip.Tip="Add another character to cast">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="AccountPlus" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Add Actor" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{Binding AutoDetectSpeakersCommand}"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Padding="8,4"
                                            ToolTip.Tip="Auto-assign cast from dialogue turns and script names">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="AccountSearchOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Auto-Assign" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Character Profiles Cards Gallery -->
                                <ScrollViewer Grid.Row="1">
                                    <ItemsControl ItemsSource="{Binding Characters}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="dubbing:MovieCharacter">
                                                <Border
                                                    Width="310"
                                                    Background="#0F172A"
                                                    BorderBrush="{Binding ColorTag}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,12,12">
                                                    <StackPanel Spacing="8">
                                                        <!-- Card Header: Avatar, Name, Audition -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="28" Height="28" CornerRadius="14" Background="{Binding ColorTag}" Margin="0,0,8,0">
                                                                <materialIcons:MaterialIcon Kind="Account" Width="16" Height="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Height="26" Padding="6,2" />
                                                            <Button
                                                                Grid.Column="2"
                                                                Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).TestCharacterVoiceCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="accent"
                                                                Theme="{DynamicResource MaterialOutlineButton}"
                                                                CornerRadius="5"
                                                                Padding="6,2"
                                                                Margin="6,0,0,0"
                                                                ToolTip.Tip="Audition voice in Khmer">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                    <TextBlock Text="Test" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>

                                                        <!-- Gender & Base Voice -->
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,3,0">
                                                                <TextBlock Text="Gender" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <ComboBox
                                                                    ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableGenders}"
                                                                    SelectedItem="{Binding Gender, Mode=TwoWay}"
                                                                    HorizontalAlignment="Stretch"
                                                                    Height="26"
                                                                    FontSize="10.5"
                                                                    CornerRadius="5" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="2" Margin="3,0,0,0">
                                                                <TextBlock Text="Base Voice" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <ComboBox
                                                                    ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableVoices}"
                                                                    SelectedItem="{Binding BaseVoice}"
                                                                    HorizontalAlignment="Stretch"
                                                                    Height="26"
                                                                    FontSize="10.5"
                                                                    CornerRadius="5">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding DisplayName}" FontSize="10.5" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Acting Tone Preset -->
                                                        <StackPanel Spacing="2">
                                                            <TextBlock Text="Acting Delivery Tone" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                            <ComboBox
                                                                ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableEmotionPresets}"
                                                                SelectedItem="{Binding EmotionPreset, Mode=TwoWay}"
                                                                HorizontalAlignment="Stretch"
                                                                Height="26"
                                                                FontSize="10.5"
                                                                CornerRadius="5" />
                                                        </StackPanel>

                                                        <!-- RVC Model -->
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <TextBlock Text="AI Voice Cloning (RVC)" FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRvc, Mode=TwoWay}" />
                                                        </Grid>

                                                        <!-- Delete Actor Button -->
                                                        <Button
                                                            Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveCharacterCommand}"
                                                            CommandParameter="{Binding}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            Foreground="#EF4444"
                                                            HorizontalAlignment="Right"
                                                            Padding="6,2"
                                                            Height="22"
                                                            ToolTip.Tip="Delete actor from roster">
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="11" Height="11" />
                                                                <TextBlock Text="Remove" FontSize="9.5" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>

                        <!-- ========================================================= -->
                        <!-- TAB 4: BATCH QUEUE                                        -->
                        <!-- ========================================================= -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="FormatListNumbered" Width="15" Height="15" Foreground="#F59E0B" />
                                    <TextBlock Text="Batch Queue" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>

                            <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                                <!-- Batch Queue Controls -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Multi-Video Batch Dubbing Queue" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        <TextBlock Text="Queue multiple videos to transcribe, translate, and dub in the background" FontSize="10.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button
                                            Command="{Binding AddCurrentProjectToBatchCommand}"
                                            Theme="{DynamicResource MaterialOutlineButton}"
                                            CornerRadius="5"
                                            Padding="8,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                <TextBlock Text="Queue Current Video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button
                                            Command="{Binding StartBatchDubbingCommand}"
                                            IsEnabled="{Binding !IsBatchProcessing}"
                                            Classes="accent"
                                            Theme="{DynamicResource MaterialSolidButton}"
                                            Background="{DynamicResource AntigravityAccentBrush}"
                                            Foreground="{DynamicResource AntigravityAccentForegroundBrush}"
                                            CornerRadius="5"
                                            Padding="12,4">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" />
                                                <TextBlock Text="Start Batch Dubbing" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Batch Queue DataGrid -->
                                <DataGrid
                                    Grid.Row="1"
                                    ItemsSource="{Binding BatchQueue}"
                                    SelectedItem="{Binding SelectedBatchJob}"
                                    AutoGenerateColumns="False"
                                    GridLinesVisibility="Horizontal"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    CornerRadius="6">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Project / Video" Binding="{Binding FileName}" Width="2*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Language" Binding="{Binding SourceLanguage}" Width="90" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Progress" Width="2*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:DubbingJob">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" CornerRadius="2" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Actions" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="dubbing:DubbingJob">
                                                    <Button
                                                        Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveFromBatchCommand}"
                                                        CommandParameter="{Binding}"
                                                        Theme="{DynamicResource MaterialFlatButton}"
                                                        Padding="4"
                                                        Foreground="#EF4444">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- ROW 2: BOTTOM STATUS BAR                                                  -->
        <!-- ========================================================================= -->
        <Border
            Grid.Row="2"
            Padding="16,6"
            Background="#080C14"
            BorderBrush="{DynamicResource AntigravityBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="InformationOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock
                        Text="{Binding StatusMessage}"
                        FontSize="11"
                        Foreground="{DynamicResource AntigravityMutedBrush}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ProgressBar
                        Value="{Binding Progress}"
                        Maximum="1.0"
                        Width="160"
                        Height="5"
                        CornerRadius="2.5"
                        Foreground="{DynamicResource AntigravityAccentBrush}"
                        IsVisible="{Binding IsProcessing}"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
