<UserControl xmlns="https://github.com/avaloniaui" xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia" xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" xmlns:views="clr-namespace:_855Media.Views.Components" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="_855Media.Views.Components.DubbingView" x:DataType="components:DubbingViewModel" DragDrop.AllowDrop="True" Background="#14161B" Focusable="True" FontFamily="Segoe UI" xmlns:components="clr-namespace:_855Media.ViewModels.Components" xmlns:dubbing="clr-namespace:_855Media.Core.Dubbing;assembly=855Media.Core">
    <UserControl.Resources>
        <SolidColorBrush x:Key="AntigravityPanelBrush" Color="#1C1F26" />
        <SolidColorBrush x:Key="AntigravityElevatedBrush" Color="#252933" />
        <SolidColorBrush x:Key="AntigravityCardBrush" Color="#252933" />
        <SolidColorBrush x:Key="AntigravityRailBrush" Color="#17191F" />
        <SolidColorBrush x:Key="AntigravityBorderBrush" Color="#343944" />
        <SolidColorBrush x:Key="AntigravityTextBrush" Color="#E4E8F0" />
        <SolidColorBrush x:Key="AntigravityMutedBrush" Color="#98A2B5" />
        <SolidColorBrush x:Key="AntigravityAccentBrush" Color="#78AAFF" />
        <SolidColorBrush x:Key="AntigravityAccentForegroundBrush" Color="#101B30" />
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.editorTool">
            <Setter Property="Height" Value="29" />
            <Setter Property="Background" Value="#292E39" />
            <Setter Property="Foreground" Value="#E4E8F0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="#B8C1D0" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
    </UserControl.Styles>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding BrowseVideoFileCommand}" />
    </UserControl.KeyBindings>
    <Grid RowDefinitions="48,*,6,320,26" Margin="8,0,8,0" ColumnDefinitions="*,6,310">
        <Border Grid.Row="0" Background="#191C23" BorderBrush="#343944" BorderThickness="0,0,0,1" Padding="10,6" Grid.ColumnSpan="3">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel x:Name="ProjectTools" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="MovieEditOutline" Width="19" Height="19" Foreground="#78AAFF" />
                    <TextBox Text="{Binding ProjectName}" Width="175" Height="28" Padding="6,3" Background="Transparent" BorderThickness="0" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProjectStatusBadge}" FontSize="10" Foreground="#98A2B5" VerticalAlignment="Center" />
                    <Button Classes="flat" CornerRadius="3" Height="28" Padding="6,0" VerticalAlignment="Center" ToolTip.Tip="Project file actions">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="New Project" Command="{Binding NewProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open Project..." Command="{Binding OpenProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save Project (Ctrl+S)" Command="{Binding SaveProjectCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Save Project As..." Command="{Binding SaveProjectAsCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentSaveEditOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            <TextBlock Text="Project ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="MainActions" Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Classes="editorTool" Content="Auto prepare" Command="{Binding AutoPrepareAllCommand}" IsEnabled="{Binding !IsAutoPreparing}" ToolTip.Tip="Scan, translate, assign voices, and extract scene references" />
                    <Button Classes="editorTool" Content="Generate voices" Command="{Binding SynthesizeAllLinesCommand}" IsEnabled="{Binding !IsPreSynthesizing}" />
                    <Button Classes="editorTool" Content="Export video" Command="{Binding StartDubbingCommand}" IsEnabled="{Binding !IsProcessing}" Background="#78AAFF" Foreground="#101B30" FontWeight="SemiBold" />
                    <Button Classes="editorTool" Content="Cancel" Command="{Binding CancelDubbingCommand}" IsVisible="{Binding IsProcessing}" />
                    <Button Classes="flat" CornerRadius="3" Height="28" Padding="7,0" ToolTip.Tip="Additional studio tools">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Open Output Folder" Command="{Binding OpenOutputFolderCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extend Video Timeline (+)" Command="{Binding ExtendCurrentVideoCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="MoviePlusOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extract Scene Thumbnails" Command="{Binding ExtractSceneThumbnailsCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ImageMultipleOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Transcribe source audio" Command="{Binding ScanAudioToTextCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Microphone" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Load Example Dual Dialogue" Command="{Binding LoadExampleDialogueCommand}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="LightbulbOutline" Width="15" Height="15" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <materialIcons:MaterialIcon Kind="DotsVertical" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Background="#1C1F26" BorderBrush="#343944" BorderThickness="1" CornerRadius="3">
                <Grid RowDefinitions="32,*">
                    <Border Padding="12,8" BorderBrush="#343944" BorderThickness="0,0,0,1">
                        <TextBlock Text="PROJECT MEDIA" Classes="panelTitle" />
                    </Border>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12" Margin="12">
                            <Button Classes="editorTool" Command="{Binding BrowseVideoFileCommand}" HorizontalAlignment="Stretch" Content="Import media…" />
                            <Border Height="96" Background="#111319" BorderBrush="#343944" BorderThickness="1" CornerRadius="3">
                                <Grid>
                                    <Image asyncImageLoader:ImageLoader.Source="{Binding SelectedSegment.ThumbnailPath}" Stretch="Uniform" Opacity="0.65" />
                                    <materialIcons:MaterialIcon Kind="MovieOutline" Width="30" Height="30" Foreground="#68758C" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding SourceFileName}" FontSize="11" Foreground="#E4E8F0" TextWrapping="Wrap" ToolTip.Tip="{Binding VideoFilePath}" />
                            <TextBlock Text="SOURCE LANGUAGE" Classes="panelTitle" />
                            <ComboBox ItemsSource="{Binding AvailableSourceLanguages}" SelectedItem="{Binding SourceLanguage}" HorizontalAlignment="Stretch" FontSize="11" />
                            <TextBlock Text="KHMER BASE VOICE" Classes="panelTitle" />
                            <ComboBox ItemsSource="{Binding AvailableVoices}" SelectedItem="{Binding SelectedVoice}" HorizontalAlignment="Stretch" FontSize="11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Separator />
                            <TextBlock Text="DIALOGUE SOURCES" Classes="panelTitle" />
                            <Button Classes="editorTool" Command="{Binding ImportSubtitlesCommand}" HorizontalAlignment="Stretch" Content="Import subtitles…" />
                            <Button Classes="editorTool" Command="{Binding ScanAudioToTextCommand}" IsEnabled="{Binding !IsScanningAudio}" HorizontalAlignment="Stretch" Content="Transcribe audio" />
                            <TextBlock Text="{Binding Segments.Count, StringFormat='{}{0} dialogue clips in sequence'}" Foreground="#98A2B5" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" />
            <Border Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0" Grid.Column="2">
                <Grid RowDefinitions="30,*,32">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="PROGRAM MONITOR" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                            <Border CornerRadius="6" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" Padding="4,1" Margin="4,0,0,0" IsVisible="{Binding IsMonitorPlaying}">
                                <TextBlock Text="PLAYING" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding StartTimelineReviewCommand}" Theme="{DynamicResource MaterialOutlineButton}" Padding="6,2" Height="22" CornerRadius="6" BorderBrush="{DynamicResource AntigravityBorderBrush}" Foreground="{DynamicResource AntigravityTextBrush}" ToolTip.Tip="Launch Dual-Audio Review Session">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="12" Height="12" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <TextBlock Text="Review" FontSize="9" FontWeight="Bold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayFullMovieCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="3" Height="22" Width="22" ToolTip.Tip="Play full source movie in monitor">
                                <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            </Button>
                            <Button Command="{Binding StopMonitorCommand}" IsEnabled="{Binding HasActiveMedia}" Theme="{DynamicResource MaterialFlatButton}" Padding="3" Height="22" Width="22" ToolTip.Tip="Stop playback">
                                <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </Button>
                            <Button Command="{Binding OpenInExternalPlayerCommand}" IsEnabled="{Binding HasActiveMedia}" Theme="{DynamicResource MaterialFlatButton}" Padding="3" Height="22" Width="22" ToolTip.Tip="Open current media in external player">
                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="13" Height="13" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#000000" CornerRadius="2" ClipToBounds="True" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" MinHeight="100">
                        <Panel>
                            <Grid IsVisible="{Binding !HasActiveMedia}">
                                <Image asyncImageLoader:ImageLoader.Source="{Binding SelectedSegment.ThumbnailPath}" Stretch="UniformToFill" Opacity="0.4" IsVisible="{Binding SelectedSegment.ThumbnailPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                    <materialIcons:MaterialIcon Kind="MoviePlayOutline" Width="30" Height="30" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Your sequence starts here" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Import media, then review your source and dubbed dialogue." FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <WebView x:Name="StudioMediaPlayer" IsVisible="{Binding HasActiveMedia}" WebViewCreated="StudioMediaPlayer_OnWebViewCreated" />
                        </Panel>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ActiveMediaTitle}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AntigravityMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Command="{Binding PlaySceneCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialOutlineButton}" Padding="6,2" CornerRadius="6" ToolTip.Tip="Replay selected scene cut video in monitor">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <materialIcons:MaterialIcon Kind="MovieOutline" Width="11" Height="11" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    <TextBlock Text="Scene" FontSize="9.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PlayDubbedClipCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialOutlineButton}" Padding="6,2" CornerRadius="6" ToolTip.Tip="Play synthesized Khmer voice in monitor">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="11" Height="11" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <TextBlock Text="Voice" FontSize="9.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" />
        <Border Grid.Row="3" Background="#1C1F26" BorderBrush="#343944" BorderThickness="1" CornerRadius="3">
            <TabControl SelectedIndex="{Binding SelectedStudioTab}" Margin="0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Padding" Value="14,8" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="Script">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBox Text="{Binding SearchFilter, Mode=TwoWay}" Watermark="🔍 Search dialogue..." Width="170" Height="28" FontSize="11" Padding="6,3" CornerRadius="6" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" />
                                <Border Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Segments.Count, StringFormat='{}{0} Lines'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border IsVisible="{Binding IsScanningAudio}" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        <TextBlock Text="Scanning Speech..." FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding IsTranslating}" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        <TextBlock Text="Translating to Khmer..." FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding IsExtractingScenes}" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <ProgressBar Theme="{DynamicResource MaterialCircularProgressBar}" Width="10" Height="10" IsIndeterminate="True" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        <TextBlock Text="Extracting Scenes..." FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding AddSegmentCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Height="28" Padding="8,0" ToolTip.Tip="Add a new dialogue line">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                        <TextBlock Text="Add Line" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportSubtitlesCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Height="28" Padding="8,0" ToolTip.Tip="Import .srt or .vtt subtitles">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="13" Height="13" />
                                        <TextBlock Text="Import SRT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AutoTranslateAllCommand}" IsEnabled="{Binding !IsTranslating}" Classes="accent" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Height="28" Padding="8,0" ToolTip.Tip="{Binding TranslationTooltip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Translate" Width="13" Height="13" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        <TextBlock Text="Translate All" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="flat" CornerRadius="6" Height="28" Padding="8,0" ToolTip.Tip="More dialogue processing tools">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Merge Broken Sentence Fragments" Command="{Binding MergeSentencesCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="CallMerge" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Auto-Fit All Audio to Scene Durations" Command="{Binding AutoFitAllSegmentsAudioCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Clean All Original Dialogue (Remove tags &amp; stutters)" Command="{Binding ImproveOriginalDialogueCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Polish All Khmer Phrasing (Cinema Dialogue)" Command="{Binding PolishKhmerDialogueCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="AutoFix" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Auto-Assign Cast &amp; Voices" Command="{Binding AutoDetectSpeakersCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="AccountSearchOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Auto-Detect Acting Emotions" Command="{Binding AutoDetectEmotionsCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="EmoticonExcitedOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Alternate A/B Dialogue Turns" Command="{Binding AlternateSpeakersCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="SwapHorizontal" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <TextBlock Text="Tools ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="flat" CornerRadius="6" Height="28" Padding="8,0" ToolTip.Tip="Export subtitle or audio deliverables">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Export Khmer Subtitles (.srt / .vtt)" Command="{Binding ExportKhmerSubtitlesCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="SubtitlesOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Export Bilingual Dual Subtitles (.srt)" Command="{Binding ExportBilingualSubtitlesCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Translate" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Export Clean Dubbed Vocal Track (.wav)" Command="{Binding ExportDubbedVocalTrackCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="MicrophoneVariant" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon Kind="ExportVariant" Width="13" Height="13" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        <TextBlock Text="Export ▾" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RemoveSegmentCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialFlatButton}" CornerRadius="6" Height="28" Padding="6,0" Foreground="{DynamicResource AntigravityMutedBrush}" ToolTip.Tip="Delete selected line">
                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" IsVisible="{Binding HasSelectedRows}" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                        <TextBlock Text="{Binding SelectedSegmentsCount, StringFormat='{}{0} Selected'}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </Border>
                                    <TextBlock Text="Batch:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding BatchSelectedCharacter, Mode=TwoWay}" PlaceholderText="Assign Speaker..." Height="26" MinWidth="140" CornerRadius="6" FontSize="10.5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="dubbing:MovieCharacter">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{Binding ColorTag}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox ItemsSource="{Binding AvailableEmotions}" SelectedItem="{Binding BatchSelectedEmotion, Mode=TwoWay}" PlaceholderText="Set Acting Tone..." Height="26" MinWidth="140" CornerRadius="6" FontSize="10.5">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="dubbing:ActorEmotionConfig">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="11" Height="11" Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button Command="{Binding AutoFitSelectedAudioCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Height="26" Padding="6,0">
                                        <TextBlock Text="Auto-Fit Duration" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Command="{Binding ToggleSelectAllCommand}" Theme="{DynamicResource MaterialFlatButton}" Height="24" Padding="6,0">
                                        <TextBlock Text="Toggle All" FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </Button>
                                    <Button Command="{Binding DeselectAllSegmentsCommand}" Theme="{DynamicResource MaterialFlatButton}" Height="24" Padding="6,0">
                                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding DisplayedSegments}" SelectedItem="{Binding SelectedSegment}" SelectionMode="Extended" SelectionChanged="OnSegmentsSelectionChanged" AutoGenerateColumns="False" CanUserResizeColumns="True" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="6" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Auto">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Auto-Align Speech Start (Trim Silence/Music)" Command="{Binding AutoAlignSpeechStartCommand}" CommandParameter="{Binding SelectedSegment}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Target" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Auto-Fit Audio Duration to Scene" Command="{Binding AutoFitSegmentAudioCommand}" CommandParameter="{Binding SelectedSegment}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Clean Original Dialogue (Remove tags &amp; stutters)" Command="{Binding ImproveOriginalDialogueCommand}" CommandParameter="{Binding SelectedSegment}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Translate This Line to Khmer" Command="{Binding TranslateSelectedLineCommand}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="Translate" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Delete Line" Command="{Binding RemoveSegmentCommand}" CommandParameter="{Binding SelectedSegment}">
                                        <MenuItem.Icon>
                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsChecked="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).IsAllSegmentsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Scene" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlaySceneCommand}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip.Tip="Preview scene clip in monitor">
                                                <Border Width="78" Height="44" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Grid>
                                                        <Image asyncImageLoader:ImageLoader.Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                        <Border Width="18" Height="18" CornerRadius="6" Background="#80000000" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Background="#B3000000" CornerRadius="2" Padding="2,0.5" Margin="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                            <TextBlock Text="{Binding StartTime, StringFormat='{}{0:mm\\:ss}'}" FontSize="7.5" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" Width="65" IsReadOnly="True" />
                                <DataGridTextColumn Header="End" Binding="{Binding EndTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" Width="65" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Speaker" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <Border Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,2" Margin="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Border Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding SpeakerName}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tone" Width="95">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <Border Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EmotionDisplayName}" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Original Dialogue" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" Padding="4,2" ToolTip.Tip="{Binding OriginalText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Khmer Translation" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <TextBox Text="{Binding KhmerText, Mode=TwoWay}" TextWrapping="Wrap" FontSize="11.5" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" Padding="4,2" ToolTip.Tip="{Binding KhmerText}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:SubtitleSegment">
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).PlayDubbedClipCommand}" CommandParameter="{Binding}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,2" CornerRadius="6" ToolTip.Tip="Audition voice clip">
                                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="13" Height="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AutoAlignSpeechStartCommand}" CommandParameter="{Binding}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,2" CornerRadius="6" ToolTip.Tip="Auto-align speech start">
                                                    <materialIcons:MaterialIcon Kind="Target" Width="13" Height="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveSegmentCommand}" CommandParameter="{Binding}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,2" CornerRadius="6" ToolTip.Tip="Delete line">
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" IsVisible="{Binding !HasSegments}" Background="{DynamicResource AntigravityCanvasBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="480">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AntigravityElevatedBrush}" HorizontalAlignment="Center" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                    <materialIcons:MaterialIcon Kind="AutoAwesome" Width="26" Height="26" Foreground="{DynamicResource AntigravityTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <TextBlock Text="Movie AI Dubbing Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Load your movie or video to automatically transcribe speech, translate to natural Khmer, and assign voice actors in 1 click." FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Button Command="{Binding AutoPrepareAllCommand}" IsEnabled="{Binding !IsAutoPreparing}" Theme="{DynamicResource MaterialSolidButton}" Background="{DynamicResource AntigravityAccentBrush}" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" CornerRadius="8" Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="LightningBolt" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                                            <TextBlock Text="1-Click Auto-Prep" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ImportSubtitlesCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="8" Padding="12,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="15" Height="15" />
                                            <TextBlock Text="Import Subtitles" FontSize="12" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding LoadExampleDialogueCommand}" Theme="{DynamicResource MaterialFlatButton}" CornerRadius="8" Padding="10,8">
                                        <TextBlock Text="Load Example" FontSize="11.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Timeline">
                    <views:DubbingTimelineView />
                </TabItem>
                <TabItem Header="Cast &amp; Voices">
                    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Character Voice Casting &amp; Emotion Nuances" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                <TextBlock Text="Assign distinct Khmer neural voices, RVC clone models, and acting tones to each movie character" FontSize="10.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding AddCharacterCommand}" Classes="accent" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Padding="8,4" ToolTip.Tip="Add another character to cast">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AccountPlus" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        <TextBlock Text="Add Actor" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AutoDetectSpeakersCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Padding="8,4" ToolTip.Tip="Auto-assign cast from dialogue turns and script names">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AccountSearchOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        <TextBlock Text="Auto-Assign" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl ItemsSource="{Binding Characters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="dubbing:MovieCharacter">
                                        <Border Width="310" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,12">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource AntigravityCardBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" Margin="0,0,8,0">
                                                        <materialIcons:MaterialIcon Kind="Account" Width="16" Height="16" Foreground="{DynamicResource AntigravityTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Height="26" Padding="6,2" />
                                                    <Button Grid.Column="2" Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).TestCharacterVoiceCommand}" CommandParameter="{Binding}" Classes="accent" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Padding="6,2" Margin="6,0,0,0" ToolTip.Tip="Audition voice in Khmer">
                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                            <materialIcons:MaterialIcon Kind="VolumeHigh" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                            <TextBlock Text="Test" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                                <Grid ColumnDefinitions="*,*">
                                                    <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,3,0">
                                                        <TextBlock Text="Gender" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <ComboBox ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableGenders}" SelectedItem="{Binding Gender, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="26" FontSize="10.5" CornerRadius="6" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="2" Margin="3,0,0,0">
                                                        <TextBlock Text="Base Voice" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <ComboBox ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableVoices}" SelectedItem="{Binding BaseVoice}" HorizontalAlignment="Stretch" Height="26" FontSize="10.5" CornerRadius="6">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="Acting Delivery Tone" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                    <ComboBox ItemsSource="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).AvailableEmotionPresets}" SelectedItem="{Binding EmotionPreset, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="26" FontSize="10.5" CornerRadius="6" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="AI Voice Cloning (RVC)" FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableRvc, Mode=TwoWay}" />
                                                </Grid>
                                                <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveCharacterCommand}" CommandParameter="{Binding}" Theme="{DynamicResource MaterialFlatButton}" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Right" Padding="6,2" Height="22" ToolTip.Tip="Delete actor from roster">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <materialIcons:MaterialIcon Kind="DeleteOutline" Width="11" Height="11" />
                                                        <TextBlock Text="Remove" FontSize="9.5" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Render Queue">
                    <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Multi-Video Batch Dubbing Queue" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                <TextBlock Text="Queue multiple videos to transcribe, translate, and dub in the background" FontSize="10.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding AddCurrentProjectToBatchCommand}" Theme="{DynamicResource MaterialOutlineButton}" CornerRadius="6" Padding="8,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                        <TextBlock Text="Queue Current Video" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StartBatchDubbingCommand}" IsEnabled="{Binding !IsBatchProcessing}" Classes="accent" Theme="{DynamicResource MaterialSolidButton}" Background="{DynamicResource AntigravityAccentBrush}" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" CornerRadius="6" Padding="12,4">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" />
                                        <TextBlock Text="Start Batch Dubbing" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding BatchQueue}" SelectedItem="{Binding SelectedBatchJob}" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Project / Video" Binding="{Binding FileName}" Width="2*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Language" Binding="{Binding SourceLanguage}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Progress" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:DubbingJob">
                                            <Grid ColumnDefinitions="*,Auto" Margin="6,0" VerticalAlignment="Center">
                                                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" CornerRadius="2" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:0}%'}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="dubbing:DubbingJob">
                                            <Button Command="{Binding $parent[UserControl].((components:DubbingViewModel)DataContext).RemoveFromBatchCommand}" CommandParameter="{Binding}" Theme="{DynamicResource MaterialFlatButton}" Padding="4" Foreground="{DynamicResource AntigravityMutedBrush}">
                                                <materialIcons:MaterialIcon Kind="DeleteOutline" Width="13" Height="13" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
        <Border Grid.Row="4" Padding="8,3" Background="#14161B" Grid.ColumnSpan="3">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#98A2B5" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" Value="{Binding Progress}" Maximum="100" Width="130" Height="3" IsVisible="{Binding IsProcessing}" Margin="12,0" />
                <TextBlock Grid.Column="2" Text="{Binding Segments.Count, StringFormat='{}{0} clips'}" FontSize="10" Foreground="#98A2B5" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border Grid.Column="2" Background="#1C1F26" BorderBrush="#343944" BorderThickness="1" CornerRadius="3" Grid.Row="1" Grid.RowSpan="3" Margin="0,8,0,0">
            <Grid RowDefinitions="32,*">
                <Border Padding="12,8" BorderBrush="#343944" BorderThickness="0,0,0,1">
                    <TextBlock Text="INSPECTOR" Classes="panelTitle" />
                </Border>
                <TabControl Grid.Row="1">
                    <TabItem Header="Dialogue">
                        <ScrollViewer Margin="0">
                            <StackPanel Spacing="10">
                                <Border IsVisible="{Binding HasSelectedSegment}" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5,1.5">
                                                    <TextBlock Text="{Binding SelectedSegment.Index, StringFormat='#{0}'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding SelectedSegment.StartTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="➔" FontSize="9" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedSegment.EndTime, StringFormat='{}{0:mm\\:ss\\.ff}'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SelectedSegment.DurationSeconds, StringFormat='({0:F1}s)'}" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                <Button Command="{Binding NudgeStartTimeCommand}" CommandParameter="-0.5" Theme="{DynamicResource MaterialOutlineButton}" Padding="3,1" CornerRadius="6" ToolTip.Tip="Nudge start -0.5s">
                                                    <TextBlock Text="-0.5s" FontSize="8.5" />
                                                </Button>
                                                <Button Command="{Binding AutoAlignSpeechStartCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialOutlineButton}" BorderBrush="{DynamicResource AntigravityBorderBrush}" Padding="4,1" CornerRadius="6" ToolTip.Tip="Auto-align speech start: detects silence/intro music and snaps start to actor's voice onset">
                                                    <materialIcons:MaterialIcon Kind="Target" Width="10" Height="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </Button>
                                                <Button Command="{Binding NudgeEndTimeCommand}" CommandParameter="+0.5" Theme="{DynamicResource MaterialOutlineButton}" Padding="3,1" CornerRadius="6" ToolTip.Tip="Nudge end +0.5s">
                                                    <TextBlock Text="+0.5s" FontSize="8.5" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <Separator Height="1" Background="{DynamicResource AntigravityBorderBrush}" Margin="0,2" />
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,4,0">
                                                <TextBlock Text="Character Actor" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                <ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedSegmentCharacter, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="28" CornerRadius="6" FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="dubbing:MovieCharacter">
                                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                <Border Width="8" Height="8" CornerRadius="6" Background="{Binding ColorTag}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3" Margin="4,0,0,0">
                                                <TextBlock Text="Acting Tone / Nuance" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                <ComboBox ItemsSource="{Binding AvailableEmotions}" SelectedItem="{Binding SelectedSegmentEmotion, Mode=TwoWay}" HorizontalAlignment="Stretch" Height="28" CornerRadius="6" FontSize="11">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate DataType="dubbing:ActorEmotionConfig">
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="12" Height="12" Foreground="{Binding Color}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="Original Dialogue" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Command="{Binding ImproveOriginalDialogueCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,1" Height="20" ToolTip.Tip="Clean noise tags ([Music], stutters) and format phrasing">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <materialIcons:MaterialIcon Kind="TextBoxCheckOutline" Width="11" Height="11" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                        <TextBlock Text="Clean Text" FontSize="9" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBox Text="{Binding SelectedSegment.OriginalText, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="50" FontSize="11.5" Background="{DynamicResource AntigravityCardBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="6" Padding="6,4" />
                                        </StackPanel>
                                        <StackPanel Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <TextBlock Text="Khmer Translation" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Command="{Binding TranslateSelectedLineCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,1" Height="20" Margin="0,0,4,0" ToolTip.Tip="Translate this line to Khmer">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <materialIcons:MaterialIcon Kind="Translate" Width="11" Height="11" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                        <TextBlock Text="Translate" FontSize="9" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Command="{Binding PolishKhmerDialogueCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,1" Height="20" ToolTip.Tip="Polish Khmer phrasing into natural Cambodian cinema dialogue">
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="11" Height="11" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                        <TextBlock Text="Polish" FontSize="9" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBox Text="{Binding SelectedSegment.KhmerText, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="55" FontSize="12" Background="{DynamicResource AntigravityCardBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="6" Padding="6,4" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                            <Button Grid.Column="0" Command="{Binding PlayDubbedClipCommand}" CommandParameter="{Binding SelectedSegment}" Classes="accent" Theme="{DynamicResource MaterialSolidButton}" Background="{DynamicResource AntigravityAccentBrush}" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" Height="30" CornerRadius="6" Margin="0,0,6,0" ToolTip.Tip="Audition synthesized Khmer speech in Studio Monitor">
                                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="VolumeHigh" Width="13" Height="13" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                                                    <TextBlock Text="▶ Audition Voice" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="1" Command="{Binding AutoFitSegmentAudioCommand}" CommandParameter="{Binding SelectedSegment}" Theme="{DynamicResource MaterialOutlineButton}" BorderBrush="{DynamicResource AntigravityBorderBrush}" Foreground="{DynamicResource AntigravityTextBrush}" Height="30" CornerRadius="6" ToolTip.Tip="Auto-fit audio tempo to match scene duration">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="TimerSyncOutline" Width="12" Height="12" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    <TextBlock Text="Auto-Fit" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border IsVisible="{Binding !HasSelectedSegment}" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CursorDefaultClickOutline" Width="24" Height="24" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="No Dialogue Selected" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Click any line or scene card to inspect, audition voice, and adjust timing." FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Audio &amp; AI">
                        <ScrollViewer>
                            <StackPanel Spacing="12" Margin="12">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="EXPORT MIX" Classes="panelTitle" />
                                    <TextBlock Text="Background level" FontSize="10" />
                                    <Slider Minimum="0" Maximum="1" Value="{Binding BgmVolume}" />
                                    <TextBlock Text="Dubbed voice level" FontSize="10" />
                                    <Slider Minimum="0" Maximum="2" Value="{Binding VoiceVolume}" />
                                    <ToggleSwitch Content="Normalize export loudness" FontSize="10" IsChecked="{Binding EnableLoudnessNormalization}" />
                                    <ToggleSwitch Content="Fit speech to scene duration" FontSize="10" IsChecked="{Binding EnableSmartTimeStretch}" />
                                    <Separator />
                                </StackPanel>
                                <StackPanel Spacing="10" Margin="4,4,4,8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="RVC Voice Cloning" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                            <TextBlock Text="Transform speech into cloned actor voice" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableVoiceCloning}" />
                                    </Grid>
                                    <StackPanel Spacing="6" IsVisible="{Binding EnableVoiceCloning}">
                                        <ComboBox ItemsSource="{Binding AvailableRvcModels}" SelectedItem="{Binding SelectedRvcModel}" HorizontalAlignment="Stretch" Height="28" PlaceholderText="Select .pth voice model...">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontSize="11" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Grid ColumnDefinitions="*,40">
                                            <TextBlock Grid.Column="0" Text="Pitch Shift (Semitones)" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding PitchShift}" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                        </Grid>
                                        <Slider Minimum="-12" Maximum="12" Value="{Binding PitchShift}" TickFrequency="1" IsSnapToTickEnabled="True" Height="24" />
                                    </StackPanel>
                                    <Separator Height="1" Background="{DynamicResource AntigravityBorderBrush}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="Dynamic BGM Ducking" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                            <TextBlock Text="Lower movie music under speech" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDynamicDucking}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1">
                                            <TextBlock Text="AI Vocal Stem Isolation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                            <TextBlock Text="Demucs vocal separation" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAiStemSeparation}" />
                                    </Grid>
                                    <Separator />
                                    <TextBlock Text="Optional Meta audio providers" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <ToggleSwitch Content="Try SAM Audio dialogue isolation" IsChecked="{Binding UseSamAudio}" FontSize="10" />
                                    <ToggleSwitch Content="Try Omnilingual ASR transcription" IsChecked="{Binding UseOmnilingualAsr}" FontSize="10" />
                                    <TextBlock Text="Uses local models; falls back to existing providers if unavailable." TextWrapping="Wrap" FontSize="9.5" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBox Text="{Binding MetaPythonPath, Mode=TwoWay}" Watermark="Meta Python path (Windows or /home/... in WSL)" FontSize="10" />
                                    <Button Content="Check Meta runtime" Command="{Binding CheckMetaRuntimeCommand}" HorizontalAlignment="Stretch" FontSize="10" />
                                    <ProgressBar IsVisible="{Binding IsCheckingMetaRuntime}" IsIndeterminate="True" Height="3" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Grid.Row="1" Grid.RowSpan="3" />
    </Grid>
</UserControl>