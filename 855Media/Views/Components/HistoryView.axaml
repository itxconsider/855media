<UserControl
    x:Class="_855Media.Views.Components.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:services="clr-namespace:_855Media.Services"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:DataType="components:HistoryViewModel">

    <Grid RowDefinitions="Auto, *">
        <!-- Top Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,16">
            <TextBox
                Grid.Column="0"
                Text="{Binding SearchQuery, Mode=TwoWay}"
                Watermark="{Binding LocalizationManager.SearchHistoryPlaceholder}"
                Margin="0,0,12,0"
                VerticalAlignment="Center">
                <TextBox.InnerRightContent>
                    <materialIcons:MaterialIcon
                        Kind="Magnify"
                        Width="18"
                        Height="18"
                        Margin="0,0,10,0"
                        Foreground="{DynamicResource AntigravityMutedBrush}" />
                </TextBox.InnerRightContent>
            </TextBox>

            <Button
                Grid.Column="1"
                Command="{Binding ExportHistoryCommand}"
                Margin="0,0,8,0"
                Padding="12,8"
                ToolTip.Tip="{Binding LocalizationManager.ExportHistoryTitle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Export" Width="16" Height="16" />
                    <TextBlock Text="{Binding LocalizationManager.ExportHistoryButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding ClearHistoryCommand}"
                Padding="12,8"
                Classes="danger"
                ToolTip.Tip="{Binding LocalizationManager.ClearHistoryTitle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="DeleteSweep" Width="16" Height="16" />
                    <TextBlock Text="{Binding LocalizationManager.ClearHistoryButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content List or Empty View -->
        <Grid Grid.Row="1">
            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12"
                IsVisible="{Binding !HasRecords}">
                <materialIcons:MaterialIcon
                    Kind="History"
                    Width="64"
                    Height="64"
                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                <TextBlock
                    Text="{Binding LocalizationManager.NoHistoryRecords}"
                    FontSize="16"
                    Foreground="{DynamicResource AntigravityMutedBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- History List -->
            <ScrollViewer IsVisible="{Binding HasRecords}">
                <ItemsControl ItemsSource="{Binding FilteredRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:HistoryRecord">
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="8"
                                Background="#0AFFFFFF"
                                BorderBrush="#1FFFFFFF"
                                BorderThickness="1">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!-- Source Icon -->
                                    <Border
                                        Grid.Column="0"
                                        Width="40"
                                        Height="40"
                                        CornerRadius="20"
                                        Background="#1AFFFFFF"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon
                                            Kind="MoviePlay"
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            FontSize="14"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock
                                                Text="{Binding Author}"
                                                FontSize="12"
                                                Foreground="{DynamicResource AntigravityMutedBrush}" />

                                            <TextBlock
                                                Text="{Binding FormattedDownloadedAt}"
                                                FontSize="12"
                                                Foreground="{DynamicResource AntigravityMutedBrush}" />

                                            <TextBlock
                                                Text="{Binding FormattedFileSize}"
                                                FontSize="12"
                                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                                IsVisible="{Binding FormattedFileSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>

                                        <TextBlock
                                            Text="{Binding ErrorMessage}"
                                            FontSize="11"
                                            Foreground="#FF5555"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).RedownloadCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Redownload">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).ShowFileCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Show file in explorer">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).OpenFileCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Open file">
                                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).RemoveRecordCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Remove from history">
                                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

