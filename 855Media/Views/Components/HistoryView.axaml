<UserControl
    x:Class="_855Media.Views.Components.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:services="clr-namespace:_855Media.Services"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:DataType="components:HistoryViewModel">

    <UserControl.Styles>
        <Style Selector="Border.history-item-card">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource AntigravityCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AntigravityBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource AntigravityElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AntigravityAccentBrush}" />
                <Setter Property="RenderTransform" Value="scale(1.01)" />
            </Style>
        </Style>

        <Style Selector="Button.history-tool-btn">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="RenderTransform" Value="scale(1.04)" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.96)" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Margin="32,20,32,20">
        <!-- Top Toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,18">
            <!-- Glass Pill Search Box -->
            <Border
                Grid.Column="0"
                Height="42"
                CornerRadius="21"
                Background="{DynamicResource AntigravityPanelBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                Margin="0,0,14,0"
                Padding="6,0,12,0">
                <Grid ColumnDefinitions="Auto,*">
                    <materialIcons:MaterialIcon
                        Grid.Column="0"
                        Kind="Magnify"
                        Width="18"
                        Height="18"
                        Margin="8,0,6,0"
                        Foreground="{DynamicResource AntigravityMutedBrush}"
                        VerticalAlignment="Center" />
                    <TextBox
                        Grid.Column="1"
                        Text="{Binding SearchQuery, Mode=TwoWay}"
                        Watermark="{Binding LocalizationManager.SearchHistoryPlaceholder}"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="13"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Theme="{DynamicResource SoloTextBox}" />
                </Grid>
            </Border>

            <Button
                Grid.Column="1"
                Command="{Binding ExportHistoryCommand}"
                Classes="history-tool-btn"
                Background="{DynamicResource AntigravityElevatedBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                Margin="0,0,10,0"
                ToolTip.Tip="{Binding LocalizationManager.ExportHistoryTitle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="Export" Width="15" Height="15" Foreground="{DynamicResource AntigravityTextBrush}" />
                    <TextBlock Text="{Binding LocalizationManager.ExportHistoryButton}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button
                Grid.Column="2"
                Command="{Binding ClearHistoryCommand}"
                Classes="history-tool-btn"
                Background="{DynamicResource AntigravityElevatedBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                ToolTip.Tip="{Binding LocalizationManager.ClearHistoryTitle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Kind="DeleteSweep" Width="15" Height="15" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    <TextBlock Text="{Binding LocalizationManager.ClearHistoryButton}" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content List or Empty View -->
        <Grid Grid.Row="1">
            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="14"
                IsVisible="{Binding !HasRecords}">
                <Border
                    Width="80"
                    Height="80"
                    CornerRadius="40"
                    Background="#10FFFFFF"
                    BorderBrush="#20FFFFFF"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon
                        Kind="History"
                        Width="40"
                        Height="40"
                        Foreground="{DynamicResource AntigravityMutedBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <TextBlock
                    Text="{Binding LocalizationManager.NoHistoryRecords}"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AntigravityMutedBrush}"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- History List -->
            <ScrollViewer IsVisible="{Binding HasRecords}">
                <ItemsControl ItemsSource="{Binding FilteredRecords}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:HistoryRecord">
                            <Border Classes="history-item-card">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <!-- Source Icon -->
                                    <Border
                                        Grid.Column="0"
                                        Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="{DynamicResource AntigravityElevatedBrush}"
                                        BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,14,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon
                                            Kind="MoviePlay"
                                            Width="22"
                                            Height="22"
                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="Bold"
                                            FontSize="14"
                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                            TextWrapping="NoWrap"
                                            TextTrimming="CharacterEllipsis" />

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock
                                                Text="{Binding Author}"
                                                FontSize="12"
                                                Foreground="{DynamicResource AntigravityMutedBrush}" />

                                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />

                                            <TextBlock
                                                Text="{Binding FormattedDownloadedAt}"
                                                FontSize="12"
                                                Foreground="{DynamicResource AntigravityMutedBrush}" />

                                            <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding FormattedFileSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                            <Border
                                                Background="{DynamicResource AntigravityElevatedBrush}"
                                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                IsVisible="{Binding FormattedFileSize, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock
                                                    Text="{Binding FormattedFileSize}"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            Text="{Binding ErrorMessage}"
                                            FontSize="11"
                                            Foreground="{DynamicResource AntigravityMutedBrush}"
                                            TextWrapping="Wrap"
                                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).RedownloadCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Redownload">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).ShowFileCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Show file in explorer">
                                            <materialIcons:MaterialIcon Kind="FolderOpen" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).OpenFileCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Open file">
                                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="18" Height="18" />
                                        </Button>

                                        <Button
                                            Command="{Binding $parent[UserControl].((components:HistoryViewModel)DataContext).RemoveRecordCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="download-action"
                                            ToolTip.Tip="Remove from history">
                                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

