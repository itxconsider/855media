<UserControl
    x:Class="_855Media.Views.Components.VideoUpscalerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:upscaling="clr-namespace:_855Media.Core.Upscaling;assembly=855Media.Core"
    xmlns:converters="clr-namespace:_855Media.Converters"
    x:Name="RootControl"
    x:DataType="components:VideoUpscalerViewModel"
    DragDrop.AllowDrop="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <!--  Top Settings & Action Toolbar  -->
        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="{DynamicResource AntigravityPanelBrush}"
            BorderBrush="{DynamicResource AntigravityBorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="10">
                <!-- Row 1: File Actions (Left) and Batch Controls (Right) -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Pipeline File Add Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Command="{Binding AddFilesCommand}"
                            Classes="accent"
                            Theme="{DynamicResource MaterialOutlineButton}"
                            CornerRadius="8"
                            Padding="14,8"
                            ToolTip.Tip="Select individual video files to upscale">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="PlusCircleOutline" Width="18" Height="18" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="Add Videos" VerticalAlignment="Center" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding AddFolderCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            CornerRadius="8"
                            Padding="10,8"
                            ToolTip.Tip="Scan directory for videos">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="18" Height="18" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBlock Text="Add Folder" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityTextBrush}" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding SelectOutputDirectoryCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            CornerRadius="8"
                            Padding="10,8"
                            ToolTip.Tip="{Binding OutputDirectory, StringFormat='Output Folder: {0}'}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="18" Height="18" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBlock Text="Output Dir" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: Queue Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                        <!-- Pause / Resume Button -->
                        <Button
                            Command="{Binding TogglePauseResumeCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            CornerRadius="8"
                            Padding="8"
                            ToolTip.Tip="Pause or Resume batch processing">
                            <Panel>
                                <materialIcons:MaterialIcon
                                    IsVisible="{Binding !IsPaused}"
                                    Kind="Pause"
                                    Width="20"
                                    Height="20"
                                    Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <materialIcons:MaterialIcon
                                    IsVisible="{Binding IsPaused}"
                                    Kind="Play"
                                    Width="20"
                                    Height="20"
                                    Foreground="{DynamicResource AntigravityAccentBrush}" />
                            </Panel>
                        </Button>

                        <!-- Clear Completed -->
                        <Button
                            Command="{Binding ClearCompletedCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            CornerRadius="8"
                            Padding="8"
                            ToolTip.Tip="Clear completed &amp; canceled jobs">
                            <materialIcons:MaterialIcon Kind="CheckAll" Width="20" Height="20" Foreground="{DynamicResource AntigravityMutedBrush}" />
                        </Button>

                        <!-- Cancel All -->
                        <Button
                            Command="{Binding CancelAllCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            CornerRadius="8"
                            Padding="8"
                            ToolTip.Tip="Cancel all processing jobs">
                            <materialIcons:MaterialIcon Kind="CloseOctagonOutline" Width="20" Height="20" Foreground="{DynamicResource AntigravityMutedBrush}" />
                        </Button>

                        <Separator Width="1" Height="22" Background="{DynamicResource AntigravityBorderBrush}" Margin="2,0" />

                        <!-- Post Batch Action -->
                        <ComboBox
                            ItemsSource="{Binding AvailablePostBatchActions}"
                            SelectedItem="{Binding SelectedPostBatchAction}"
                            Width="125"
                            ToolTip.Tip="Action to execute when all jobs finish" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Processing & AI Configuration Strip -->
                <Border
                    Background="{DynamicResource AntigravityCanvasBrush}"
                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Target Resolution -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="VideoHighDefinition" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Target:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableResolutions}"
                                SelectedItem="{Binding SelectedTargetResolution}"
                                Width="110" />
                        </StackPanel>

                        <!-- Re-Framing / Aspect Ratio -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="CropFree" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Aspect:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableAspectRatios}"
                                SelectedItem="{Binding SelectedTargetAspectRatio}"
                                Width="170"
                                ToolTip.Tip="Re-frame video aspect ratio (16:9 -> 9:16 Vertical for Shorts/Reels/TikTok, 1:1 Square, 21:9 Widescreen)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Smart Action & Face Tracking -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Tracking:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableTrackingModes}"
                                SelectedItem="{Binding SelectedTrackingMode}"
                                Width="175"
                                ToolTip.Tip="Smart Action Re-Framing tracking mode (Static Center, Active Motion Centroid, or Face &amp; Subject Priority)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Codec -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="MovieOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            <TextBlock Text="Codec:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableCodecs}"
                                SelectedItem="{Binding SelectedCodec}"
                                Width="90" />
                        </StackPanel>

                        <!-- Video Type / AI Weights -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="AutoFix" Width="16" Height="16" Foreground="{DynamicResource AntigravityTextBrush}" />
                            <TextBlock Text="Model:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableModelTypes}"
                                SelectedItem="{Binding SelectedModelType}"
                                Width="210"
                                ToolTip.Tip="AI Super-Resolution Engine: NVIDIA RTX AI (Tensor Cores - Ultra Fast 60-120+ FPS), Real-World / Animation (Real-ESRGAN NCNN), or Fast Native (Lanczos &amp; GPU Filters).">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Render Speed Mode -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="Speedometer" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Speed:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableSpeedModes}"
                                SelectedItem="{Binding SelectedSpeedMode}"
                                Width="170"
                                ToolTip.Tip="Render Speed Profile: Quality (Pristine), Balanced (Standard), or Turbo (Fastest throughput for long videos).">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Playback Tempo / Output Speed -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="FastForward" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="Tempo:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailablePlaybackSpeeds}"
                                SelectedItem="{Binding SelectedPlaybackSpeed}"
                                Width="95"
                                ToolTip.Tip="Playback Speed Multiplier (0.5x to 2.0x). Automatically applies pitch-preserving audio tempo and video PTS timing.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0:0.##}x'}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Target Framerate (FPS) -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,2,16,2">
                            <materialIcons:MaterialIcon Kind="Filmstrip" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="FPS:" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ComboBox
                                ItemsSource="{Binding AvailableTargetFramerates}"
                                SelectedItem="{Binding SelectedTargetFramerate}"
                                Width="185"
                                ToolTip.Tip="Target Output Framerate: Preserve original source FPS or convert to 60 FPS / 120 FPS ultra-smooth playback.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Enhancements & Performance Flyout -->
                        <Button
                            Theme="{DynamicResource MaterialOutlineButton}"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="0,2,0,2"
                            ToolTip.Tip="AI Face Restoration, Hardware Acceleration, Filters &amp; Split Options">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <Border
                                        Width="380"
                                        Padding="18"
                                        Background="{DynamicResource AntigravityPanelBrush}"
                                        BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                                            <StackPanel Spacing="14">
                                                <!-- Header -->
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <materialIcons:MaterialIcon Kind="TuneVariant" Width="18" Height="18" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                    <TextBlock Text="Enhancements &amp; Advanced Options" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </StackPanel>

                                                <!-- Section 1: AI Facial Restoration & Clarity -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="AI FACE &amp; CLARITY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <CheckBox
                                                            IsChecked="{Binding EnableFacialClarity}"
                                                            ToolTip.Tip="Applies adaptive high-frequency unsharp mask and micro-dither to restore crisp facial edges.">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <materialIcons:MaterialIcon Kind="FaceWomanOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                <TextBlock Text="Facial Clarity &amp; Edge Restoration" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <CheckBox
                                                            IsChecked="{Binding EnableFaceRestoration}"
                                                            ToolTip.Tip="Invokes neural face restoration module on extracted frames.">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <materialIcons:MaterialIcon Kind="FaceRecognition" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                <TextBlock Text="Face Detail Recovery (AI)" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <TextBlock
                                                            IsVisible="{Binding !IsFaceRestorationAvailable}"
                                                            Text="Note: CodeFormer/GFPGAN binary not in tools/ — adaptive clarity filter will be used as fallback."
                                                            FontSize="10"
                                                            FontStyle="Italic"
                                                            Foreground="{DynamicResource AntigravityMutedBrush}"
                                                            Margin="24,0,0,0"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Section: Micro-Zoom & Frame Protection -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="MICRO-ZOOM &amp; FRAME HASH PROTECTION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <CheckBox
                                                            IsChecked="{Binding EnableMicroZoom}"
                                                            ToolTip.Tip="Crops 2%-5% of outer borders to alter edge boundary coordinate mapping and invalidate perceptual frame hashes.">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <materialIcons:MaterialIcon Kind="CropFree" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                <TextBlock Text="Micro-Zoom (Shift Edge Coordinates)" FontSize="12" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <StackPanel Spacing="6" IsVisible="{Binding EnableMicroZoom}" Margin="24,0,0,0">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Zoom Crop Amount:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding MicroZoomPercent, StringFormat='{}{0:0.#}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                            </Grid>
                                                            <Slider
                                                                Value="{Binding MicroZoomPercent}"
                                                                Minimum="1.0"
                                                                Maximum="7.0"
                                                                TickFrequency="0.5"
                                                                IsSnapToTickEnabled="True" />

                                                            <!-- Framing Style -->
                                                            <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Column="0" Text="Framing Anchor:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                                <ComboBox
                                                                    Grid.Column="1"
                                                                    ItemsSource="{Binding AvailableZoomModes}"
                                                                    SelectedItem="{Binding SelectedZoomMode}"
                                                                    Width="180">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="11" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Section 2: Video Splitting -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="VIDEO SPLITTING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <CheckBox
                                                            IsChecked="{Binding EnableSplitAndUpscale}"
                                                            ToolTip.Tip="Split video into segments before upscaling (reduces memory &amp; enables part processing).">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <materialIcons:MaterialIcon Kind="CallSplit" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                <TextBlock Text="Split Video into Segments" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </CheckBox>

                                                        <StackPanel Spacing="10" IsVisible="{Binding EnableSplitAndUpscale}" Margin="24,0,0,0">
                                                            <!-- Mode -->
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Split Mode:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <ComboBox
                                                                    ItemsSource="{Binding AvailableSplitModes}"
                                                                    SelectedItem="{Binding SelectedSplitMode}"
                                                                    HorizontalAlignment="Stretch">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </StackPanel>

                                                            <!-- Parts Count -->
                                                            <StackPanel
                                                                Spacing="4"
                                                                IsVisible="{Binding SelectedSplitMode, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static upscaling:SplitMode.ByPartCount}}">
                                                                <TextBlock Text="Number of Parts:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <NumericUpDown
                                                                    Value="{Binding CustomSplitPartCount}"
                                                                    Minimum="2"
                                                                    Maximum="50"
                                                                    Increment="1"
                                                                    FormatString="0"
                                                                    HorizontalAlignment="Stretch" />
                                                            </StackPanel>

                                                            <!-- Duration -->
                                                            <StackPanel
                                                                Spacing="4"
                                                                IsVisible="{Binding SelectedSplitMode, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static upscaling:SplitMode.ByDuration}}">
                                                                <TextBlock Text="Duration per Part (seconds):" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <NumericUpDown
                                                                    Value="{Binding CustomSplitSegmentDurationSeconds}"
                                                                    Minimum="5"
                                                                    Maximum="3600"
                                                                    Increment="15"
                                                                    FormatString="0s"
                                                                    HorizontalAlignment="Stretch" />
                                                            </StackPanel>

                                                            <!-- Auto-Merge -->
                                                            <CheckBox
                                                                IsChecked="{Binding MergeAfterUpscale}"
                                                                ToolTip.Tip="Keep split files or merge back into a single video upon completion.">
                                                                <TextBlock Text="Auto-Merge Parts on Completion" FontSize="12" VerticalAlignment="Center" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Section 3: Hardware & Performance -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="HARDWARE &amp; PERFORMANCE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <Grid ColumnDefinitions="*,*">
                                                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,6,0">
                                                                <TextBlock Text="Hardware Accel:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <ComboBox
                                                                    ItemsSource="{Binding AvailableHardwareAccelerations}"
                                                                    SelectedItem="{Binding SelectedHardwareAcceleration}"
                                                                    HorizontalAlignment="Stretch" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="4" Margin="6,0,0,0">
                                                                <TextBlock Text="Workers:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <ComboBox
                                                                    ItemsSource="{Binding AvailableConcurrencies}"
                                                                    SelectedItem="{Binding MaxConcurrency}"
                                                                    HorizontalAlignment="Stretch" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Render Speed Profile:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableSpeedModes}"
                                                                SelectedItem="{Binding SelectedSpeedMode}"
                                                                HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Playback Output Tempo:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding SelectedPlaybackSpeed, StringFormat='{}{0:0.##}x'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                            </Grid>
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailablePlaybackSpeeds}"
                                                                SelectedItem="{Binding SelectedPlaybackSpeed}"
                                                                HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding StringFormat='{}{0:0.##}x Normal'}" FontSize="12" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Target Output Framerate (FPS):" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableTargetFramerates}"
                                                                SelectedItem="{Binding SelectedTargetFramerate}"
                                                                HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Scratch / Temp Directory:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <TextBox
                                                                    Text="{Binding ScratchDirectory}"
                                                                    Watermark="Default (System Temp Drive)"
                                                                    IsReadOnly="True"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="12" />
                                                                <Button
                                                                    Grid.Column="1"
                                                                    Command="{Binding SelectScratchDirectoryCommand}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    Padding="6,4"
                                                                    Margin="4,0,0,0"
                                                                    ToolTip.Tip="Browse for custom scratch directory on a fast SSD">
                                                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                                </Button>
                                                                <Button
                                                                    Grid.Column="2"
                                                                    Command="{Binding ResetScratchDirectoryCommand}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    Padding="6,4"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip.Tip="Reset to system default temp directory"
                                                                    IsVisible="{Binding ScratchDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                </Button>
                                                            </Grid>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Section 4: Camera & Metadata Normalization -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="FILE &amp; CAMERA METADATA NORMALIZATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Camera Metadata Profile:" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                            <ComboBox
                                                                ItemsSource="{Binding AvailableCameraProfileTypes}"
                                                                SelectedItem="{Binding SelectedCameraProfileType}"
                                                                HorizontalAlignment="Stretch">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" FontSize="12" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <StackPanel
                                                            Spacing="8"
                                                            IsVisible="{Binding SelectedCameraProfileType, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static upscaling:CameraProfileType.Custom}}">
                                                            <Grid ColumnDefinitions="*,*">
                                                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                                    <TextBlock Text="Make / Manufacturer:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                    <TextBox Text="{Binding CameraMake}" Watermark="e.g. Sony, Apple" FontSize="12" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                                    <TextBlock Text="Model:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                    <TextBox Text="{Binding CameraModel}" Watermark="e.g. ILCE-7M4, iPhone 15 Pro" FontSize="12" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Software / Firmware:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <TextBox Text="{Binding CameraSoftware}" Watermark="e.g. v3.00, iOS 19.1" FontSize="12" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="4">
                                                                <TextBlock Text="Lens Model / Hardware:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <TextBox Text="{Binding CameraLensModel}" Watermark="e.g. iPhone 17 Pro Max back triple camera 24mm f/1.78" FontSize="12" />
                                                            </StackPanel>
                                                            <Grid ColumnDefinitions="*,*">
                                                                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,4,0">
                                                                    <TextBlock Text="Focal Length:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                    <TextBox Text="{Binding CameraFocalLength}" Watermark="e.g. 24mm" FontSize="12" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Spacing="4" Margin="4,0,0,0">
                                                                    <TextBlock Text="Aperture / f-stop:" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                    <TextBox Text="{Binding CameraFNumber}" Watermark="e.g. 1.78" FontSize="12" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </StackPanel>

                                                        <CheckBox
                                                            IsChecked="{Binding CameraInjectTimestamp}"
                                                            ToolTip.Tip="Injects fresh UTC creation timestamp metadata into the video container to clear original tracking logs.">
                                                            <TextBlock Text="Inject Fresh Creation Timestamp" FontSize="12" VerticalAlignment="Center" />
                                                        </CheckBox>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Section 4: Video Filters -->
                                                <Border Background="{DynamicResource AntigravityCanvasBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="VIDEO PRE-FILTERS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                        <StackPanel Orientation="Horizontal" Spacing="20">
                                                            <CheckBox IsChecked="{Binding EnableDenoise}" ToolTip.Tip="High quality 3D denoise filter (hqdn3d)">
                                                                <TextBlock Text="Denoise" FontSize="12" VerticalAlignment="Center" />
                                                            </CheckBox>
                                                            <CheckBox IsChecked="{Binding EnableDeinterlace}" ToolTip.Tip="Adaptive deinterlace filter (yadif)">
                                                                <TextBlock Text="Deinterlace" FontSize="12" VerticalAlignment="Center" />
                                                            </CheckBox>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="TuneVariant" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="Enhance &amp; Split..." FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Color Grading Button -->
                        <Button
                            Command="{Binding ToggleColorGradingPanelCommand}"
                            Theme="{DynamicResource MaterialOutlineButton}"
                            CornerRadius="6"
                            Padding="10,5"
                            Margin="8,2,0,2"
                            ToolTip.Tip="Open Color Grading &amp; Real-Time Split Preview">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="PaletteOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="Color Grading" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  Expandable Color Grading & Enhancement Panel  -->
        <Border
            Grid.Row="1"
            IsVisible="{Binding IsColorGradingPanelOpen}"
            Padding="24,18"
            Background="{DynamicResource AntigravityPanelBrush}"
            BorderBrush="{DynamicResource AntigravityBorderBrush}"
            BorderThickness="0,0,0,1">
            <StackPanel Spacing="16">
                <!-- Top Status / Target Bar -->
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Target Badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="20" Height="20" Foreground="{DynamicResource AntigravityAccentBrush}" />
                        <TextBlock Text="Color Grading &amp; Visual Enhancement" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />

                        <Border
                            IsVisible="{Binding IsEditingJobGrading}"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="#1FFFFFFF"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="FileVideoOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityTextBrush}" />
                                <TextBlock Text="{Binding SelectedJob.FileName, StringFormat='Editing: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Border
                            IsVisible="{Binding !IsEditingJobGrading}"
                            Padding="8,3"
                            CornerRadius="8"
                            Background="#14FFFFFF"
                            BorderBrush="#33FFFFFF"
                            BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Earth" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBlock Text="Global Batch Preset (Applied to newly added videos)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Button
                            IsVisible="{Binding IsEditingJobGrading}"
                            Command="{Binding SwitchToGlobalGradingCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            Padding="6,2"
                            ToolTip.Tip="Switch back to editing Global Batch Preset">
                            <TextBlock Text="Switch to Global" FontSize="11" Foreground="{DynamicResource AntigravityAccentBrush}" />
                        </Button>
                    </StackPanel>

                    <!-- Actions: Reset & Apply All -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Command="{Binding ApplyColorGradingToAllCommand}"
                            Theme="{DynamicResource MaterialOutlineButton}"
                            ToolTip.Tip="Copy these color grading settings to all currently queued videos">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" />
                                <TextBlock Text="Apply to All Queued" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding ResetColorGradingCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="Reset brightness, contrast, saturation, normalize and LUT to default values">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Restore" Width="16" Height="16" />
                                <TextBlock Text="Reset Defaults" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding ToggleColorGradingPanelCommand}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            Padding="4"
                            ToolTip.Tip="Close Color Grading Panel">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Interactive Split-Screen Preview & Controls Grid -->
                <Grid ColumnDefinitions="1.2*,*">
                    <!-- Left: Real-Time Split-Screen Preview Card -->
                    <Border
                        Grid.Column="0"
                        Margin="0,0,16,0"
                        Padding="12"
                        Background="#0DFFFFFF"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource AntigravityBorderBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <!-- Preview Frame Container with Zoom & Pan -->
                            <Border
                                Background="#0A000000"
                                CornerRadius="8"
                                ClipToBounds="True"
                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                BorderThickness="1"
                                Height="270">
                                <Grid>
                                    <!-- Scrollable / Pannable Image Container for Fine Detail Inspection -->
                                    <ScrollViewer
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto">
                                        <LayoutTransformControl>
                                            <LayoutTransformControl.LayoutTransform>
                                                <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}" />
                                            </LayoutTransformControl.LayoutTransform>
                                            <Image
                                                IsVisible="{Binding !!PreviewImage}"
                                                Source="{Binding PreviewImage}"
                                                Stretch="Uniform"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </LayoutTransformControl>
                                    </ScrollViewer>

                                    <!-- Empty / No Video State -->
                                    <StackPanel
                                        IsVisible="{Binding !PreviewImage}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Compare" Width="40" Height="40" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                        <TextBlock
                                            Text="{Binding PreviewError, FallbackValue='Add a video or select a job to see real-time split-screen preview'}"
                                            FontSize="12"
                                            Foreground="{DynamicResource AntigravityMutedBrush}"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            MaxWidth="340"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Top Labels: ORIGINAL (Left) vs GRADED (Right) -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Top" Margin="10,8" IsVisible="{Binding !!PreviewImage}">
                                        <!-- Left Pill -->
                                        <Border
                                            Grid.Column="0"
                                            Background="#B3000000"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            BorderBrush="#40FFFFFF"
                                            BorderThickness="1">
                                            <TextBlock Text="ORIGINAL" FontSize="10" FontWeight="Bold" Foreground="#DDFFFFFF" />
                                        </Border>

                                        <!-- Right Pill -->
                                        <Border
                                            Grid.Column="2"
                                            Background="#B3000000"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            BorderBrush="{DynamicResource AntigravityAccentBrush}"
                                            BorderThickness="1">
                                            <TextBlock Text="GRADED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Floating Zoom & Pan Controls Overlay -->
                                    <Border
                                        IsVisible="{Binding !!PreviewImage}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="10,8"
                                        Background="#CC000000"
                                        CornerRadius="6"
                                        Padding="4,2"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Command="{Binding ZoomOutCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,2" ToolTip.Tip="Zoom Out">
                                                <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding ResetZoomCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="6,2" ToolTip.Tip="Reset to 100%">
                                                <TextBlock Text="{Binding ZoomScale, StringFormat='{}{0:0}x'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                            </Button>
                                            <Button Command="{Binding ZoomInCommand}" Theme="{DynamicResource MaterialFlatButton}" Padding="4,2" ToolTip.Tip="Zoom In (Inspect edges &amp; textures)">
                                                <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Top Loading Bar -->
                                    <ProgressBar
                                        IsIndeterminate="True"
                                        IsVisible="{Binding IsPreviewLoading}"
                                        VerticalAlignment="Top"
                                        Height="3"
                                        Foreground="{DynamicResource AntigravityAccentBrush}" />
                                </Grid>
                            </Border>

                            <!-- Interactive Draggable Comparison Split Slider -->
                            <Border
                                IsVisible="{Binding !!PreviewImage}"
                                Background="#0AFFFFFF"
                                CornerRadius="6"
                                Padding="10,6"
                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ArrowLeftBold" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <TextBlock Text="Original" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Slider
                                        Grid.Column="1"
                                        Margin="10,0"
                                        Minimum="0.05"
                                        Maximum="0.95"
                                        Value="{Binding SplitDividerRatio}"
                                        SmallChange="0.01"
                                        LargeChange="0.05"
                                        ToolTip.Tip="Drag divider left/right across the frame to inspect fine edge details"
                                        VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Graded" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                        <materialIcons:MaterialIcon Kind="ArrowRightBold" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </StackPanel>

                                    <Border
                                        Grid.Column="3"
                                        Margin="10,0,0,0"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        Background="#1FFFFFFF">
                                        <TextBlock Text="{Binding SplitDividerRatio, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Timeline Scrubber & Timestamp -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Playhead Readout -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="TimelineClockOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock
                                        Text="{Binding FormattedPreviewTimestamp}"
                                        FontSize="12"
                                        FontFamily="Cascadia Code,Consolas,Courier New"
                                        Foreground="{DynamicResource AntigravityTextBrush}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Scrubber Slider -->
                                <Slider
                                    Grid.Column="1"
                                    Margin="12,0"
                                    Minimum="0"
                                    Maximum="{Binding VideoDurationSeconds}"
                                    Value="{Binding PreviewTimestampSeconds}"
                                    SmallChange="1"
                                    LargeChange="5"
                                    VerticalAlignment="Center" />

                                <!-- Refresh Button -->
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding RefreshPreviewCommand}"
                                    Theme="{DynamicResource MaterialFlatButton}"
                                    Padding="4"
                                    ToolTip.Tip="Refresh preview frame">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                                </Button>
                            </Grid>

                            <!-- Live RGB & Luminance Histogram Panel -->
                            <Border
                                IsVisible="{Binding !!PreviewImage}"
                                Background="#10000000"
                                CornerRadius="6"
                                Padding="10,8"
                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <!-- Histogram Header & Toggle -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="ChartAreaspline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                            <TextBlock Text="RGB &amp; Luma Color Histogram" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                            <!-- Channel Legend Indicators -->
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding ShowHistogram}">
                                                <Border Width="8" Height="8" CornerRadius="2" Background="#FFFF5555" ToolTip.Tip="Red Channel" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="#FF55FF55" ToolTip.Tip="Green Channel" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="#FF5599FF" ToolTip.Tip="Blue Channel" />
                                                <Border Width="8" Height="8" CornerRadius="2" Background="#E0FFFFFF" ToolTip.Tip="Luminance" />
                                            </StackPanel>

                                            <!-- Toggle Button -->
                                            <Button
                                                Command="{Binding ToggleHistogramCommand}"
                                                Theme="{DynamicResource MaterialFlatButton}"
                                                Padding="4,2"
                                                ToolTip.Tip="Toggle Histogram Display">
                                                <Panel>
                                                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" IsVisible="{Binding ShowHistogram}" />
                                                    <materialIcons:MaterialIcon Kind="EyeOffOutline" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" IsVisible="{Binding !ShowHistogram}" />
                                                </Panel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Waveform Graph Area -->
                                    <Border
                                        IsVisible="{Binding ShowHistogram}"
                                        Background="#E60A0D14"
                                        CornerRadius="4"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        Height="65"
                                        ClipToBounds="True">
                                        <Grid>
                                            <!-- Grid Lines for 0%, 25%, 50%, 75%, 100% -->
                                            <Grid ColumnDefinitions="*,*,*,*">
                                                <Border Grid.Column="0" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" />
                                                <Border Grid.Column="1" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" />
                                                <Border Grid.Column="2" BorderBrush="#15FFFFFF" BorderThickness="0,0,1,0" />
                                                <Border Grid.Column="3" />
                                            </Grid>

                                            <!-- Waveform Paths (Rendered inside Viewbox) -->
                                            <Viewbox Stretch="Fill" IsVisible="{Binding HasHistogramData}">
                                                <Canvas Width="256" Height="60">
                                                    <!-- Red Channel -->
                                                    <Path Data="{Binding RedHistogramPath}" Fill="#35FF4444" Stroke="#CCFF5555" StrokeThickness="1" />
                                                    <!-- Green Channel -->
                                                    <Path Data="{Binding GreenHistogramPath}" Fill="#3544FF44" Stroke="#CC55FF55" StrokeThickness="1" />
                                                    <!-- Blue Channel -->
                                                    <Path Data="{Binding BlueHistogramPath}" Fill="#354488FF" Stroke="#CC5599FF" StrokeThickness="1" />
                                                    <!-- Luminance Waveform -->
                                                    <Path Data="{Binding LumaHistogramPath}" Stroke="#EEFFFFFF" StrokeThickness="1.2" />
                                                </Canvas>
                                            </Viewbox>

                                            <!-- Empty or Calculating State -->
                                            <TextBlock
                                                Text="Analyzing color spectrum..."
                                                FontSize="10"
                                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding !HasHistogramData}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Right: Advanced Color Grading & Cinematic Presets Suite -->
                    <Border
                        Grid.Column="1"
                        Padding="16,14"
                        Background="#0DFFFFFF"
                        CornerRadius="8"
                        BorderBrush="{DynamicResource AntigravityBorderBrush}"
                        BorderThickness="1">
                        <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="12" Margin="0,0,8,0">
                                <!-- Top: Cinematic Presets Dropdown & Management -->
                                <Border
                                    Padding="10,8"
                                    Background="#14FFFFFF"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="MovieFilterOutline" Width="18" Height="18" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBlock Text="Preset:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <ComboBox
                                                Grid.Column="1"
                                                Margin="8,0"
                                                ItemsSource="{Binding AvailableColorPresetNames}"
                                                SelectedItem="{Binding SelectedColorPresetName}"
                                                HorizontalAlignment="Stretch" />

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button
                                                    Command="{Binding OpenSavePresetPopupCommand}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    Padding="6,4"
                                                    ToolTip.Tip="Save current settings as a new custom preset">
                                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                </Button>
                                                <Button
                                                    Command="{Binding DeleteCurrentPresetCommand}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    Padding="6,4"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}"
                                                    ToolTip.Tip="Delete selected custom preset">
                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                                </Button>
                                                <Button
                                                    Command="{Binding ImportPresetsCommand}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    Padding="6,4"
                                                    ToolTip.Tip="Import presets from JSON file">
                                                    <materialIcons:MaterialIcon Kind="DownloadOutline" Width="16" Height="16" />
                                                </Button>
                                                <Button
                                                    Command="{Binding ExportPresetsCommand}"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    Padding="6,4"
                                                    ToolTip.Tip="Export all presets to JSON file">
                                                    <materialIcons:MaterialIcon Kind="UploadOutline" Width="16" Height="16" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Inline Save Preset Form Overlay -->
                                        <Border
                                            IsVisible="{Binding IsSavePresetPopupOpen}"
                                            Padding="10"
                                            Background="{DynamicResource AntigravityPanelBrush}"
                                            CornerRadius="6"
                                            BorderBrush="{DynamicResource AntigravityAccentBrush}"
                                            BorderThickness="1">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Save Custom Preset" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                <TextBox
                                                    Text="{Binding NewPresetName}"
                                                    Watermark="Preset Name (e.g. My Warm Sunset)"
                                                    FontSize="11"
                                                    Padding="6,4" />
                                                <TextBox
                                                    Text="{Binding NewPresetDescription}"
                                                    Watermark="Optional Description"
                                                    FontSize="11"
                                                    Padding="6,4" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,4,0,0">
                                                    <Button
                                                        Command="{Binding CancelSavePresetCommand}"
                                                        Theme="{DynamicResource MaterialFlatButton}"
                                                        Padding="8,3">
                                                        <TextBlock Text="Cancel" FontSize="11" />
                                                    </Button>
                                                    <Button
                                                        Command="{Binding ConfirmSavePresetCommand}"
                                                        Classes="accent"
                                                        Theme="{DynamicResource MaterialOutlineButton}"
                                                        Padding="10,3">
                                                        <TextBlock Text="Save Preset" FontSize="11" FontWeight="SemiBold" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Group 1: Basic Exposure & Temperature -->
                                <Border
                                    Background="#08FFFFFF"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <!-- Header / Toggle -->
                                        <Button
                                            Command="{Binding ToggleBasicExposureCommand}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="WhiteBalanceSunny" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                    <TextBlock Text="Basic Exposure &amp; Temp" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </StackPanel>
                                                <materialIcons:MaterialIcon
                                                    Grid.Column="1"
                                                    Kind="{Binding IsBasicExposureExpanded, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=ChevronDown}"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- Collapsible Content -->
                                        <StackPanel IsVisible="{Binding IsBasicExposureExpanded}" Spacing="8" Margin="10,0,10,10">
                                            <!-- Color Temperature -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="Thermometer" Width="14" Height="14" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                        <TextBlock Text="Color Temperature" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.ColorTemperature, StringFormat='{}{0} K'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="3500"
                                                    Maximum="9500"
                                                    Value="{Binding ActiveColorGrading.ColorTemperature}"
                                                    SmallChange="100"
                                                    LargeChange="500" />
                                            </StackPanel>

                                            <!-- Contrast -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Contrast" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Contrast, StringFormat='{}{0:0.00}x'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0.5"
                                                    Maximum="2.0"
                                                    Value="{Binding ActiveColorGrading.Contrast}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <!-- Saturation -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Saturation" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Saturation, StringFormat='{}{0:0.00}x'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0.0"
                                                    Maximum="2.0"
                                                    Value="{Binding ActiveColorGrading.Saturation}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <!-- Brightness -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Brightness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Brightness, StringFormat='{}{0:+0.00;-0.00;0.00}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="-1.0"
                                                    Maximum="1.0"
                                                    Value="{Binding ActiveColorGrading.Brightness}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <!-- Gamma (Midtone Curve) -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Gamma (Midtone Curve)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Gamma, StringFormat='{}{0:0.00}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0.5"
                                                    Maximum="2.0"
                                                    Value="{Binding ActiveColorGrading.Gamma}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <!-- Vibrance (Smart Saturation) -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Vibrance (Skin-Safe)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Vibrance, StringFormat='{}{0:+0.00;-0.00;0.00}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="-1.0"
                                                    Maximum="1.0"
                                                    Value="{Binding ActiveColorGrading.Vibrance}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <!-- Auto-Normalize -->
                                            <CheckBox
                                                IsChecked="{Binding ActiveColorGrading.AutoNormalize}"
                                                ToolTip.Tip="Applies FFmpeg 'normalize' filter to automatically balance dynamic range and black/white levels.">
                                                <TextBlock Text="Auto-Normalize Dynamic Range" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </CheckBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Group 2: Color Wheels & Tint -->
                                <Border
                                    Background="#08FFFFFF"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <!-- Header / Toggle -->
                                        <Button
                                            Command="{Binding ToggleColorWheelsCommand}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="PaletteAdvanced" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                    <TextBlock Text="Color Wheels &amp; Tinting" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </StackPanel>
                                                <materialIcons:MaterialIcon
                                                    Grid.Column="1"
                                                    Kind="{Binding IsColorWheelsExpanded, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=ChevronDown}"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- Collapsible Content -->
                                        <StackPanel IsVisible="{Binding IsColorWheelsExpanded}" Spacing="8" Margin="10,0,10,10">
                                            <!-- Matte Tone Curve Dropdown -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="Tone Curve:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                <ComboBox
                                                    Grid.Column="1"
                                                    ItemsSource="{Binding AvailableToneCurves}"
                                                    SelectedItem="{Binding ActiveColorGrading.ToneCurve}"
                                                    Width="130" />
                                            </Grid>

                                            <Separator Height="1" Background="{DynamicResource AntigravityBorderBrush}" Margin="0,2" />

                                            <!-- Shadows Tint Section -->
                                            <TextBlock Text="Shadows Tint (R / G / B)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                <!-- Shadow Red -->
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Red" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.ShadowRed}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Shadow Green -->
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Green" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.ShadowGreen}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Shadow Blue -->
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock Text="Blue" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.ShadowBlue}" SmallChange="0.05" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Midtones Tint Section (Gamma) -->
                                            <TextBlock Text="Midtones Tint (R / G / B)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" Margin="0,4,0,0" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                <!-- Midtone Red -->
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Red" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.MidtoneRed}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Midtone Green -->
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Green" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.MidtoneGreen}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Midtone Blue -->
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock Text="Blue" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.MidtoneBlue}" SmallChange="0.05" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Highlights Tint Section -->
                                            <TextBlock Text="Highlights Tint (R / G / B)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" Margin="0,4,0,0" />
                                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                                <!-- Highlight Red -->
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Red" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.HighlightRed}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Highlight Green -->
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Green" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.HighlightGreen}" SmallChange="0.05" />
                                                </StackPanel>
                                                <!-- Highlight Blue -->
                                                <StackPanel Grid.Column="2" Spacing="1">
                                                    <TextBlock Text="Blue" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" />
                                                    <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding ActiveColorGrading.HighlightBlue}" SmallChange="0.05" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Group 3: Film Emulation & FX -->
                                <Border
                                    Background="#08FFFFFF"
                                    CornerRadius="6"
                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                    BorderThickness="1">
                                    <StackPanel Spacing="6">
                                        <!-- Header / Toggle -->
                                        <Button
                                            Command="{Binding ToggleFilmEmulationCommand}"
                                            Theme="{DynamicResource MaterialFlatButton}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="10,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                    <materialIcons:MaterialIcon Kind="FilmstripBox" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                                    <TextBlock Text="Film Emulation &amp; FX" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                </StackPanel>
                                                <materialIcons:MaterialIcon
                                                    Grid.Column="1"
                                                    Kind="{Binding IsFilmEmulationExpanded, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=ChevronDown}"
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Grid>
                                        </Button>

                                        <!-- Collapsible Content -->
                                        <StackPanel IsVisible="{Binding IsFilmEmulationExpanded}" Spacing="8" Margin="10,0,10,10">
                                            <!-- 35mm Film Grain -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Organic 35mm Grain" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.FilmGrain}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0"
                                                    Maximum="20"
                                                    Value="{Binding ActiveColorGrading.FilmGrain}"
                                                    SmallChange="1"
                                                    LargeChange="2" />
                                            </StackPanel>

                                            <!-- Lens Vignette -->
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Lens Vignette" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.Vignette, StringFormat='{}{0:P0}'}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0.0"
                                                    Maximum="1.0"
                                                    Value="{Binding ActiveColorGrading.Vignette}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>

                                            <Separator Height="1" Background="{DynamicResource AntigravityBorderBrush}" Margin="0,2" />

                                            <!-- Custom 3D LUT Picker & Mix Opacity -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="Custom 3D LUT (.cube)" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                    <TextBlock
                                                        Text="{Binding ActiveColorGrading.LutFileName, FallbackValue='No LUT selected'}"
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource AntigravityTextBrush}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip.Tip="{Binding ActiveColorGrading.LutPath}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button
                                                        Command="{Binding SelectLutFileCommand}"
                                                        Theme="{DynamicResource MaterialOutlineButton}"
                                                        Padding="6,3"
                                                        ToolTip.Tip="Select .cube 3D LUT file">
                                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                                    </Button>
                                                    <Button
                                                        IsVisible="{Binding !!ActiveColorGrading.LutPath}"
                                                        Command="{Binding ClearLutFileCommand}"
                                                        Theme="{DynamicResource MaterialFlatButton}"
                                                        Padding="4,3"
                                                        Foreground="{DynamicResource AntigravityMutedBrush}"
                                                        ToolTip.Tip="Remove 3D LUT">
                                                        <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- LUT Opacity / Mix Slider -->
                                            <StackPanel Spacing="2" IsVisible="{Binding !!ActiveColorGrading.LutPath}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Grid.Column="0" Text="LUT Mix / Opacity" FontSize="10" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ActiveColorGrading.LutOpacity, StringFormat='{}{0:P0}'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityAccentBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                                <Slider
                                                    Minimum="0.0"
                                                    Maximum="1.0"
                                                    Value="{Binding ActiveColorGrading.LutOpacity}"
                                                    SmallChange="0.05"
                                                    LargeChange="0.1" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!--  Main Content: Drag & Drop Area / DataGrid Queue  -->
        <Grid Grid.Row="2">
            <!-- Empty State / Clean Drop Zone when queue is empty -->
            <Border
                IsVisible="{Binding !Jobs.Count}"
                Margin="40,32"
                Padding="48,40"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AntigravityPanelBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <Border
                        Width="64"
                        Height="64"
                        HorizontalAlignment="Center"
                        Background="#14FFFFFF"
                        CornerRadius="32">
                        <materialIcons:MaterialIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AntigravityAccentBrush}"
                            Kind="VideoPlusOutline" />
                    </Border>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AntigravityTextBrush}"
                        Text="Drop Videos Here to Upscale" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Foreground="{DynamicResource AntigravityMutedBrush}"
                        Text="Supports MP4, MOV, MKV, AVI, WebM • AI Resolution up to 4K" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
                        <Button
                            Command="{Binding AddFilesCommand}"
                            Classes="accent"
                            CornerRadius="8"
                            Padding="16,8"
                            Theme="{DynamicResource MaterialOutlineButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="Plus" Width="18" Height="18" />
                                <TextBlock Text="Browse Videos..." FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding AddFolderCommand}"
                            CornerRadius="8"
                            Padding="16,8"
                            Theme="{DynamicResource MaterialFlatButton}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="18" Height="18" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBlock Text="Select Folder..." VerticalAlignment="Center" Foreground="{DynamicResource AntigravityTextBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Active DataGrid Queue -->
            <DataGrid
                IsVisible="{Binding !!Jobs.Count}"
                Margin="16"
                ItemsSource="{Binding Jobs}"
                SelectedItem="{Binding SelectedJob}"
                Background="Transparent"
                BorderThickness="0"
                CanUserResizeColumns="True"
                GridLinesVisibility="Horizontal"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Visible">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="Color Grading &amp; Real-Time Preview"
                            Command="{Binding SelectJobForGradingCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="TuneVariant" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Split Video into Parts"
                            Command="{Binding SplitQueuedJobCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="CallSplit" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="Move Priority Up"
                            Command="{Binding MoveJobUpCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="ArrowUp" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Move Priority Down"
                            Command="{Binding MoveJobDownCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="ArrowDown" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="View Processing &amp; Error Log"
                            Command="{Binding ViewDetailedLogCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Retry Job"
                            Command="{Binding RetryJobCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Cancel / Remove Job"
                            Command="{Binding CancelJobCommand}"
                            CommandParameter="{Binding SelectedJob}">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <!-- File Name & Path -->
                    <DataGridTemplateColumn Header="Video File" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <Grid ColumnDefinitions="Auto,*" Margin="8,6" VerticalAlignment="Center">
                                    <Border
                                        Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="8"
                                        Background="#14FFFFFF"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon
                                            Kind="VideoOutline"
                                            Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock
                                                Text="{Binding FileName}"
                                                FontWeight="SemiBold"
                                                FontSize="13"
                                                Foreground="{DynamicResource AntigravityTextBrush}"
                                                ToolTip.Tip="{Binding FilePath}" />
                                            <Border
                                                IsVisible="{Binding HasPartBadge}"
                                                Background="#1FFFFFFF"
                                                BorderBrush="#44FFFFFF"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="4,1"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    Text="{Binding PartBadge}"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource AntigravityTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border
                                                Background="#14FFFFFF"
                                                CornerRadius="4"
                                                Padding="4,1">
                                                <TextBlock
                                                    Text="{Binding InputResolution}"
                                                    FontSize="10"
                                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            </Border>
                                            <TextBlock
                                                Text="•"
                                                FontSize="10"
                                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                IsVisible="{Binding !HasPartBadge}"
                                                Text="{Binding FilePath}"
                                                FontSize="11"
                                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                                MaxWidth="380"
                                                TextTrimming="CharacterEllipsis"
                                                VerticalAlignment="Center" />
                                            <TextBlock
                                                IsVisible="{Binding HasPartBadge}"
                                                Text="{Binding Caption}"
                                                FontSize="11"
                                                Foreground="{DynamicResource AntigravityMutedBrush}"
                                                MaxWidth="380"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Caption}"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Target & Codec -->
                    <DataGridTemplateColumn Header="Target" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <StackPanel VerticalAlignment="Center" Spacing="3" Margin="6,0">
                                    <Border
                                        Padding="6,2"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        Background="#14FFFFFF">
                                        <TextBlock
                                            Text="{Binding TargetResolution}"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </Border>
                                    <TextBlock
                                        Text="{Binding Codec}"
                                        FontSize="10"
                                        Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Enhancements & Features Badges -->
                    <DataGridTemplateColumn Header="Enhance" Width="115">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0">
                                    <!-- Graded -->
                                    <Border
                                        IsVisible="{Binding ColorGrading.HasActiveGrading}"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#14FFFFFF"
                                        ToolTip.Tip="Color Graded">
                                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                    <!-- Facial Clarity -->
                                    <Border
                                        IsVisible="{Binding EnableFacialClarity}"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#14FFFFFF"
                                        ToolTip.Tip="Facial Clarity Active">
                                        <materialIcons:MaterialIcon Kind="FaceWomanOutline" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                    <!-- Face Detail Recovery AI -->
                                    <Border
                                        IsVisible="{Binding EnableFaceRestoration}"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#14FFFFFF"
                                        ToolTip.Tip="Face Detail Recovery (AI) Active">
                                        <materialIcons:MaterialIcon Kind="FaceRecognition" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                    <!-- Split -->
                                    <Border
                                        IsVisible="{Binding HasPartBadge}"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#14FFFFFF"
                                        ToolTip.Tip="{Binding PartBadge}">
                                        <materialIcons:MaterialIcon Kind="CallSplit" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                    <!-- Denoise -->
                                    <Border
                                        IsVisible="{Binding EnableDenoise}"
                                        Padding="5,2"
                                        CornerRadius="4"
                                        Background="#14FFFFFF"
                                        ToolTip.Tip="Denoise Active">
                                        <materialIcons:MaterialIcon Kind="ImageFilterDrama" Width="12" Height="12" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="105">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <Border
                                    Padding="8,3"
                                    CornerRadius="10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="#14FFFFFF">
                                    <TextBlock
                                        Text="{Binding Status}"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AntigravityTextBrush}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Progress -->
                    <DataGridTemplateColumn Header="Progress" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <StackPanel VerticalAlignment="Center" Spacing="4" Margin="4,0">
                                    <ProgressBar
                                        Height="5"
                                        CornerRadius="2.5"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding Progress}"
                                        Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding Progress, StringFormat='{}{0:0.#}%'}"
                                            FontSize="11"
                                            Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            IsVisible="{Binding !!Fps}"
                                            Text="{Binding Fps, StringFormat='{}{0:0.#} fps'}"
                                            FontSize="11"
                                            Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Elapsed Time -->
                    <DataGridTemplateColumn Header="Elapsed" Width="75">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <TextBlock
                                    Text="{Binding ElapsedTime, StringFormat='{}{0:mm\\:ss}'}"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AntigravityMutedBrush}"
                                    FontSize="12" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="upscaling:UpscaleJob">
                                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                    <!-- Color Grading Button -->
                                    <Button
                                        Command="{Binding #RootControl.((components:VideoUpscalerViewModel)DataContext).SelectJobForGradingCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="5"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        CornerRadius="6"
                                        ToolTip.Tip="Color Grading &amp; Split Preview">
                                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Button>

                                    <!-- Split Job into Parts -->
                                    <Button
                                        Command="{Binding #RootControl.((components:VideoUpscalerViewModel)DataContext).SplitQueuedJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="5"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        CornerRadius="6"
                                        IsVisible="{Binding !HasPartBadge}"
                                        ToolTip.Tip="Split video into parts now">
                                        <materialIcons:MaterialIcon Kind="CallSplit" Width="15" Height="15" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                    </Button>

                                    <!-- Retry Button -->
                                    <Button
                                        Command="{Binding #RootControl.((components:VideoUpscalerViewModel)DataContext).RetryJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="5"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        CornerRadius="6"
                                        ToolTip.Tip="Retry Job">
                                        <materialIcons:MaterialIcon Kind="Refresh" Width="15" Height="15" />
                                    </Button>

                                    <!-- Log Details -->
                                    <Button
                                        Command="{Binding #RootControl.((components:VideoUpscalerViewModel)DataContext).ViewDetailedLogCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="5"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        CornerRadius="6"
                                        ToolTip.Tip="View Processing Log">
                                        <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="15" Height="15" />
                                    </Button>

                                    <!-- Cancel / Delete -->
                                    <Button
                                        Command="{Binding #RootControl.((components:VideoUpscalerViewModel)DataContext).CancelJobCommand}"
                                        CommandParameter="{Binding}"
                                        Padding="5"
                                        Theme="{DynamicResource MaterialFlatButton}"
                                        CornerRadius="6"
                                        Foreground="{DynamicResource AntigravityMutedBrush}"
                                        ToolTip.Tip="Cancel / Remove Job">
                                        <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!--  Expandable Detailed Log Modal Overlay  -->
            <Border
                IsVisible="{Binding IsLogViewerVisible}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#99000000">
                <Border
                    Width="680"
                    Height="480"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AntigravityPanelBrush}"
                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Header -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="20" Height="20" Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock Text="Job Execution &amp; Error Log" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource AntigravityTextBrush}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                Command="{Binding CloseLogViewerCommand}"
                                Theme="{DynamicResource MaterialFlatButton}"
                                Padding="4">
                                <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" />
                            </Button>
                        </Grid>

                        <!-- Log Content -->
                        <Border
                            Grid.Row="1"
                            Padding="12"
                            Background="#14000000"
                            CornerRadius="6"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox
                                    Text="{Binding LogViewerContent}"
                                    IsReadOnly="True"
                                    FontFamily="Cascadia Code,Consolas,Courier New"
                                    FontSize="12"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button
                                Command="{Binding CloseLogViewerCommand}"
                                Classes="accent"
                                Theme="{DynamicResource MaterialOutlineButton}">
                                <TextBlock Text="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
