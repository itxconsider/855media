<UserControl
    x:Class="_855Media.Views.Components.AutoPostView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ld="clr-namespace:_855Media.Core.LDPlayer;assembly=855Media.Core"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:views="clr-namespace:_855Media.Views.Components"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Name="RootView"
    x:DataType="components:AutoPostViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="TargetRowDetails" x:DataType="components:FacebookPageTargetViewModel">
            <Border Background="{DynamicResource AntigravityElevatedBrush}" Padding="18,12" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource AntigravityBorderBrush}">
                <Expander Header="Account and Page details" IsExpanded="True" HorizontalAlignment="Stretch" FontSize="13">
                    <WrapPanel Margin="0,12,0,0">
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="User UID" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding UserUid}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Page ID" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding PageId}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Page UID" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding PersonaUid}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Email" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding Email}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Facebook app" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding AppClone}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Birthdate" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding Birthdate}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Reach" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding Reach}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Published Reels" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding PublishedReelsDisplay}" ToolTip.Tip="{Binding PublishedCountsTooltip}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Published photos" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding PublishedPhotosDisplay}" ToolTip.Tip="{Binding PublishedCountsTooltip}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="File group" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding FileInGroup}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Invites" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding PageInvite}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Maturity" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding MaturityName}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Daily posts / limit" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding DailyPostStatus}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="240" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Access" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding AccessStatus}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Reel source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding VideoReelPath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Photo source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding ImagePath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Story source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding StoryPath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Group Reel source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding GroupReelPath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Group photo source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding GroupPicturePath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Width="320" Margin="0,0,16,14" Spacing="4"><TextBlock Text="Additional Reel source" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" /><SelectableTextBlock Text="{Binding VideoLongPath}" FontSize="13" TextWrapping="Wrap" /></StackPanel>
                    </WrapPanel>
                </Expander>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ProfileRowDetails" x:DataType="components:FacebookProfileGroupViewModel">
            <ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource TargetRowDetails}" />
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <!-- Compact dashboard: only the tables scroll; their space follows the window. -->
        <Grid x:Name="DashboardLayout" Margin="20,16" RowDefinitions="Auto,*">
            <Border x:Name="RunOptionsCard" Grid.Row="0" Classes="card-panel" Padding="14,8" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                    <Grid x:Name="RunToolbar" ColumnDefinitions="*,Auto">
                    <WrapPanel x:Name="RunSummary" Grid.Column="0">
                        <TextBlock Text="{Binding PFlowDeviceSummary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,4" />
                        <TextBlock Text="{Binding PFlowTargetSummary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,4" />
                        <CheckBox IsChecked="{Binding PFlowDryRun}" IsEnabled="{Binding !IsRunning}" Content="Preview without publishing" Margin="0,0,22,4" ToolTip.Tip="{Binding PFlowModeSummary}" />
                        <CheckBox IsChecked="{Binding ShowOnlyOpen}" Content="Running devices only" Margin="0,0,22,4" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,22,4">
                            <TextBlock Text="Concurrent LDs" VerticalAlignment="Center" />
                            <NumericUpDown Value="{Binding RunThread}" Minimum="1" Maximum="32" Width="70" Height="30" FormatString="0" IsEnabled="{Binding !IsRunning}" />
                        </StackPanel>
                    </WrapPanel>
                <StackPanel x:Name="RunActionButtons" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,0,0,4">
                        <Button x:Name="RefreshDevicesButton" Command="{Binding LoadDevicesCommand}" ToolTip.Tip="Refresh devices and their public IP information." Content="Refresh devices" Classes="action-btn" Margin="0" IsEnabled="{Binding !IsRunning}" />
                    <Button Content="Targets &amp; media" Command="{Binding OpenManagePagesCommand}" Classes="action-btn" IsEnabled="{Binding !IsRunning}" />
                    <Button Content="Run settings" Command="{Binding OpenConfigCommand}" Classes="action-btn" IsEnabled="{Binding !IsRunning}" />
                    <Button x:Name="AutomationToggleButton" Content="{Binding AutomationButtonText}" Command="{Binding AutomationButtonCommand}" IsEnabled="{Binding CanToggleAutomation}" Classes="action-btn" Classes.btn-success="{Binding !IsRunning}" Classes.btn-danger="{Binding IsRunning}" />
                </StackPanel>
                    </Grid>
                    <Expander Header="LD Options" HorizontalAlignment="Stretch" IsExpanded="False" FontSize="12">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <TextBlock Text="LDPlayer folder" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBox Grid.Column="1" Text="{Binding LdFolder}" Height="32" ToolTip.Tip="{Binding LdFolder}" IsEnabled="{Binding !IsRunning}" />
                                <Button Grid.Column="2" Command="{Binding SetPathFolderCommand}" Classes="action-btn" Content="Browse folder" Margin="8,0,0,0" IsEnabled="{Binding !IsRunning}" />
                            </Grid>
                            <WrapPanel>
                                <CheckBox IsChecked="{Binding AutoSortLDPlayer}" Content="Arrange emulator windows" Margin="0,0,18,4" />
                                <Button Command="{Binding SortWindowsCommand}" Content="Arrange windows" Classes="action-btn" Margin="0,0,8,4" />
                                <Button Command="{Binding QuitAllCommand}" Content="Close all emulators" Classes="action-btn" Margin="0,0,18,4" IsEnabled="{Binding !IsRunning}" />
                                <TextBlock Text="{Binding StatusSummary}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>



            <Grid x:Name="DashboardTables" Grid.Row="1" ColumnDefinitions="2*,6,3*">
                <Border x:Name="DevicePanel" Grid.Column="0" Classes="card-panel" Padding="14,10">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Text="DEVICES · LIVE STEP STATUS" Classes="section-title" Margin="0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayedInstances.Count, StringFormat='Instances: {0}'}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityMutedBrush}" />
                        </Grid>
                        <DataGrid
                            x:Name="WorkerDataGrid"
                            FrozenColumnCount="3"
                            Grid.Row="1"
                            ItemsSource="{Binding DisplayedInstances}"
                            FontSize="13"
                            RowHeight="54"
                            AutoGenerateColumns="False"
                            CanUserSortColumns="True"
                            CanUserResizeColumns="True"
                            GridLinesVisibility="Horizontal"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            CornerRadius="8"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="8,10" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                                <Style Selector="DataGridCell">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="DataGridCell > TextBlock">
                                    <Setter Property="Margin" Value="8,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="46" MinWidth="40">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox IsChecked="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).IsAllSelected, Mode=TwoWay}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ToolTip.Tip="Select All / Deselect All" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="components:LDInstanceItemViewModel">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="No" Binding="{Binding Index}" Width="50" MinWidth="40" IsReadOnly="True" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="125" MinWidth="100" FontWeight="Bold" IsReadOnly="True" />
                                <DataGridTextColumn Header="FB" Binding="{Binding FbClone}" Width="65" MinWidth="60" />
                                <DataGridTemplateColumn Header="IP location" Width="205" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="components:LDInstanceItemViewModel">
                                            <StackPanel Spacing="3" Margin="8,5" ToolTip.Tip="{Binding NetworkDetail}">
                                                <TextBlock Text="{Binding NetworkLocation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding PublicIp}" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Status" Width="*" MinWidth="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="components:LDInstanceItemViewModel">
                                            <Border
                                                Padding="8,3"
                                                Margin="0,4"
                                                CornerRadius="6"
                                                Background="{DynamicResource AntigravityElevatedBrush}"
                                                HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" TextTrimming="CharacterEllipsis" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Actions" Width="112" MinWidth="108">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="components:LDInstanceItemViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" HorizontalAlignment="Left" IsEnabled="{Binding !$parent[UserControl].((components:AutoPostViewModel)DataContext).IsRunning}">
                                                <Button Command="{Binding LaunchCommand}" ToolTip.Tip="Start LDPlayer" Padding="6" Width="28" Height="28">
                                                    <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="#10B981" />
                                                </Button>
                                                <Button Command="{Binding QuitCommand}" ToolTip.Tip="Close LDPlayer" Padding="6" Width="28" Height="28">
                                                    <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="#EF4444" />
                                                </Button>
                                                <Button Command="{Binding ClearCacheCommand}" ToolTip.Tip="Clear FB Cache" Padding="6" Width="28" Height="28">
                                                    <materialIcons:MaterialIcon Kind="Broom" Width="14" Height="14" Foreground="#F59E0B" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <GridSplitter x:Name="DashboardTableSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Drag to resize the LD and queue panels" />
                <Border x:Name="QueuePanel" Grid.Column="2" Classes="card-panel" Padding="14,8" Margin="6,0,0,0">
                    <Expander x:Name="DashboardQueuePanel" IsExpanded="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Spacing="4">
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="POST QUEUE &amp; OUTCOMES" FontWeight="SemiBold" Margin="0,0,20,4" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PFlowQueuedCount, StringFormat='Queued  {0}'}" Margin="0,0,16,4" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PFlowConfirmedCount, StringFormat='Confirmed  {0}'}" Foreground="#10B981" Margin="0,0,16,4" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PFlowFailedCount, StringFormat='Failed  {0}'}" Foreground="#EF4444" Margin="0,0,16,4" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding PFlowReviewCount, StringFormat='Needs review  {0}'}" Foreground="#F59E0B" Margin="0,0,16,4" VerticalAlignment="Center" />
                                </WrapPanel>

                            </StackPanel>
                        </Expander.Header>
                        <Grid RowDefinitions="Auto,*" Margin="0,8,0,0">
                            <StackPanel Spacing="6" Margin="0,0,0,8">
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Command="{Binding ShowPFlowHistoryCommand}" Classes="action-btn" Content="History &amp; review" Padding="8,4" FontSize="12" Margin="0,0,8,4" />
                                    <Button Command="{Binding RetryQueueCommand}" Classes="action-btn" Content="Retry failed / cancelled" IsEnabled="{Binding !IsRunning}" Padding="8,4" FontSize="12" Margin="0,0,8,4" ToolTip.Tip="Requeue retryable jobs using the same files and targets. Unknown posts require History review before retrying those posts; other queued posts can continue." />
                                    <Button Command="{Binding ClearTasksCommand}" Classes="action-btn" Content="Clear queue" IsEnabled="{Binding !IsRunning}" Padding="8,4" FontSize="12" Margin="0,0,8,4" />
                                </WrapPanel>
                                <Border IsVisible="{Binding PFlowNeedsReview}" Background="{DynamicResource AntigravityElevatedBrush}" Padding="8" CornerRadius="6">
                                    <TextBlock Text="Publication could not be confirmed. Other queued posts can continue. Check this post and record its outcome in History; its files are retained and automatic reposting is blocked." TextWrapping="Wrap" Foreground="#F59E0B" />
                                </Border>
                                <TextBlock IsVisible="{Binding PFlowQueueEmpty}" Text="No queued posts. Open Targets &amp; media to choose targets and prepare the queue." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" />
                            </StackPanel>
                        <views:PostQueueGrid
                            Grid.Row="1"
                            ItemsSource="{Binding Tasks}"
                            x:Name="PostQueueDataGrid"
                            FontSize="13"
                            RowHeight="44"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            CanUserSortColumns="True"
                            CanUserReorderColumns="True"
                            HorizontalScrollBarVisibility="Visible"
                            VerticalScrollBarVisibility="Auto"
                            GridLinesVisibility="Horizontal"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            CornerRadius="8"
                            MinHeight="0">
                            <DataGrid.Styles>
                                <Style Selector="DataGridColumnHeader">
                                    <Setter Property="Padding" Value="8,5" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                </Style>
                                <Style Selector="DataGridCell">
                                    <Setter Property="Padding" Value="8,4" />
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Stt" Binding="{Binding Index}" Width="50" MinWidth="40" IsReadOnly="True" />
                                <DataGridTextColumn Header="Caption" Binding="{Binding Title}" Width="*" MinWidth="160" FontWeight="SemiBold" IsReadOnly="True" />
                                <DataGridTextColumn Header="Source file" Binding="{Binding FilePath}" Width="180" MinWidth="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="Device Name" Binding="{Binding DeviceName}" Width="110" MinWidth="80" />
                                <DataGridTextColumn Header="App" Binding="{Binding App}" Width="70" MinWidth="50" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80" MinWidth="60" />
                                <DataGridTextColumn Header="Page" Binding="{Binding Page}" Width="180" MinWidth="100" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Part group" Binding="{Binding PartGroupDisplay}" Width="200" MinWidth="100" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Current step / outcome" Width="340" MinWidth="240"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="ld:AutoPostTaskItem"><TextBlock Text="{Binding Status}" ToolTip.Tip="{Binding Status}" TextWrapping="Wrap" Margin="4" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </views:PostQueueGrid>
                        </Grid>
                    </Expander>
                </Border>
            </Grid>
        </Grid>
        <!-- 4. MODAL OVERLAY: MANAGE PAGES (MODAL 2) -->
        <Border
            IsVisible="{Binding IsManagePagesOpen}"
            Background="#D0000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border Classes="modal-window">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Facebook" Width="22" Height="22" Foreground="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="Targets &amp; media" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseManagePagesCommand}" Padding="6" CornerRadius="6">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="{DynamicResource AntigravityCardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <WrapPanel>
                                <Button Content="Fetch accounts" Command="{Binding FetchSelectedPagesInfoCommand}" IsEnabled="{Binding !IsBusy}" Classes="action-btn btn-success" Margin="0,0,8,4" ToolTip.Tip="Fetch accounts and their Pages from selected devices" />
                                <Button Content="Stop fetch" Command="{Binding CancelFetchCommand}" IsVisible="{Binding IsBusy}" Classes="action-btn btn-danger" Margin="0,0,8,4" />
                                <Button Content="Assign media" Command="{Binding OpenBulkPathsCommand}" Classes="action-btn" Margin="0,0,8,4" ToolTip.Tip="Assign media to checked targets" />
                                <ToggleButton Content="Devices" IsChecked="{Binding IsLdPanelVisible, Mode=TwoWay}" Margin="0,0,8,4" Padding="12,6" ToolTip.Tip="Show or hide the device list" />
                                <ToggleButton Content="Post queue" IsChecked="{Binding IsPostQueuePanelVisible, Mode=TwoWay}" Margin="0,0,8,4" Padding="12,6" ToolTip.Tip="Show or hide queue settings" />
                                <Button Content="Refresh counts" Command="{Binding RefreshVisibleMediaCountsCommand}" IsEnabled="{Binding !IsRefreshingMediaCounts}" Classes="action-btn" Margin="0,0,8,4" ToolTip.Tip="Refresh media counts for visible targets" />
                                <Button Content="Manage posts" Command="{Binding ReviewPagePostsCommand}" IsEnabled="{Binding !IsBusy}" Classes="action-btn" Margin="0,0,8,4" ToolTip.Tip="Review Page posts and bulk delete selected posts" />
                                <Button Content="Remove selected" Command="{Binding DeleteSelectedPagesCommand}" Classes="action-btn" Margin="0,0,8,4" ToolTip.Tip="Remove checked targets from the saved list" />
                            </WrapPanel>
                            <TextBlock Grid.Column="1" Text="{Binding PFlowTargetSummary}" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityMutedBrush}" />
                        </Grid>
                    </Border>

                    <!-- Master-Detail: LD Instances on Left, Facebook Account & Pages on Right -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto, Auto, *, Auto, Auto">
                        <!-- LEFT PANEL: LD Instances Table -->
                        <Border Grid.Column="0" Width="390" IsVisible="{Binding IsLdPanelVisible}" BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Background="{DynamicResource AntigravityCardBrush}">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" Background="{DynamicResource AntigravityElevatedBrush}" Padding="10,8" CornerRadius="8,8,0,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="LDPLAYER INSTANCES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedInstancesCountSummary}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <DataGrid
                                    Grid.Row="1"
                                    ItemsSource="{Binding DisplayedInstances}"
                                    SelectedItem="{Binding SelectedManageInstance, Mode=TwoWay}"
                                    Name="ManageDeviceDataGrid"
                                    AutoGenerateColumns="False"
                                    GridLinesVisibility="Horizontal"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    RowHeight="NaN"
                                    CanUserSortColumns="True"
                                    CanUserResizeColumns="True"
                                    BorderThickness="0">
                                    <DataGrid.Styles>
                                        <Style Selector="DataGridRow">
                                            <Setter Property="MinHeight" Value="54" />
                                        </Style>
                                        <Style Selector="DataGridColumnHeader">
                                            <Setter Property="Padding" Value="4,4" />
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        </Style>
                                        <Style Selector="DataGridCell">
                                            <Setter Property="Padding" Value="4,2" />
                                            <Setter Property="FontSize" Value="11.5" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </DataGrid.Styles>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add Account" Command="{Binding OpenAddAccountCommand}" CommandParameter="{Binding SelectedManageInstance}" />
                                            <MenuItem Header="Manage accounts" Command="{Binding ManageDeviceAccountsCommand}" CommandParameter="{Binding SelectedManageInstance}" />
                                            <MenuItem Header="Close LD [selected]" Command="{Binding CloseSelectedLdCommand}" />
                                            <MenuItem Header="Fetch account info"
                                                      Command="{Binding FetchDevicePagesCommand}"
                                                      CommandParameter="{Binding SelectedManageInstance}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" Foreground="#10B981" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="38" MinWidth="34" MaxWidth="42">
                                            <DataGridTemplateColumn.Header>
                                                <CheckBox IsChecked="{Binding #RootView.((components:AutoPostViewModel)DataContext).IsAllManageInstancesSelected, Mode=TwoWay}"
                                                          ToolTip.Tip="Select / Deselect All LD Instances"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="components:LDInstanceItemViewModel">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              Command="{Binding #RootView.((components:AutoPostViewModel)DataContext).ToggleManageInstanceSelectionCommand}"
                                                              CommandParameter="{Binding}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="No" Binding="{Binding Index}" Width="50" MinWidth="44" IsReadOnly="True" />
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="90" MinWidth="90" FontWeight="Bold" IsReadOnly="True" />
                                        <DataGridTemplateColumn Header="Status" Width="*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="components:LDInstanceItemViewModel">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="4,8"
                                                               TextWrapping="Wrap"
                                                               ToolTip.Tip="{Binding Status}"
                                                               Foreground="#10B981" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- Splitter / Separator -->
                        <Border Grid.Column="1" Width="8" IsVisible="{Binding IsLdPanelVisible}" />

                        <!-- RIGHT PANEL: Pages Table for Selected LD -->
                        <TabControl Grid.Column="2" SelectedIndex="{Binding ManagePagesTabIndex, Mode=TwoWay}">
                            <TabItem Header="Targets"><Border BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Background="{DynamicResource AntigravityCardBrush}">
                            <Grid RowDefinitions="Auto, Auto, *">
                                <!-- Panel Header -->
                                <Border Grid.Row="0" Background="{DynamicResource AntigravityElevatedBrush}" Padding="12,8" CornerRadius="8,8,0,0">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="AccountBoxMultiple" Width="16" Height="16" Foreground="#3B82F6" VerticalAlignment="Center" />
                                            <TextBlock Text="Account identities" ToolTip.Tip="{Binding ManagePagesHeaderTitle}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="Files: available / total · Click for details · Right-click to update" FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">


                                            <Button
                                                Command="{Binding FetchDevicePagesCommand}"
                                                CommandParameter="{Binding SelectedManageInstance}"
                                                IsEnabled="{Binding !IsBusy}"
                                                Classes="action-btn"
                                                Padding="8,4"
                                                ToolTip.Tip="Refresh Facebook account details and managed pages">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                    <TextBlock Text="Fetch Account Info" FontSize="11" FontWeight="Bold" />
                                                </StackPanel>
                                            </Button>

                                            <Border Background="{DynamicResource AntigravityCardBrush}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding DisplayedManagePages.Count, StringFormat='Showing {0} items'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Filter Segmented Bar & Search Box -->
                                <Border Grid.Row="1" Margin="10,8,10,6" Padding="6,4" Background="{DynamicResource AntigravityElevatedBrush}" CornerRadius="8" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <!-- Filter All -->
                                            <Button
                                                Command="{Binding SetManagePagesFilterCommand}"
                                                CommandParameter="All"
                                                Classes="action-btn"
                                                Padding="12,5"
                                                FontSize="11"
                                                ToolTip.Tip="Show all accounts and pages">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="#3B82F6" />
                                                    <TextBlock Text="{Binding ManagePagesTotalCount, StringFormat='All ({0})'}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Filter Profile -->
                                            <Button
                                                Command="{Binding SetManagePagesFilterCommand}"
                                                CommandParameter="Profile"
                                                Classes="action-btn"
                                                Padding="12,5"
                                                FontSize="11"
                                                ToolTip.Tip="Show primary personal profile">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="Crown" Width="13" Height="13" Foreground="#60A5FA" />
                                                    <TextBlock Text="{Binding ManagePagesProfileCount, StringFormat='Primary Profile ({0})'}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Filter Pages -->
                                            <Button
                                                Command="{Binding SetManagePagesFilterCommand}"
                                                CommandParameter="Pages"
                                                Classes="action-btn"
                                                Padding="12,5"
                                                FontSize="11"
                                                ToolTip.Tip="Show managed Facebook pages">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="13" Height="13" Foreground="#10B981" />
                                                    <TextBlock Text="{Binding ManagePagesPagesCount, StringFormat='Managed Pages ({0})'}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>

                                            <Rectangle Width="1" Height="18" Fill="{DynamicResource AntigravityBorderBrush}" Margin="4,0" VerticalAlignment="Center" />

                                            <!-- Expand All -->
                                            <Button
                                                Command="{Binding ExpandAllGroupsCommand}"
                                                IsVisible="{Binding IsGroupedView}"
                                                Classes="action-btn"
                                                Padding="8,5"
                                                FontSize="11"
                                                ToolTip.Tip="Expand all profile groups">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="ArrowDownDropCircleOutline" Width="13" Height="13" Foreground="#60A5FA" />
                                                    <TextBlock Text="Expand All" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Collapse All -->
                                            <Button
                                                Command="{Binding CollapseAllGroupsCommand}"
                                                IsVisible="{Binding IsGroupedView}"
                                                Classes="action-btn"
                                                Padding="8,5"
                                                FontSize="11"
                                                ToolTip.Tip="Collapse all profile groups">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <materialIcons:MaterialIcon Kind="ArrowUpDropCircleOutline" Width="13" Height="13" Foreground="#94A3B8" />
                                                    <TextBlock Text="Collapse All" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>

                                        <!-- Right Side: View Mode & Search Box -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <!-- View Mode Selector -->
                                            <Border Background="{DynamicResource AntigravityCardBrush}" CornerRadius="6" Padding="2" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button
                                                        Command="{Binding ShowGroupedViewCommand}"
                                                        Classes="action-btn"
                                                        Padding="8,4"
                                                        FontSize="10.5"
                                                        ToolTip.Tip="Group pages under their profile with expand / collapse">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="FolderAccountOutline" Width="13" Height="13" Foreground="#38BDF8" />
                                                            <TextBlock Text="Grouped" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button
                                                        Command="{Binding ShowTableViewCommand}"
                                                        Classes="action-btn"
                                                        Padding="8,4"
                                                        FontSize="10.5"
                                                        ToolTip.Tip="Flat table view">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <materialIcons:MaterialIcon Kind="TableLarge" Width="13" Height="13" Foreground="#94A3B8" />
                                                            <TextBlock Text="Table" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- Search Box -->
                                            <Border Width="230" Height="30" CornerRadius="6" Background="{DynamicResource AntigravityCardBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" Padding="8,0">
                                                <Grid ColumnDefinitions="Auto, *">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="14" Height="14" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBox Grid.Column="1" Text="{Binding ManagePagesSearchQuery}" Watermark="Search page, UID, email, manager..." BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="11" Padding="0" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Target tables with badges and row context actions + Empty State -->
                                <Grid Grid.Row="2">
                                    <!-- 1. GROUPED VIEW: Profile Cards with Expand/Collapse & Child Pages Table -->
                                    <ScrollViewer
                                        IsVisible="{Binding IsExpandedGroupedView}"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{Binding DisplayedProfileGroups}" Margin="10,6,10,12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="components:FacebookProfileGroupViewModel">
                                                    <Border
                                                        Margin="0,0,0,12"
                                                        Background="{DynamicResource AntigravityElevatedBrush}"
                                                        BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        BoxShadow="0 4 12 0 #30000000">
                                                        <Grid RowDefinitions="Auto, Auto">
                                                            <!-- GROUP HEADER: Profile Information & Expand/Collapse Toggle -->
                                                            <Border
                                                                Grid.Row="0"
                                                                Background="{DynamicResource AntigravityCardBrush}"
                                                                Padding="10,8"
                                                                CornerRadius="8,8,0,0">
                                                                <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                                                                    <!-- Expand / Collapse Chevron Button -->
                                                                    <Button
                                                                        Grid.Column="0"
                                                                        Command="{Binding ToggleExpandCommand}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="4"
                                                                        Cursor="Hand"
                                                                        ToolTip.Tip="Expand / Collapse this Profile and its Pages"
                                                                        VerticalAlignment="Center">
                                                                        <Panel Width="20" Height="20">
                                                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="18" Height="18" Foreground="#60A5FA" IsVisible="{Binding IsExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            <materialIcons:MaterialIcon Kind="ChevronRight" Width="18" Height="18" Foreground="{DynamicResource AntigravityMutedBrush}" IsVisible="{Binding !IsExpanded}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Panel>
                                                                    </Button>

                                                                    <!-- Group CheckBox (Select all under profile) -->
                                                                    <CheckBox
                                                                        Grid.Column="1"
                                                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                        ToolTip.Tip="Select / Deselect this profile and all its pages"
                                                                        VerticalAlignment="Center"
                                                                        Margin="4,0,8,0" />

                                                                    <!-- Avatar -->
                                                                    <Border Grid.Column="2" Width="34" Height="34" CornerRadius="6" Background="{DynamicResource AntigravityElevatedBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                        <materialIcons:MaterialIcon Kind="AccountTie" Width="20" Height="20" Foreground="{DynamicResource AntigravityTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>

                                                                    <!-- Profile Info & Badges -->
                                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ProfileName}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                                            <!-- Primary Profile Badge -->
                                                                            <Border IsVisible="{Binding HasProfile}" Background="{DynamicResource AntigravityElevatedBrush}" CornerRadius="6" Padding="6,2" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                    <materialIcons:MaterialIcon Kind="Crown" Width="10" Height="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                                                    <TextBlock Text="Primary Profile" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                            <!-- Device Pill -->
                                                                            <Border Background="{DynamicResource AntigravityElevatedBrush}" CornerRadius="6" Padding="5,1.5" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DeviceName, StringFormat='Device: {0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                            </Border>
                                                                            <!-- Pages Count Badge -->
                                                                            <Border Background="{DynamicResource AntigravityElevatedBrush}" CornerRadius="6" Padding="6,1.5" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                    <materialIcons:MaterialIcon Kind="FileDocumentMultipleOutline" Width="10" Height="10" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                                                    <TextBlock Text="{Binding PagesCount, StringFormat='{}{0} Pages'}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </StackPanel>

                                                                        <Expander Header="Profile details" FontSize="12" IsExpanded="False"><ContentControl Content="{Binding Profile}" ContentTemplate="{StaticResource TargetRowDetails}" /></Expander>
                                                                    </StackPanel>


                                                                </Grid>
                                                            </Border>

                                                            <!-- GROUP BODY: Child Pages Table -->
                                                            <Border
                                                                Grid.Row="1"
                                                                IsVisible="{Binding IsExpanded}"
                                                                BorderThickness="0,1,0,0"
                                                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                                Background="{DynamicResource AntigravityCardBrush}"
                                                                CornerRadius="0,0,8,8">
                                                                <Panel>
                                                                    <!-- Child Pages DataGrid -->
                                                                    <DataGrid
RowHeight="48" FrozenColumnCount="2" IsReadOnly="True" AreRowDetailsFrozen="True" RowDetailsVisibilityMode="VisibleWhenSelected" RowDetailsTemplate="{StaticResource TargetRowDetails}" FontSize="13" RowBackground="#20242B"
                                                                        IsVisible="{Binding HasPages}"
                                                                        ItemsSource="{Binding Pages}"
                                                                        AutoGenerateColumns="False"
                                                                        GridLinesVisibility="Horizontal"
                                                                        VerticalScrollBarVisibility="Disabled"
                                                                        HorizontalScrollBarVisibility="Visible"
                                                                        CanUserResizeColumns="True"
                                                                        CanUserSortColumns="True"
                                                                        BorderThickness="0">
                                                                        <DataGrid.Styles>
    <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,6" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="DataGridRow:nth-child(2n)"><Setter Property="Background" Value="#282D35" /></Style>
    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="#303B4A" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#263D58" /></Style>
</DataGrid.Styles>
                                                                        <DataGrid.Columns>
<DataGridTemplateColumn Width="38" MinWidth="38" MaxWidth="44">
                                                                                <DataGridTemplateColumn.CellTemplate>
                                                                                    <DataTemplate DataType="components:FacebookPageTargetViewModel">
                                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                                  HorizontalAlignment="Center"
                                                                                                  VerticalAlignment="Center" />
                                                                                    </DataTemplate>
                                                                                </DataGridTemplateColumn.CellTemplate>
                                                                            </DataGridTemplateColumn>
<DataGridTemplateColumn Header="Name" SortMemberPath="PageName" Width="280" MinWidth="240">
    <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding PageName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="100" />
<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
<DataGridTemplateColumn Header="Reel files" SortMemberPath="ReelFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding ReelFilesDisplay}" ToolTip.Tip="{Binding ReelFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Photo files" SortMemberPath="PhotoFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding PhotoFilesDisplay}" ToolTip.Tip="{Binding PhotoFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Story files" SortMemberPath="StoryFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding StoryFilesDisplay}" ToolTip.Tip="{Binding StoryFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Group files" SortMemberPath="GroupFilesSortKey" Binding="{Binding GroupFilesDisplay}" Width="100" />
<DataGridTextColumn Header="Followers" Binding="{Binding FollowersDisplay}" Width="110" />
<DataGridTextColumn Header="Views" Binding="{Binding ViewsDisplay}" Width="110" />
<DataGridTextColumn Header="Created" SortMemberPath="CreationDateSortKey" Binding="{Binding CreationDateDisplay}" Width="190" />
<DataGridTextColumn Header="Maturity" SortMemberPath="Maturity" Binding="{Binding MaturityName}" Width="110" />
<DataGridTextColumn Header="Daily posts / limit" SortMemberPath="PostsToday" Binding="{Binding DailyPostStatus}" Width="145" />
<DataGridTemplateColumn Header="Status" SortMemberPath="TableStatus" Width="*" MinWidth="170">
    <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding TableStatus}" FontSize="13" VerticalAlignment="Center" ToolTip.Tip="{Binding AccessStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
                                                                    </DataGrid>

                                                                    <!-- Empty state when profile has no pages -->
                                                                    <Border IsVisible="{Binding !HasPages}" Padding="16" HorizontalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                            <TextBlock Text="No managed pages under this profile." FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Panel>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Collapse All: personal accounts only; Page selections are untouched. -->
                                    <DataGrid IsVisible="{Binding IsPersonalAccountsView}" ItemsSource="{Binding DisplayedPersonalAccounts}" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="48" FontSize="13" RowBackground="#20242B" FrozenColumnCount="2" AreRowDetailsFrozen="True" RowDetailsVisibilityMode="VisibleWhenSelected" RowDetailsTemplate="{StaticResource ProfileRowDetails}" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Styles>
    <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,6" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="DataGridRow:nth-child(2n)"><Setter Property="Background" Value="#282D35" /></Style>
    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="#303B4A" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#263D58" /></Style>
</DataGrid.Styles>
<DataGrid.Columns><DataGridTemplateColumn Header="Select" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:FacebookProfileGroupViewModel"><CheckBox IsChecked="{Binding Profile.IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Name" Binding="{Binding ProfileName}" Width="280" MinWidth="240" FontWeight="SemiBold" />
<DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="100" />
<DataGridTextColumn Header="Type" Binding="{Binding Profile.Type}" Width="100" />
<DataGridTemplateColumn Header="Reel files" SortMemberPath="Profile.ReelFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookProfileGroupViewModel"><TextBlock Text="{Binding Profile.ReelFilesDisplay}" ToolTip.Tip="{Binding Profile.ReelFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Photo files" SortMemberPath="Profile.PhotoFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookProfileGroupViewModel"><TextBlock Text="{Binding Profile.PhotoFilesDisplay}" ToolTip.Tip="{Binding Profile.PhotoFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Story files" SortMemberPath="Profile.StoryFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookProfileGroupViewModel"><TextBlock Text="{Binding Profile.StoryFilesDisplay}" ToolTip.Tip="{Binding Profile.StoryFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Group files" SortMemberPath="Profile.GroupFilesSortKey" Binding="{Binding Profile.GroupFilesDisplay}" Width="100" />
<DataGridTextColumn Header="Followers" Binding="{Binding Profile.FollowersDisplay}" Width="110" />
<DataGridTextColumn Header="Views" Binding="{Binding Profile.ViewsDisplay}" Width="110" />
<DataGridTextColumn Header="Created" SortMemberPath="Profile.CreationDateSortKey" Binding="{Binding Profile.CreationDateDisplay}" Width="190" />
<DataGridTextColumn Header="Maturity" SortMemberPath="Profile.Maturity" Binding="{Binding Profile.MaturityName}" Width="110" />
<DataGridTextColumn Header="Daily posts / limit" SortMemberPath="Profile.PostsToday" Binding="{Binding Profile.DailyPostStatus}" Width="145" />
<DataGridTextColumn Header="Status" Binding="{Binding Profile.TableStatus}" Width="*" MinWidth="170" /></DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 2. FLAT TABLE VIEW: Visible when IsGroupedView is False -->
                                    <DataGrid
RowHeight="48" FrozenColumnCount="2" IsReadOnly="True" AreRowDetailsFrozen="True" RowDetailsVisibilityMode="VisibleWhenSelected" RowDetailsTemplate="{StaticResource TargetRowDetails}" FontSize="13" RowBackground="#20242B"
                                        IsVisible="{Binding !IsGroupedView}"
                                        ItemsSource="{Binding DisplayedManagePages}"
                                        AutoGenerateColumns="False"
                                        GridLinesVisibility="Horizontal"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Visible"
                                        CanUserResizeColumns="True"
                                        CanUserSortColumns="True"
                                        BorderThickness="0">
                                        <DataGrid.Styles>
    <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="12,10" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,6" /><Setter Property="FontSize" Value="13" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="DataGridRow:nth-child(2n)"><Setter Property="Background" Value="#282D35" /></Style>
    <Style Selector="DataGridRow:pointerover"><Setter Property="Background" Value="#303B4A" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="#263D58" /></Style>
</DataGrid.Styles>
                                        <DataGrid.Columns>
<DataGridTemplateColumn Width="38" MinWidth="38" MaxWidth="44">
                                                <DataGridTemplateColumn.Header>
                                                    <CheckBox IsChecked="{Binding #RootView.((components:AutoPostViewModel)DataContext).IsAllManagePagesSelected, Mode=TwoWay}"
                                                              ToolTip.Tip="Select / Deselect All Pages"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </DataGridTemplateColumn.Header>
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate DataType="components:FacebookPageTargetViewModel">
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
<DataGridTemplateColumn Header="Name" SortMemberPath="PageName" Width="280" MinWidth="240">
    <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding PageName}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PageName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
<DataGridTextColumn Header="Device" Binding="{Binding DeviceName}" Width="100" />
<DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
<DataGridTemplateColumn Header="Reel files" SortMemberPath="ReelFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding ReelFilesDisplay}" ToolTip.Tip="{Binding ReelFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Photo files" SortMemberPath="PhotoFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding PhotoFilesDisplay}" ToolTip.Tip="{Binding PhotoFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTemplateColumn Header="Story files" SortMemberPath="StoryFilesSortKey" Width="140"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding StoryFilesDisplay}" ToolTip.Tip="{Binding StoryFilesTooltip}" VerticalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="Group files" SortMemberPath="GroupFilesSortKey" Binding="{Binding GroupFilesDisplay}" Width="100" />
<DataGridTextColumn Header="Followers" Binding="{Binding FollowersDisplay}" Width="110" />
<DataGridTextColumn Header="Views" Binding="{Binding ViewsDisplay}" Width="110" />
<DataGridTextColumn Header="Created" SortMemberPath="CreationDateSortKey" Binding="{Binding CreationDateDisplay}" Width="190" />
<DataGridTextColumn Header="Maturity" SortMemberPath="Maturity" Binding="{Binding MaturityName}" Width="110" />
<DataGridTextColumn Header="Daily posts / limit" SortMemberPath="PostsToday" Binding="{Binding DailyPostStatus}" Width="145" />
<DataGridTemplateColumn Header="Status" SortMemberPath="TableStatus" Width="*" MinWidth="170">
    <DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="components:FacebookPageTargetViewModel"><TextBlock Text="{Binding TableStatus}" FontSize="13" VerticalAlignment="Center" ToolTip.Tip="{Binding AccessStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
</DataGridTemplateColumn>
</DataGrid.Columns>
                                    </DataGrid>

                                    <!-- Clean Empty State Overlay when no accounts/pages are discovered -->
                                    <Border IsVisible="{Binding IsManagePagesEmpty}"
                                            Background="{DynamicResource AntigravityElevatedBrush}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" Margin="24">
                                            <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="AccountSearchOutline" Width="32" Height="32" Foreground="{DynamicResource AntigravityMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="No Facebook Accounts Discovered Yet" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AntigravityTextBrush}" />
                                                <TextBlock Text="Extract Facebook profile UID, email, and managed pages directly from this instance's root storage."
                                                           FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextAlignment="Center" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <Button Command="{Binding FetchSelectedPagesInfoCommand}" IsEnabled="{Binding !IsBusy}" Classes="action-btn" Background="#16A34A" Foreground="White" HorizontalAlignment="Center" Padding="16,8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" />
                                                    <TextBlock Text="Fetch account info" FontWeight="SemiBold" FontSize="12" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border></TabItem>
                            <TabItem Header="LD-Accounts">
                                <Border BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Padding="12" Background="{DynamicResource AntigravityCardBrush}">
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                        <TextBlock Text="{Binding LdAccountsHeading}" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Grid.Row="1" Text="{Binding LdAccountsSummary}" ToolTip.Tip="{Binding AccountMappingStatus}" TextWrapping="Wrap" Margin="0,8" />
                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                            <TextBox Text="{Binding AccountSearchText, Mode=TwoWay}" Watermark="Search LD number, account name or UID" MinWidth="120" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding AccountFilters}" SelectedItem="{Binding AccountFilter, Mode=TwoWay}" Width="155" Margin="8,0,0,0" />
                                        </Grid>
                                        <WrapPanel Grid.Row="3" Margin="0,0,0,8">
                                            <Button Content="Refresh mappings" Classes="action-btn" Command="{Binding RefreshAccountMappingsCommand}" IsEnabled="{Binding CanEditAccountBulkSelection}" Margin="0,0,8,4" />
                                            <Button Content="Save all account options" Classes="action-btn" Command="{Binding SaveAccountSelectionsCommand}" IsEnabled="{Binding CanEditAccountBulkSelection}" Margin="0,0,8,4" />
                                            <Button Content="Select visible" Classes="action-btn" Command="{Binding SelectAllMappedAccountsCommand}" IsEnabled="{Binding CanEditAccountBulkSelection}" Margin="0,0,8,4" />
                                            <Button Content="Clear selection" Classes="action-btn" Command="{Binding ClearMappedAccountSelectionCommand}" IsEnabled="{Binding CanEditAccountBulkSelection}" Margin="0,0,8,4" />
                                            <TextBlock Text="{Binding BulkAccountSelectionSummary}" VerticalAlignment="Center" Margin="8,0,0,4" />
                                        </WrapPanel>
                                        <StackPanel Grid.Row="4" Spacing="6" Margin="0,0,0,12">
                                            <WrapPanel>
                                                <TextBlock Text="Apply to selected:" VerticalAlignment="Center" Margin="0,0,12,4" />
                                                <ToggleSwitch Content="Fetch" IsChecked="{Binding BulkFetchEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyAccountBulkSelection}" Margin="0,0,16,4" ToolTip.Tip="On when all selected accounts have Fetch enabled. Off can also mean mixed values. Switching applies to all selected accounts; Save to keep changes." />
                                                <ToggleSwitch Content="ScreenTime" IsChecked="{Binding BulkScreenTimeEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyAccountBulkSelection}" Margin="0,0,16,4" ToolTip.Tip="On when all selected accounts have ScreenTime enabled. Off can also mean mixed values. Switching applies to all selected accounts; Save to keep changes." />
                                                <ToggleSwitch Content="Posting" IsChecked="{Binding BulkPostingEnabled, Mode=TwoWay}" IsEnabled="{Binding CanApplyAccountBulkSelection}" Margin="0,0,16,4" ToolTip.Tip="On when all selected accounts have Posting enabled. Off can also mean mixed values. Switching applies to all selected accounts; Save to keep changes." />
                                                <Button Content="Save selected accounts" Classes="action-btn btn-success" Command="{Binding SaveSelectedAccountOptionsCommand}" IsEnabled="{Binding CanApplyAccountBulkSelection}" Margin="0,0,0,4" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding BulkAccountSelectionStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </StackPanel>
                                        <DataGrid Grid.Row="5" x:Name="MappedAccountsList" ItemsSource="{Binding DisplayedMappedAccounts}"
                                            IsEnabled="{Binding CanEditAccountBulkSelection}" AutoGenerateColumns="False" IsReadOnly="True"
                                            RowHeight="40" GridLinesVisibility="Horizontal" FrozenColumnCount="2"
                                            HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"
                                            RowDetailsVisibilityMode="VisibleWhenSelected" AreRowDetailsFrozen="True">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="Select" Width="65">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:PFlowAccountItemViewModel">
                                                        <CheckBox IsChecked="{Binding IsSelectedForBulk, Mode=TwoWay}" IsEnabled="{Binding IsMappingValid}" HorizontalAlignment="Center" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="LD" Binding="{Binding DeviceName}" SortMemberPath="DeviceIndex" Width="110" />
                                                <DataGridTextColumn Header="Account" Binding="{Binding Name}" Width="180" />
                                                <DataGridTextColumn Header="UID" Binding="{Binding OwnerUid}" Width="160" />
                                                <DataGridTextColumn Header="Pages" Binding="{Binding PageCount}" Width="65" />
                                                <DataGridTemplateColumn Header="Status" Width="185">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:PFlowAccountItemViewModel">
                                                        <TextBlock Text="{Binding MappingLabel}" ToolTip.Tip="{Binding BindingStatus}" VerticalAlignment="Center" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Fetch" Width="95">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:PFlowAccountItemViewModel">
                                                        <CheckBox IsChecked="{Binding SelectedForDiscovery, Mode=TwoWay}" HorizontalAlignment="Center" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="ScreenTime" Width="95">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:PFlowAccountItemViewModel">
                                                        <CheckBox IsChecked="{Binding SelectedForScreenTime, Mode=TwoWay}" HorizontalAlignment="Center" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Posting" Width="95">
                                                    <DataGridTemplateColumn.CellTemplate><DataTemplate DataType="components:PFlowAccountItemViewModel">
                                                        <CheckBox IsChecked="{Binding SelectedForPosting, Mode=TwoWay}" HorizontalAlignment="Center" />
                                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                            <DataGrid.RowDetailsTemplate>
                                                <DataTemplate DataType="components:PFlowAccountItemViewModel">
<Border BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                            <StackPanel Spacing="6">
                                                                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding DeviceName}" /><TextBlock Text="{Binding OwnerUid}" /><TextBlock Text="{Binding AppPackage}" /></StackPanel>
                                                                <TextBlock Text="{Binding BindingStatus}" TextWrapping="Wrap" />
                                                                <Button Content="{Binding CredentialButtonLabel}" IsEnabled="{Binding CanOpenCredentials}" Classes="action-btn" HorizontalAlignment="Left" Command="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).OpenCredentialImportCommand}" CommandParameter="{Binding}" />
                                                                <Button Content="Review assigned instance" IsVisible="{Binding !IsMappingValid}" Classes="action-btn" HorizontalAlignment="Left" Command="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).OpenAccountRemapCommand}" CommandParameter="{Binding}" />
                                                                <WrapPanel>
                                                                    <Button Content="Transfer to LD…" Classes="action-btn" Margin="0,0,8,0" Command="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).OpenAccountTransferCommand}" CommandParameter="{Binding}" />
                                                                    <Button Content="Remove account…" Classes="action-btn" Command="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).OpenAccountRemovalCommand}" CommandParameter="{Binding}" />
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding AccessSummary}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <StackPanel Orientation="Horizontal" Spacing="16">
                                                                    <CheckBox Content="Fetch" IsChecked="{Binding SelectedForDiscovery}" ToolTip.Tip="Select this account for account discovery." />
                                                                    <CheckBox Content="ScreenTime" IsChecked="{Binding SelectedForScreenTime}" />
                                                                    <CheckBox Content="Posting" IsChecked="{Binding SelectedForPosting}" />
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding CredentialStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                                <WrapPanel>
                                                                    <CheckBox Content="Automatic login" IsChecked="{Binding AllowAutomaticLogin}" IsEnabled="{Binding CanEnableAutomaticLogin}" Margin="0,0,16,8" ToolTip.Tip="Store protected credentials first to recover expired sessions. Existing verified logins can run with this option off." />
                                                                    <CheckBox Content="Account rotation" IsChecked="{Binding AllowAccountRotation}" IsEnabled="{Binding CanEnableAccountRotation}" Margin="0,0,16,8" ToolTip.Tip="Requires protected credentials and Automatic login. Allows changing the active personal account on this LD." />
                                                                    <TextBlock Text="Run order" VerticalAlignment="Center" Margin="0,0,8,8" />
                                                                    <NumericUpDown Value="{Binding RotationOrder}" Minimum="0" Maximum="1000" Width="80" FormatString="0" Margin="0,0,0,8" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </Border>
                                                </DataTemplate>
                                            </DataGrid.RowDetailsTemplate>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </TabItem>
                            <TabItem Header="Media paths">
                                <Border BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Padding="12" Background="{DynamicResource AntigravityCardBrush}">
                                    <Grid RowDefinitions="Auto,*">
                                        <TextBlock Text="Check targets to assign paths in bulk. Edit media opens that target’s configuration. Counts use the configured file or folder." TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding DisplayedManagePages}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="components:FacebookPageTargetViewModel">
                                                        <Border BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10" Background="{DynamicResource AntigravityElevatedBrush}">
                                                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding PageName}" FontWeight="Bold" /><TextBlock Text="{Binding DeviceName}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" /></StackPanel>
                                                                <Button Grid.Column="2" Content="Edit media" Classes="action-btn" Command="{Binding $parent[UserControl].((components:AutoPostViewModel)DataContext).EditPageConfigCommand}" CommandParameter="{Binding}" />
                                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="Reels source" FontSize="11" FontWeight="SemiBold" Margin="0,12,0,4" />
                                                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding VideoReelPath}" ToolTip.Tip="{Binding VideoReelPath}" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Spacing="4" Margin="0,4,0,0"><TextBlock Text="{Binding ReelPathStatus}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" /><TextBlock Text="Photo source" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="{Binding ImagePath}" ToolTip.Tip="{Binding ImagePath}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ImagePathStatus}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" /><TextBlock Text="Story source" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="{Binding StoryPath}" ToolTip.Tip="{Binding StoryPath}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding StoryPathStatus}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" /></StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                                            <Border Grid.Column="3" Width="12" IsVisible="{Binding IsPostQueuePanelVisible}" /><Border Grid.Column="4" Width="260" IsVisible="{Binding IsPostQueuePanelVisible}" Background="{DynamicResource AntigravityCardBrush}" BorderThickness="1" BorderBrush="{DynamicResource AntigravityBorderBrush}" CornerRadius="8" Padding="14">
                            <Grid RowDefinitions="*,Auto">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="14">
                                        <TextBlock Text="PREPARE POST QUEUE" Classes="section-title" />
                                        <TextBlock Text="Choose targets and assign media first. Preparing the queue does not publish posts." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Post types · choose one or more" FontWeight="SemiBold" />
                                            <WrapPanel IsEnabled="{Binding !IsPreparingPostQueue}">
                                                <CheckBox Content="Reel" IsChecked="{Binding PrepareReels, Mode=TwoWay}" Margin="0,0,12,0" />
                                                <CheckBox Content="Photo" IsChecked="{Binding PreparePhotos, Mode=TwoWay}" Margin="0,0,12,0" />
                                                <CheckBox Content="Story" IsChecked="{Binding PrepareStories, Mode=TwoWay}" />
                                            </WrapPanel>
                                            <TextBlock Text="File / series limits apply per selected type; daily limits are shared." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        </StackPanel>
                                        <StackPanel Spacing="6"><TextBlock Text="File selection" FontWeight="SemiBold" /><ComboBox SelectedIndex="{Binding SelectedFileByIndex}" HorizontalAlignment="Stretch"><ComboBoxItem Content="Random" /><ComboBoxItem Content="Sequential" /></ComboBox></StackPanel>
                                        <StackPanel Spacing="6"><TextBlock Text="Files / series per target · min / max" FontWeight="SemiBold" ToolTip.Tip="Counts series for Pages with Keep video parts together enabled; otherwise counts individual files. Sequential uses the from/to selection range." /><Grid ColumnDefinitions="*,*"><NumericUpDown Value="{Binding PostFromCount}" Minimum="1" Maximum="50" FormatString="0" Margin="0,0,4,0" /><NumericUpDown Grid.Column="1" Value="{Binding PostToCount}" Minimum="1" Maximum="50" FormatString="0" Margin="4,0,0,0" /></Grid></StackPanel>
                                        <CheckBox Content="Use each file once across targets" IsChecked="{Binding UploadUniqueFile}" />
                                        <CheckBox Content="Show targets for checked devices" IsChecked="{Binding FilterBySelectedDevice}" />
                                        <CheckBox Content="Respect maturity limits" IsChecked="{Binding AutoMaxPostByMaturity}" />
                                        <Expander Header="Advanced"><CheckBox Content="Get Pages by API" IsChecked="{Binding GetPagesByApi}" Margin="0,8,0,0" /></Expander>
                                        <TextBlock Text="{Binding Tasks.Count, StringFormat='Current queue: {0} rows'}" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </StackPanel>
                                </ScrollViewer>
                                <Button Grid.Row="1" Content="Prepare post queue" Command="{Binding SetFileUploadCommand}" IsEnabled="{Binding !IsBusy}" Classes="action-btn btn-primary" HorizontalAlignment="Stretch" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
</Grid>

                    <!-- Modal Footer -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto, *, Auto" Margin="0,12,0,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Pages.Count, StringFormat='Saved targets: {0}'}" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="•" Foreground="{DynamicResource AntigravityTextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Saved to %AppData%/855Media/facebook_pages.json" FontSize="11" Foreground="{DynamicResource AntigravityTextMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Live Status Message in Footer Center -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBusy}">
                            <ProgressBar IsIndeterminate="True" Width="120" Height="4" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusSummary}" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                            <Button Command="{Binding CloseManagePagesCommand}" Content="Close" Classes="action-btn btn-secondary" Width="100" />
                            <Button Command="{Binding SaveAndCloseManagePagesCommand}" Content="Save &amp; Close" Classes="action-btn btn-primary" Width="130" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- 5. MODAL OVERLAY: UPDATE PAGE (MODAL 3) -->
        <Border
            IsVisible="{Binding IsUpdatePageOpen}"
            Background="#E0000000"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Border Classes="modal-window">
                <Grid RowDefinitions="Auto, *, Auto">
                    <!-- Modal Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="Facebook" Width="22" Height="22" Foreground="#3B82F6" VerticalAlignment="Center" />
                            <TextBlock Text="Update Page Configuration" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding CloseUpdatePageCommand}" Padding="6" CornerRadius="6">
                            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </Grid>

                    <!-- Content Layout -->
                    <ScrollViewer Grid.Row="1" IsEnabled="{Binding !IsSavingBulkPaths}">
                        <StackPanel Spacing="14">
                            <!-- Maturity & Daily Post Limits Banner -->
                            <Border Background="{DynamicResource AntigravityCardBrush}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                                <Grid ColumnDefinitions="*, *, *">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="PAGE MATURITY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedPageForEdit.MaturityName}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="POSTS TODAY / LIMIT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <TextBlock Text="{Binding SelectedPageForEdit.DailyPostStatus}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="CUSTOM MAX POSTS/DAY (0 = Auto)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                        <NumericUpDown Value="{Binding SelectedPageForEdit.CustomMaxDailyPosts, Mode=TwoWay}" Minimum="0" Maximum="50" Height="30" FormatString="0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Identifiers Row: Page ID (Canonical), Page UID, User UID -->
                            <Grid ColumnDefinitions="*, 8, *, 8, *, 8, *">
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="Page / Profile Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBox Text="{Binding SelectedPageForEdit.PageName}" Height="32" IsReadOnly="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="Page ID (Canonical)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBox Text="{Binding SelectedPageForEdit.PageId}" IsReadOnly="True" Height="32" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" Spacing="4">
                                    <TextBlock Text="Page UID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBox Text="{Binding SelectedPageForEdit.PersonaUid}" IsReadOnly="True" Height="32" Foreground="#A78BFA" />
                                </StackPanel>
                                <StackPanel Grid.Column="6" Spacing="4">
                                    <TextBlock Text="Admin User UID" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBox Text="{Binding SelectedPageForEdit.UserUid}" Height="32" IsReadOnly="True" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Target type and account identity are determined by Fetch. Fetch again to update them." FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />

                            <TextBlock Text="Media sources • choose a file or shared folder. Counts include matching files in the folder’s top level." TextWrapping="Wrap" FontSize="12" />
                            <!-- Posting sources: Reel, Photo, then Story -->
                            <Grid ColumnDefinitions="*, *, *" RowDefinitions="Auto, Auto">
                                 <!-- Reel Column -->
                                <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                    <TextBlock Text="Reel caption" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <CheckBox Content="Use title from text file" IsChecked="{Binding SelectedPageForEdit.ReelTitleFromTextFile, Mode=TwoWay}" />
                                    <CheckBox Content="Keep video parts together" IsChecked="{Binding SelectedPageForEdit.KeepReelPartsTogether, Mode=TwoWay}" />
                                    <TextBlock IsVisible="{Binding SelectedPageForEdit.KeepReelPartsTogether}" Text="Random selects a series; Part 1, 2, 3 post separately in order. Selection counts series. Unfinished parts continue when you prepare again. Recognizes numbered Part filenames." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock Text="Unchecked: use media filename. Checked: use matching .txt; fall back to filename if unavailable." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock Text="Reel source (file or folder)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.VideoReelPath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.VideoReelPath}" Height="38" Watermark="C:\Media\Reels or file..." />
                                        <Button Grid.Column="1" Command="{Binding BrowseVideoReelFileCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Reel file (.mp4, .mov, .webm, .mkv)">
                                            <TextBlock Text="File…" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding BrowseVideoReelFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse additional Reel folder">
                                            <TextBlock Text="Folder…" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedPageForEdit.ReelPathStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>

                                <!-- Image Column -->
                                <StackPanel Grid.Column="1" Spacing="6" Margin="4,0,4,0">
                                    <TextBlock Text="Photo caption" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <CheckBox Content="Use title from text file" IsChecked="{Binding SelectedPageForEdit.PhotoTitleFromTextFile, Mode=TwoWay}" />
                                    <TextBlock Text="Unchecked: use media filename. Checked: use matching .txt; fall back to filename if unavailable." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock Text="Photo source (file or folder)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.ImagePath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.ImagePath}" Height="38" Watermark="C:\Media\Images or file..." />
                                        <Button Grid.Column="1" Command="{Binding BrowseImageFileCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Image File (.jpg, .png, .webp)">
                                            <TextBlock Text="File…" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding BrowseImageFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Folder with Images">
                                            <TextBlock Text="Folder…" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedPageForEdit.ImagePathStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="6" Margin="8,0,0,0">
                                    <TextBlock Text="Story" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <Border MinHeight="24">
                                        <TextBlock Text="No caption or text overlay" VerticalAlignment="Center" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    </Border>
                                    <TextBlock Text="Uses the current Facebook audience. File backup/deletion follows Run settings." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock Text="Story source (photo/video file or folder)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBox Text="{Binding SelectedPageForEdit.StoryPath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.StoryPath}" Height="38" Watermark="C:\Media\Stories or file..." />
                                        <Button Grid.Column="1" Command="{Binding BrowseStoryFileCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Story photo or video">
                                            <TextBlock Text="File…" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding BrowseStoryFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Story folder">
                                            <TextBlock Text="Folder…" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedPageForEdit.StoryPathStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>

                                <!-- Additional saved Reel source -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" IsVisible="{Binding SelectedPageForEdit.HasAdditionalReelSource}" Spacing="6" Margin="0,12,0,0">
                                    <TextBlock Text="Additional Reel caption" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <CheckBox Content="Use title from text file" IsChecked="{Binding SelectedPageForEdit.VideoTitleFromTextFile, Mode=TwoWay}" />
                                    <TextBlock Text="Unchecked: use media filename. Checked: use matching .txt; fall back to filename if unavailable." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <TextBlock Text="Additional Reel source (from saved video configuration)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.VideoLongPath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.VideoLongPath}" Height="38" Watermark="C:\Media\Videos or file..." />
                                        <Button Grid.Column="1" Command="{Binding BrowseVideoLongFileCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Reel file">
                                            <TextBlock Text="File…" />
                                        </Button>
                                        <Button Grid.Column="2" Command="{Binding BrowseVideoLongFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse additional Reel folder">
                                            <TextBlock Text="Folder…" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding SelectedPageForEdit.VideoPathStatus}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{Binding PageConfigError}" Foreground="#F87171" TextWrapping="Wrap" />

                            <!-- Page Note -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Page Note" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBox Text="{Binding SelectedPageForEdit.PageNote, Mode=TwoWay}" Height="55" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Post in Group Groupbox -->
                            <Border BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Post in Group" FontWeight="Bold" Foreground="{DynamicResource AntigravityTextBrush}" />
                                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" Margin="0,0,8,6">
                                            <TextBlock Text="Title Post" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            <TextBox Text="{Binding SelectedPageForEdit.GroupPostTitle, Mode=TwoWay}" Height="32" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Margin="8,0,0,6">
                                            <TextBlock Text="Path Picture (Folder)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.GroupPicturePath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.GroupPicturePath}" Height="38" Watermark="Folder of pictures..." />
                                                <Button Grid.Column="1" Command="{Binding BrowseGroupPictureFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Folder">
                                                    <TextBlock Text="Folder…" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedPageForEdit.GroupPicturePathStatus}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4" Margin="0,0,8,0">
                                            <TextBlock Text="Path Reel (Folder)" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.GroupReelPath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.GroupReelPath}" Height="38" Watermark="Folder of reels..." />
                                                <Button Grid.Column="1" Command="{Binding BrowseGroupReelFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Folder">
                                                    <TextBlock Text="Folder…" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedPageForEdit.GroupReelPathStatus}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" IsVisible="{Binding SelectedPageForEdit.HasAdditionalGroupReelSource}" Spacing="4" Margin="8,0,0,0">
                                            <TextBlock Text="Additional Reel folder" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBox Grid.Column="0" Text="{Binding SelectedPageForEdit.GroupVideoPath, Mode=TwoWay}" ToolTip.Tip="{Binding SelectedPageForEdit.GroupVideoPath}" Height="38" Watermark="Folder of videos..." />
                                                <Button Grid.Column="1" Command="{Binding BrowseGroupVideoFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" ToolTip.Tip="Browse Folder">
                                                    <TextBlock Text="Folder…" />
                                                </Button>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedPageForEdit.GroupVideoPathStatus}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save & Cancel Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0" IsEnabled="{Binding !IsSavingBulkPaths}">
                        <Button Command="{Binding CloseUpdatePageCommand}" Content="Cancel" Classes="action-btn btn-secondary" Width="90" />
                        <Button Command="{Binding SavePageConfigCommand}" Content="Save" Classes="action-btn btn-primary" Width="90" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>


        <Border IsVisible="{Binding IsBulkPathsOpen}" Background="#D0000000">
            <Border Classes="modal-window" MaxWidth="1600">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Spacing="8" Margin="0,0,0,16">
                        <TextBlock Text="Update media paths for selected Pages" FontSize="20" FontWeight="Bold" />
                        <ScrollViewer MaxHeight="120"><TextBlock Text="{Binding BulkPathsTargets}" TextWrapping="Wrap" /></ScrollViewer>
                        <TextBlock Text="Check the paths and caption rules to update. Unchecked updates keep their current settings. A shared folder can be used by every selected target." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1">
                        <StackPanel Spacing="12">
                            <ItemsControl ItemsSource="{Binding BulkPathEdits}" IsEnabled="{Binding !IsSavingBulkPaths}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="components:PageMediaPathEdit">
                                        <Border Padding="8" Margin="0,0,8,12">
                                            <StackPanel Spacing="7">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding Apply}" FontWeight="SemiBold" />
                                                    <CheckBox Grid.Column="1" Content="Clear saved path" IsChecked="{Binding Clear}" />
                                                </Grid>
                                                <StackPanel Spacing="6" IsVisible="{Binding HasCaption}">
                                                    <CheckBox Content="Update caption rule" IsChecked="{Binding ApplyCaption}" />
                                                    <CheckBox Content="Use title from text file" IsChecked="{Binding UseTitleFromTextFile}" IsEnabled="{Binding ApplyCaption}" />
                                                    <TextBlock Text="Unchecked: use media filename. Checked: use matching .txt; fall back to filename if unavailable." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                </StackPanel>
                                                <StackPanel Spacing="6" IsVisible="{Binding IsStory}">
                                                    <TextBlock Text="No caption or text overlay" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                    <TextBlock Text="Uses the current Facebook audience. File backup/deletion follows Run settings." FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto,Auto" IsEnabled="{Binding !Clear}">
                                                    <TextBox Text="{Binding Path, Mode=TwoWay}" Watermark="Paste an absolute path or choose a file / folder" ToolTip.Tip="{Binding Path}" Height="38" />
                                                    <Button Grid.Column="1" Content="File…" IsVisible="{Binding CanBrowseFile}" Command="{Binding BrowseFileCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" />
                                                    <Button Grid.Column="2" Content="Folder…" Command="{Binding BrowseFolderCommand}" Margin="4,0,0,0" Height="38" Padding="7,4" Background="{DynamicResource AntigravityCardBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding BulkPathsError}" Foreground="#F87171" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0" IsEnabled="{Binding !IsSavingBulkPaths}">
                        <Button Content="Cancel" Command="{Binding CloseBulkPathsCommand}" Classes="action-btn btn-secondary" />
                        <Button Content="Apply and save paths" Command="{Binding ApplyBulkPathsCommand}" Classes="action-btn btn-primary" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <views:RunSettingsView IsVisible="{Binding IsConfigOpen}" />
        <Border IsVisible="{Binding IsAccountManagementOpen}" Background="#D0000000" ZIndex="430">
            <Border Classes="modal-window" MaxWidth="720" VerticalAlignment="Center" Margin="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding AccountManagementTitle}" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding AccountManagementSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AccountManagementStatus}" TextWrapping="Wrap" />
                    <StackPanel Spacing="6" IsVisible="{Binding !IsAccountRemoval}" IsEnabled="{Binding !IsBusy}">
                        <TextBlock Text="Destination LD" />
                        <ComboBox ItemsSource="{Binding Instances}" SelectedItem="{Binding AccountTransferDestination}" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate><DataTemplate DataType="components:LDInstanceItemViewModel"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsEnabled="{Binding !IsBusy}">
                        <Button Content="Close" Classes="action-btn" Command="{Binding CloseAccountManagementCommand}" />
                        <Button Content="{Binding AccountManagementActionLabel}" Classes="action-btn btn-primary" Command="{Binding ApplyAccountManagementCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border IsVisible="{Binding IsAccountRemapOpen}" Background="#D0000000" ZIndex="410">
            <Border Classes="modal-window" MaxWidth="720" VerticalAlignment="Center" Margin="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Review assigned LD instance" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding AccountRemapSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding AccountRemapStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    <CheckBox Content="I confirm this is the account’s assigned LD instance" IsChecked="{Binding AccountRemapConfirmed}" IsEnabled="{Binding !IsSavingAccountRemap}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsEnabled="{Binding !IsSavingAccountRemap}">
                        <Button Content="Close" Classes="action-btn" Command="{Binding CancelAccountRemapCommand}" />
                        <Button Content="Apply assigned instance" IsEnabled="{Binding CanApplyAccountRemap}" Classes="action-btn btn-primary" Command="{Binding ApplyAccountRemapCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border IsVisible="{Binding IsCredentialImportOpen}" Background="#D0000000" ZIndex="400">
            <Border Classes="modal-window" MaxWidth="720" VerticalAlignment="Center" Margin="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="View and edit login credentials" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding CredentialTargetSummary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CredentialImportStatus}" TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    <TextBlock Text="Login identifier (email, phone or username supported by the installed login screen)" TextWrapping="Wrap" />
                    <TextBox Text="{Binding CredentialLoginIdentifier}" IsUndoEnabled="False" MaxLength="1024" IsEnabled="{Binding CanEditCredentialFields}" />
                    <TextBlock Text="UID|Password|2FA|Cookie — paste one line; leave Cookie empty" />
                    <TextBox Text="{Binding CredentialLine}" IsUndoEnabled="False" MaxLength="65536" IsEnabled="{Binding CanEditCredentialFields}" />
                    <TextBlock Text="2FA field type" />
                    <ComboBox ItemsSource="{Binding CredentialTwoFactorModes}" SelectedItem="{Binding CredentialTwoFactorMode}" IsEnabled="{Binding CanEditCredentialFields}" />
                    <TextBlock Text="TOTP secrets are reusable keys. Expiring one-time codes must be entered during a supported login challenge and are never saved. Cookie import is unavailable." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    <TextBlock Text="Saving replaces this account’s stored credentials using Windows user protection. No login is started." TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" IsEnabled="{Binding !IsSavingCredentials}">
                        <Button Content="Close" Classes="action-btn" Command="{Binding CancelCredentialImportCommand}" />
                        <Button Content="Save credentials" IsEnabled="{Binding CanSaveCredentialRecord}" Classes="action-btn btn-primary" Command="{Binding StoreMappedCredentialsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding IsAddAccountOpen}" Background="#D0000000" ZIndex="420">
            <Border Classes="modal-window" MaxWidth="760" MaxHeight="760" VerticalAlignment="Center" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add personal account" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding AddAccountSummary}" FontWeight="SemiBold" />
                    <TextBlock Text="UID | Password | 2FA secret (optional) | Email (optional)" />
                    <TextBox Text="{Binding AddAccountLine}" PasswordChar="●" IsUndoEnabled="False" MaxLength="65536" IsEnabled="{Binding !IsAddingAccount}" Watermark="Paste UID|Password · optional |2FA secret|Email" />
                    <TextBlock Text="UID and password are used to log in. Email is optional account metadata. Spaced Base32 TOTP secrets are accepted. New run selections start disabled." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    <Border Background="{DynamicResource AntigravityPanelBrush}" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Authentication code" FontWeight="SemiBold" />
                            <Expander Header="Email code · IMAP mailbox">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Yandex: enable IMAP and create a mail app password. Other providers must support IMAP with app-password authentication. TLS is required. This mailbox is mapped to the UID in the account line." TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,100">
                                        <TextBox Text="{Binding MailHost}" Watermark="IMAP host" IsEnabled="{Binding !IsMailBusy}" />
                                        <NumericUpDown Grid.Column="1" Value="{Binding MailPort}" Minimum="1" Maximum="65535" IsEnabled="{Binding !IsMailBusy}" />
                                    </Grid>
                                    <TextBox Text="{Binding MailEmail}" Watermark="Mailbox email" IsEnabled="{Binding !IsMailBusy}" />
                                    <TextBox Text="{Binding MailAppPassword}" PasswordChar="●" IsUndoEnabled="False" MaxLength="4096" Watermark="Mail app password (separate from Facebook password)" IsEnabled="{Binding !IsMailBusy}" />
                                    <Button Content="Test and save mailbox" Command="{Binding SaveAccountMailboxCommand}" IsEnabled="{Binding !IsMailBusy}" HorizontalAlignment="Left" Classes="action-btn" />
                                    <TextBlock Text="{Binding MailStatus}" TextWrapping="Wrap" />
                                    <Button Content="Stop email wait" Command="{Binding StopAccountMailCommand}" IsVisible="{Binding IsMailBusy}" HorizontalAlignment="Left" Classes="action-btn" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="Authenticator: generate from the 2FA secret above. SMS/email: enter the code you receive when the supported verification screen requests it." TextWrapping="Wrap" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Generate authenticator code" Classes="action-btn" IsEnabled="{Binding !IsAddingAccount}" Command="{Binding GenerateAddAccountOtpCommand}" />
                                <Button Content="Clear code" Classes="action-btn" IsEnabled="{Binding HasAddAccountOtpCode}" Command="{Binding ClearAddAccountOtpCommand}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasAddAccountOtpCode}">
                                <TextBox Text="{Binding AddAccountOtpCode, Mode=OneWay}" PasswordChar="{Binding AddAccountOtpPasswordChar}" IsReadOnly="True" IsUndoEnabled="False" FontSize="24" MaxLength="8" />
                                <CheckBox Grid.Column="1" Content="Show code" IsChecked="{Binding ShowAddAccountOtp}" Margin="14,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding AddAccountOtpStatus}" TextWrapping="Wrap" />
                            <StackPanel Spacing="8" IsVisible="{Binding IsWaitingForAddAccountOtp}">
                                <Button Content="Receive code from saved mailbox" Command="{Binding ReceiveAccountMailCodeCommand}" IsEnabled="{Binding !IsMailBusy}" HorizontalAlignment="Left" Classes="action-btn" />
                                <TextBox Text="{Binding AddAccountReceivedOtp}" PasswordChar="●" IsUndoEnabled="False" MaxLength="8" Watermark="Received verification code" />
                                <Button Content="Use received code" Classes="action-btn btn-primary" HorizontalAlignment="Left" Command="{Binding SubmitAddAccountOtpCommand}" />
                            </StackPanel>
                            <TextBlock Text="Code preview clears after 2 minutes or when this dialog closes. Automatic entry remains unavailable until the installed verification screen is supported. Codes are never saved to history or logs." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AddAccountStatus}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Close" Classes="action-btn" IsEnabled="{Binding !IsAddingAccount}" Command="{Binding CloseAddAccountCommand}" />
                        <Button Content="Stop login" Classes="action-btn" IsEnabled="{Binding IsAddingAccount}" Command="{Binding StopAddAccountCommand}" />
                        <Button Content="Start login" Classes="action-btn btn-primary" IsEnabled="{Binding !IsAddingAccount}" Command="{Binding StartAddAccountCommand}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
        <Border IsVisible="{Binding IsPreparingPostQueue}" ZIndex="1000" Background="#B8000000">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="20" Padding="28" CornerRadius="12" Background="{DynamicResource AntigravityCardBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1">
                <StackPanel Spacing="14">
                    <TextBlock Text="Preparing post queue" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Width="240" Height="5" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding QueuePreparationStatus}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="390" />
                    <TextBlock Text="Please wait while selected files are checked and saved." FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
