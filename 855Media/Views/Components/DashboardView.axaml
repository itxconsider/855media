<UserControl
    x:Class="_855Media.Views.Components.DashboardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:converters="clr-namespace:_855Media.Converters"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Name="UserControl"
    x:DataType="components:DashboardViewModel"
    Loaded="UserControl_OnLoaded">

    <UserControl.Styles>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.download-action">
            <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />

            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#14000000" />
                <Setter Property="Foreground" Value="{DynamicResource AntigravityTextBrush}" />
            </Style>
        </Style>

        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#14FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource AntigravityTextBrush}" />
            </Style>
            <Style Selector="^.active">
                <Setter Property="Background" Value="{DynamicResource AntigravityAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AntigravityAccentForegroundBrush}" />
            </Style>
        </Style>

        <Style Selector="Button.filter-chip">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource AntigravityTextBrush}" />
            </Style>
            <Style Selector="^.active">
                <Setter Property="Background" Value="{DynamicResource AntigravityAccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource AntigravityAccentForegroundBrush}" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource AntigravityCanvasBrush}" RowDefinitions="Auto,*,Auto">
            <!--  Top Navigation Header Tabs  -->
            <Border
                Grid.Row="0"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,10"
                Background="{DynamicResource AntigravityRailBrush}">
                <Grid ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
                            <Button
                                Command="{Binding SelectYouTubeTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsYouTubeTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Youtube" Width="18" Height="18" />
                                    <TextBlock Text="{Binding LocalizationManager.YouTubeTabTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding SelectTikTokTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsTikTokTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Music" Width="18" Height="18" />
                                    <TextBlock Text="{Binding LocalizationManager.TikTokTabTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding SelectFacebookTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsFacebookTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="Facebook" Width="18" Height="18" />
                                    <TextBlock Text="{Binding LocalizationManager.FacebookTabTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding SelectDramaBoxTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsDramaBoxTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="MoviePlay" Width="18" Height="18" Foreground="#E11D48" />
                                    <TextBlock Text="{Binding LocalizationManager.DramaBoxTabTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding SelectBatchTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsBatchTab}">
                                <TextBlock Text="{Binding LocalizationManager.BatchDownloadTabTitle}" VerticalAlignment="Center" />
                            </Button>

                            <Button
                                Command="{Binding SelectUpscalerTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsUpscalerTab}">
                                <TextBlock Text="{Binding LocalizationManager.UpscalerTabTitle}" VerticalAlignment="Center" />
                            </Button>

                            <Button
                                Command="{Binding SelectDubbingTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsDubbingTab}">
                                <TextBlock Text="Khmer Dubbing &amp; Voice" VerticalAlignment="Center" />
                            </Button>

                            <Button
                                Command="{Binding SelectManagerTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsManagerTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding LocalizationManager.DownloadsManagerTabTitle}" VerticalAlignment="Center" />
                                    <Border
                                        IsVisible="{Binding !!ActiveDownloadsCount}"
                                        Background="{DynamicResource AntigravityAccentBrush}"
                                        CornerRadius="10"
                                        Margin="4,0,0,0"
                                        Padding="6,2">
                                        <TextBlock
                                            Text="{Binding ActiveDownloadsCount}"
                                            FontSize="11"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AntigravityAccentForegroundBrush}" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <Button
                                Command="{Binding SelectHistoryTabCommand}"
                                Classes="tab-button"
                                Classes.active="{Binding IsHistoryTab}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="History" Width="18" Height="18" />
                                    <TextBlock Text="{Binding LocalizationManager.HistoryTabTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <TextBlock
                            Text="{Binding TotalDownloadsCount, StringFormat='Total: {0}'}"
                            Foreground="{DynamicResource AntigravityMutedBrush}"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                        <Separator Width="1" Height="22" Margin="2,0" Background="{DynamicResource AntigravityBorderBrush}" />

                        <!-- Global Hardware Check & Diagnostics Pill -->
                        <Button
                            Padding="8,4"
                            CornerRadius="16"
                            Background="#12FFFFFF"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="Global Hardware Status &amp; Module Readiness (Click for Details)">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                                    <Border
                                        Width="500"
                                        Padding="18"
                                        Background="{DynamicResource AntigravityElevatedBrush}"
                                        CornerRadius="14"
                                        BorderBrush="#383842"
                                        BorderThickness="1"
                                        BoxShadow="0 18 50 0 #F8000000">
                                        <StackPanel Spacing="14">
                                            <!-- Header & Refresh -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <materialIcons:MaterialIcon Kind="CheckDecagram" Width="20" Height="20" Foreground="#10B981" VerticalAlignment="Center" />
                                                        <TextBlock Text="Global Hardware Readiness" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="Hardware acceleration &amp; compute status for all modules" FontSize="12" Foreground="#9CA3AF" />
                                                </StackPanel>
                                                <Button
                                                    Grid.Column="1"
                                                    Command="{Binding RefreshGlobalHardwareCommand}"
                                                    Padding="8"
                                                    CornerRadius="8"
                                                    Background="#222228"
                                                    BorderBrush="#33333C"
                                                    BorderThickness="1"
                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                    ToolTip.Tip="Refresh Hardware Detection">
                                                    <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" Foreground="#D1D5DB" />
                                                </Button>
                                            </Grid>

                                            <Separator Height="1" Background="#262630" />

                                            <!-- Live System Specs & Telemetry Card -->
                                            <Border Background="{DynamicResource AntigravityCardBrush}" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="10" Padding="14">
                                                <StackPanel Spacing="10">
                                                    <!-- GPU & CPU Header -->
                                                    <Grid ColumnDefinitions="*,*">
                                                        <StackPanel Grid.Column="0" Spacing="3">
                                                            <TextBlock Text="GPU COMPUTE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                                            <TextBlock Text="{Binding GlobalHardware.Gpu.Name, FallbackValue='Detecting GPU...'}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding GlobalHardware.Gpu.DedicatedVramGb, StringFormat='Dedicated VRAM: {0:F1} GB'}" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="3">
                                                            <TextBlock Text="PROCESSOR &amp; RAM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" />
                                                            <TextBlock Text="{Binding GlobalHardware.CpuSummary, FallbackValue='CPU Detection...'}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding GlobalHardware.RamSummary, StringFormat='RAM: {0}'}" FontSize="12" Foreground="#D1D5DB" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Separator Height="1" Background="#22222A" Margin="0,4" />

                                                    <!-- Live Usage Meters -->
                                                    <Grid ColumnDefinitions="*,*,*,*" Margin="0,2,0,0">
                                                        <StackPanel Grid.Column="0" Spacing="3" HorizontalAlignment="Center">
                                                            <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:0}%'}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                            <ProgressBar Value="{Binding CpuUsagePercent}" Minimum="0" Maximum="100" Width="68" Height="6" CornerRadius="3" Background="#27272A" Foreground="#10B981" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Spacing="3" HorizontalAlignment="Center">
                                                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding RamUsagePercent, StringFormat='{}{0:0}%'}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                            <ProgressBar Value="{Binding RamUsagePercent}" Minimum="0" Maximum="100" Width="68" Height="6" CornerRadius="3" Background="#27272A" Foreground="#3B82F6" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Center">
                                                            <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding GpuUsagePercent, StringFormat='{}{0:0}%'}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                            <ProgressBar Value="{Binding GpuUsagePercent}" Minimum="0" Maximum="100" Width="68" Height="6" CornerRadius="3" Background="#27272A" Foreground="#8B5CF6" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="3" Spacing="3" HorizontalAlignment="Center">
                                                            <TextBlock Text="VRAM" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" />
                                                            <TextBlock Text="{Binding VramUsagePercent, StringFormat='{}{0:0}%'}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                                            <ProgressBar Value="{Binding VramUsagePercent}" Minimum="0" Maximum="100" Width="68" Height="6" CornerRadius="3" Background="#27272A" Foreground="#EC4899" />
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- MODULE READINESS STATUS -->
                                            <TextBlock Text="MODULE READINESS FOR ALL MODULES" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="0,2,0,0" />

                                            <StackPanel Spacing="10">
                                                <!-- Module 1: Media Downloader -->
                                                <Border Background="{DynamicResource AntigravityCardBrush}" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="DownloadBox" Width="24" Height="24" Foreground="#06B6D4" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="Media Downloader" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding GlobalHardware.Downloader.Summary}" FontSize="12" Foreground="#D1D5DB" />
                                                            <TextBlock Text="{Binding GlobalHardware.Downloader.Details}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GlobalHardware.Downloader.LevelBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Module 2: Video Upscaler -->
                                                <Border Background="{DynamicResource AntigravityCardBrush}" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AutoFix" Width="24" Height="24" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="Video Upscaler" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding GlobalHardware.Upscaler.Summary}" FontSize="12" Foreground="#D1D5DB" />
                                                            <TextBlock Text="{Binding GlobalHardware.Upscaler.Details}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GlobalHardware.Upscaler.LevelBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Module 3: Khmer Dubbing & Voice -->
                                                <Border Background="{DynamicResource AntigravityCardBrush}" BorderBrush="#2C2C34" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <materialIcons:MaterialIcon Grid.Column="0" Kind="AccountVoice" Width="24" Height="24" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="Khmer Dubbing &amp; Voice" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                                                            <TextBlock Text="{Binding GlobalHardware.Dubbing.Summary}" FontSize="12" Foreground="#D1D5DB" />
                                                            <TextBlock Text="{Binding GlobalHardware.Dubbing.Details}" FontSize="11" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Background="#2010B981" BorderBrush="#5010B981" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding GlobalHardware.Dubbing.LevelBadgeText}" FontSize="11" FontWeight="Bold" Foreground="#10B981" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>

                                            <!-- Footer Actions -->
                                            <Button
                                                Command="{Binding CopyHardwareDiagnosticsCommand}"
                                                HorizontalAlignment="Stretch"
                                                Padding="10"
                                                CornerRadius="8"
                                                Background="#27272A"
                                                BorderBrush="#3F3F46"
                                                BorderThickness="1"
                                                Theme="{DynamicResource MaterialFlatButton}">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Copy Diagnostic Report to Clipboard" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon
                                    Kind="ExpansionCardVariant"
                                    Width="16"
                                    Height="16"
                                    Foreground="{DynamicResource AntigravityAccentBrush}" />
                                <TextBlock
                                    Text="{Binding GpuNameShort}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AntigravityTextBrush}"
                                    VerticalAlignment="Center" />
                                <Border
                                    IsVisible="{Binding HasRtx}"
                                    Background="#2010B981"
                                    BorderBrush="#4010B981"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4,1">
                                    <TextBlock
                                        Text="RTX"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#10B981" />
                                </Border>
                                <Border
                                    Width="6"
                                    Height="6"
                                    CornerRadius="3"
                                    Background="#10B981"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Auth Setup Button -->
                        <Button
                            Padding="8"
                            Command="{Binding ShowAuthSetupCommand}"
                            Foreground="{DynamicResource AntigravityRailIconBrush}"
                            IsVisible="{OnPlatform False,
                                                   Windows=True}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="{Binding LocalizationManager.AuthTooltip}">
                            <materialIcons:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="AccountKey" />
                        </Button>

                        <!-- License & Activation Button -->
                        <Button
                            Padding="8"
                            Command="{Binding ShowLicenseActivationCommand}"
                            Foreground="{DynamicResource AntigravityRailIconBrush}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="License &amp; Activation">
                            <materialIcons:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="KeyVariant" />
                        </Button>

                        <!-- Settings Button -->
                        <Button
                            Padding="8"
                            Command="{Binding ShowSettingsCommand}"
                            Foreground="{DynamicResource AntigravityRailIconBrush}"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="{Binding LocalizationManager.SettingsTooltip}">
                            <materialIcons:MaterialIcon
                                Width="20"
                                Height="20"
                                Kind="Settings" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Tab Content Area  -->
            <Grid Grid.Row="1">
                <!--  YOUTUBE DOWNLOADER VIEW  -->
                <ContentControl Content="{Binding YouTubeDownloader}" IsVisible="{Binding IsYouTubeTab}" />

                <!--  TIKTOK DOWNLOADER VIEW  -->
                <ContentControl Content="{Binding TikTokDownloader}" IsVisible="{Binding IsTikTokTab}" />

                <!--  FACEBOOK DOWNLOADER VIEW  -->
                <ContentControl Content="{Binding FacebookDownloader}" IsVisible="{Binding IsFacebookTab}" />

                <!--  DRAMABOX DOWNLOADER VIEW  -->
                <ContentControl Content="{Binding DramaBoxDownloader}" IsVisible="{Binding IsDramaBoxTab}" />

                <!--  HISTORY VIEW  -->
                <ContentControl Content="{Binding History}" IsVisible="{Binding IsHistoryTab}" />

                <!--  AI VIDEO UPSCALER VIEW  -->
                <ContentControl Content="{Binding VideoUpscaler}" IsVisible="{Binding IsUpscalerTab}" />

                <!--  KHMER DUBBING & VOICE CLONING VIEW  -->
                <ContentControl Content="{Binding Dubbing}" IsVisible="{Binding IsDubbingTab}" />

                <!--  BATCH DOWNLOAD TAB  -->
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    IsVisible="{Binding IsBatchTab}"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Margin="48,32">
                        <Grid RowDefinitions="Auto,*,Auto" MaxWidth="880" HorizontalAlignment="Center">
                            <!-- Title & Guidance -->
                            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                                <TextBlock
                                    Text="{Binding LocalizationManager.BatchDownloadTabTitle}"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AntigravityTextBrush}" />
                                <TextBlock
                                    Text="Paste multiple media URLs below (one URL per line) to process batch downloads."
                                    FontSize="14"
                                    Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </StackPanel>

                            <!-- Multi-line input -->
                            <Border
                                Grid.Row="1"
                                Width="720"
                                MinHeight="260"
                                Background="{DynamicResource AntigravityPanelBrush}"
                                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="4">
                                <TextBox
                                    AcceptsReturn="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Foreground="{DynamicResource AntigravityTextBrush}"
                                    Padding="12"
                                    Text="{Binding BatchInput}"
                                    Watermark="{Binding LocalizationManager.BatchInputPlaceholder}"
                                    Theme="{DynamicResource SoloTextBox}"
                                    MinHeight="250"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch" />
                            </Border>

                            <!-- Action Bar -->
                            <StackPanel
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="16"
                                Margin="0,16,0,0">
                                <ProgressBar
                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                    IsVisible="{Binding IsBusy}"
                                    Width="120"
                                    Height="4"
                                    VerticalAlignment="Center" />
                                <Button
                                    Command="{Binding ProcessBatchQueryCommand}"
                                    Background="{DynamicResource AntigravityAccentBrush}"
                                    Foreground="{DynamicResource AntigravityAccentForegroundBrush}"
                                    Theme="{DynamicResource MaterialFlatButton}"
                                    CornerRadius="20"
                                    Padding="20,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Download" Width="18" Height="18" />
                                        <TextBlock Text="{Binding LocalizationManager.ProcessBatchButton}" FontWeight="Bold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!--  DOWNLOADS MANAGER TAB  -->
                <Grid IsVisible="{Binding IsManagerTab}" RowDefinitions="Auto,*">
                    <!-- Manager Header & Status Filters -->
                    <Grid Grid.Row="0" Margin="32,16,32,12" ColumnDefinitions="*,Auto">
                        <!-- Status Filter Chips -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Command="{Binding SelectFilterAllCommand}"
                                Classes="filter-chip"
                                Classes.active="{Binding SelectedStatusFilter, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatusFilter.All}}">
                                <TextBlock Text="{Binding LocalizationManager.StatusFilterAll}" />
                            </Button>
                            <Button
                                Command="{Binding SelectFilterActiveCommand}"
                                Classes="filter-chip"
                                Classes.active="{Binding SelectedStatusFilter, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatusFilter.Active}}">
                                <TextBlock Text="{Binding LocalizationManager.StatusFilterActive}" />
                            </Button>
                            <Button
                                Command="{Binding SelectFilterCompletedCommand}"
                                Classes="filter-chip"
                                Classes.active="{Binding SelectedStatusFilter, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatusFilter.Completed}}">
                                <TextBlock Text="{Binding LocalizationManager.StatusFilterCompleted}" />
                            </Button>
                            <Button
                                Command="{Binding SelectFilterFailedCommand}"
                                Classes="filter-chip"
                                Classes.active="{Binding SelectedStatusFilter, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatusFilter.Failed}}">
                                <TextBlock Text="{Binding LocalizationManager.StatusFilterFailed}" />
                            </Button>
                        </StackPanel>

                        <!-- View Mode Switcher -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button
                                Command="{Binding ShowDownloadsListViewCommand}"
                                IsEnabled="{Binding !IsDownloadsListView}"
                                Theme="{DynamicResource MaterialFlatButton}"
                                Padding="6"
                                ToolTip.Tip="{Binding LocalizationManager.ListViewTooltip}">
                                <materialIcons:MaterialIcon Kind="ViewList" Width="20" Height="20" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </Button>
                            <Button
                                Command="{Binding ShowDownloadsGridViewCommand}"
                                IsEnabled="{Binding !IsDownloadsGridView}"
                                Theme="{DynamicResource MaterialFlatButton}"
                                Padding="6"
                                ToolTip.Tip="{Binding LocalizationManager.GridViewTooltip}">
                                <materialIcons:MaterialIcon Kind="ViewGrid" Width="20" Height="20" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Downloads List / Grid  -->
                    <Grid Grid.Row="1" Margin="32,0,32,24">
                        <Border
                            Background="{DynamicResource AntigravityPanelBrush}"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Panel>
                                <DataGrid
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ColumnWidth="Auto"
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding IsDownloadsListView}"
                                    ItemsSource="{Binding FilteredDownloads}"
                                    VerticalScrollBarVisibility="Visible">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding RemoveSuccessfulDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveSuccessful}" />
                                            <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveInactive}" />
                                            <Separator />
                                            <MenuItem Command="{Binding RestartFailedDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRestartFailed}" />
                                            <Separator />
                                            <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <!--  Thumbnail  -->
                                        <DataGridTemplateColumn>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border
                                                        Width="52"
                                                        Height="52"
                                                        ClipToBounds="True"
                                                        CornerRadius="6">
                                                        <Image
                                                            Stretch="UniformToFill"
                                                            asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!--  File name  -->
                                        <DataGridTemplateColumn
                                            Width="*"
                                            Header="{Binding #UserControl.DataContext.LocalizationManager.DownloadsFileColumnHeader}"
                                            SortMemberPath="FileName">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        FontSize="14"
                                                        Foreground="{DynamicResource AntigravityTextBrush}"
                                                        Text="{Binding FileName}"
                                                        TextWrapping="Wrap"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{Binding FileName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!--  Status  -->
                                        <DataGridTemplateColumn
                                            MinWidth="110"
                                            Header="{Binding #UserControl.DataContext.LocalizationManager.DownloadsStatusColumnHeader}"
                                            SortMemberPath="Progress.Current.Fraction">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="Auto,Auto">
                                                        <ProgressBar
                                                            Grid.Column="0"
                                                            Margin="0,0,6,0"
                                                            IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                            IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                            Theme="{DynamicResource MaterialCircularProgressBar}"
                                                            Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />

                                                        <TextBlock
                                                            x:Name="StatusTextBlock"
                                                            Grid.Column="1"
                                                            Classes.canceled="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Canceled}}"
                                                            Classes.completed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Completed}}"
                                                            Classes.enqueued="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Enqueued}}"
                                                            Classes.failed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Failed}}"
                                                            Classes.started="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                            PointerReleased="StatusTextBlock_OnPointerReleased"
                                                            TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock">
                                                                    <Style Selector="^.enqueued">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusEnqueued}" />
                                                                    </Style>
                                                                    <Style Selector="^.started">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AntigravityAccentBrush}" />
                                                                        <Setter Property="Text" Value="{Binding Progress.Current}" />
                                                                    </Style>
                                                                    <Style Selector="^.completed">
                                                                        <Setter Property="Foreground" Value="#247A3D" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCompleted}" />
                                                                    </Style>
                                                                    <Style Selector="^.canceled">
                                                                        <Setter Property="Foreground" Value="#A05D17" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCanceled}" />
                                                                    </Style>
                                                                    <Style Selector="^.failed">
                                                                        <Setter Property="Foreground" Value="#B33422" />
                                                                        <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusFailed}" />
                                                                        <Setter Property="ToolTip.Tip">
                                                                            <Template>
                                                                                <TextBlock>
                                                                                    <Run FontWeight="SemiBold" Text="{Binding LocalizationManager.ClickToCopyErrorTooltip}" />
                                                                                    <LineBreak />
                                                                                    <LineBreak />
                                                                                    <Run Text="{Binding ErrorMessage}" />
                                                                                </TextBlock>
                                                                            </Template>
                                                                        </Setter>
                                                                        <Setter Property="Cursor" Value="Hand" />
                                                                    </Style>
                                                                </Style>
                                                            </TextBlock.Styles>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!--  Buttons  -->
                                        <DataGridTemplateColumn MinWidth="116">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="4"
                                                            Command="{Binding ShowFileCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="22"
                                                                Height="22"
                                                                Kind="FileFindOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="4"
                                                            Command="{Binding OpenFileCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.PlayTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="22"
                                                                Height="22"
                                                                Kind="PlayCircleOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="4"
                                                            Command="{Binding CancelCommand}"
                                                            IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="22"
                                                                Height="22"
                                                                Kind="CloseCircleOutline" />
                                                        </Button>
                                                        <Button
                                                            Classes="download-action"
                                                            Padding="4"
                                                            Command="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).RestartDownloadCommand}"
                                                            CommandParameter="{Binding}"
                                                            IsVisible="{Binding IsCanceledOrFailed}"
                                                            Theme="{DynamicResource MaterialFlatButton}"
                                                            ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                            <materialIcons:MaterialIcon
                                                                Width="22"
                                                                Height="22"
                                                                Kind="Restart" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsVisible="{Binding IsDownloadsGridView}"
                                    SizeChanged="DownloadsGrid_OnSizeChanged"
                                    VerticalScrollBarVisibility="Auto">
                                    <ScrollViewer.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding RemoveSuccessfulDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveSuccessful}" />
                                            <MenuItem Command="{Binding RemoveInactiveDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRemoveInactive}" />
                                            <Separator />
                                            <MenuItem Command="{Binding RestartFailedDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuRestartFailed}" />
                                            <Separator />
                                            <MenuItem Command="{Binding CancelAllDownloadsCommand}" Header="{Binding LocalizationManager.ContextMenuCancelAll}" />
                                        </ContextMenu>
                                    </ScrollViewer.ContextMenu>

                                    <ItemsControl ItemsSource="{Binding FilteredDownloads}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Width="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).DownloadGridItemWidth}"
                                                    Height="184"
                                                    Margin="4"
                                                    Padding="8"
                                                    Background="{DynamicResource AntigravityPanelBrush}"
                                                    BorderBrush="{DynamicResource AntigravityBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                    <Grid RowDefinitions="Auto,*,Auto,Auto">
                                                        <Border
                                                            Grid.Row="0"
                                                            Height="88"
                                                            ClipToBounds="True"
                                                            CornerRadius="5">
                                                            <Image
                                                                Stretch="UniformToFill"
                                                                asyncImageLoader:ImageLoader.Source="{Binding Video, Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />
                                                        </Border>

                                                        <TextBlock
                                                            Grid.Row="1"
                                                            Margin="0,8,0,6"
                                                            FontSize="13"
                                                            Foreground="{DynamicResource AntigravityTextBrush}"
                                                            Text="{Binding FileName}"
                                                            TextTrimming="CharacterEllipsis"
                                                            ToolTip.Tip="{Binding FileName}" />

                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*">
                                                                <ProgressBar
                                                                    Grid.Column="0"
                                                                    Width="18"
                                                                    Height="18"
                                                                    Margin="0,0,6,0"
                                                                    IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                    IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                                    Theme="{DynamicResource MaterialCircularProgressBar}"
                                                                    Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />

                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    VerticalAlignment="Center"
                                                                    Classes.canceled="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Canceled}}"
                                                                    Classes.completed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Completed}}"
                                                                    Classes.enqueued="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Enqueued}}"
                                                                    Classes.failed="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Failed}}"
                                                                    Classes.started="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                                    FontSize="12"
                                                                    MaxWidth="96"
                                                                    PointerReleased="StatusTextBlock_OnPointerReleased"
                                                                    TextTrimming="CharacterEllipsis">
                                                                    <TextBlock.Styles>
                                                                        <Style Selector="TextBlock">
                                                                            <Style Selector="^.enqueued">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AntigravityMutedBrush}" />
                                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusEnqueued}" />
                                                                            </Style>
                                                                            <Style Selector="^.started">
                                                                                <Setter Property="Foreground" Value="{DynamicResource AntigravityAccentBrush}" />
                                                                                <Setter Property="Text" Value="{Binding Progress.Current}" />
                                                                            </Style>
                                                                            <Style Selector="^.completed">
                                                                                <Setter Property="Foreground" Value="#247A3D" />
                                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCompleted}" />
                                                                            </Style>
                                                                            <Style Selector="^.canceled">
                                                                                <Setter Property="Foreground" Value="#A05D17" />
                                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusCanceled}" />
                                                                            </Style>
                                                                            <Style Selector="^.failed">
                                                                                <Setter Property="Foreground" Value="#B33422" />
                                                                                <Setter Property="Text" Value="{Binding LocalizationManager.DownloadStatusFailed}" />
                                                                                <Setter Property="ToolTip.Tip">
                                                                                    <Template>
                                                                                        <TextBlock>
                                                                                            <Run FontWeight="SemiBold" Text="{Binding LocalizationManager.ClickToCopyErrorTooltip}" />
                                                                                            <LineBreak />
                                                                                            <LineBreak />
                                                                                            <Run Text="{Binding ErrorMessage}" />
                                                                                        </TextBlock>
                                                                                    </Template>
                                                                                </Setter>
                                                                                <Setter Property="Cursor" Value="Hand" />
                                                                            </Style>
                                                                        </Style>
                                                                    </TextBlock.Styles>
                                                                </TextBlock>
                                                            </Grid>

                                                            <StackPanel
                                                                Grid.Column="1"
                                                                HorizontalAlignment="Right"
                                                                Orientation="Horizontal">
                                                                <Button
                                                                    Classes="download-action"
                                                                    Padding="2"
                                                                    Command="{Binding ShowFileCommand}"
                                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    ToolTip.Tip="{Binding LocalizationManager.ShowFileTooltip}">
                                                                    <materialIcons:MaterialIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        Kind="FileFindOutline" />
                                                                </Button>
                                                                <Button
                                                                    Classes="download-action"
                                                                    Padding="2"
                                                                    Command="{Binding OpenFileCommand}"
                                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    ToolTip.Tip="{Binding LocalizationManager.PlayTooltip}">
                                                                    <materialIcons:MaterialIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        Kind="PlayCircleOutline" />
                                                                </Button>
                                                                <Button
                                                                    Classes="download-action"
                                                                    Padding="2"
                                                                    Command="{Binding CancelCommand}"
                                                                    IsVisible="{Binding $self.IsEffectivelyEnabled}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    ToolTip.Tip="{Binding LocalizationManager.CancelDownloadTooltip}">
                                                                    <materialIcons:MaterialIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        Kind="CloseCircleOutline" />
                                                                </Button>
                                                                <Button
                                                                    Classes="download-action"
                                                                    Padding="2"
                                                                    Command="{Binding $parent[UserControl].((components:DashboardViewModel)DataContext).RestartDownloadCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    IsVisible="{Binding IsCanceledOrFailed}"
                                                                    Theme="{DynamicResource MaterialFlatButton}"
                                                                    ToolTip.Tip="{Binding LocalizationManager.RestartDownloadTooltip}">
                                                                    <materialIcons:MaterialIcon
                                                                        Width="20"
                                                                        Height="20"
                                                                        Kind="Restart" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <ProgressBar
                                                            Grid.Row="3"
                                                            Height="2"
                                                            Margin="0,8,0,0"
                                                            IsVisible="{Binding Status, Converter={x:Static converters:EqualityConverter.IsEqual}, ConverterParameter={x:Static components:DownloadStatus.Started}}"
                                                            Value="{Binding Progress.Current.Fraction, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!--  Real-Time Hardware Usage & System Performance Status Bar  -->
            <Border
                Grid.Row="2"
                Background="{DynamicResource AntigravityRailBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Left: Real-time Hardware Metrics (CPU, RAM, GPU, VRAM, Temp) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <!-- CPU Usage -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="Real-time CPU Utilization">
                            <materialIcons:MaterialIcon Kind="Cpu64Bit" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ProgressBar
                                Value="{Binding CpuUsagePercent}"
                                Minimum="0"
                                Maximum="100"
                                Width="50"
                                Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuUsagePercent, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" Width="32" />
                        </StackPanel>

                        <Separator Width="1" Height="14" Background="{DynamicResource AntigravityBorderBrush}" />

                        <!-- RAM Usage -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="System Physical RAM Usage">
                            <materialIcons:MaterialIcon Kind="Memory" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ProgressBar
                                Value="{Binding RamUsagePercent}"
                                Minimum="0"
                                Maximum="100"
                                Width="50"
                                Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamUsageText}" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator Width="1" Height="14" Background="{DynamicResource AntigravityBorderBrush}" />

                        <!-- GPU Usage -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding GpuNameShort, StringFormat='GPU Compute Utilization ({0})'}">
                            <materialIcons:MaterialIcon Kind="ExpansionCardVariant" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ProgressBar
                                Value="{Binding GpuUsagePercent}"
                                Minimum="0"
                                Maximum="100"
                                Width="50"
                                Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuUsagePercent, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" Width="32" />
                            <TextBlock Text="{Binding GpuNameShort}" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <Separator Width="1" Height="14" Background="{DynamicResource AntigravityBorderBrush}" />

                        <!-- VRAM Usage -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="Dedicated GPU Video Memory (VRAM)">
                            <materialIcons:MaterialIcon Kind="Memory" Width="16" Height="16" Foreground="{DynamicResource AntigravityAccentBrush}" />
                            <TextBlock Text="VRAM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AntigravityMutedBrush}" VerticalAlignment="Center" />
                            <ProgressBar
                                Value="{Binding VramUsagePercent}"
                                Minimum="0"
                                Maximum="100"
                                Width="50"
                                Height="6"
                                CornerRadius="3"
                                VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VramUsageText}" FontSize="11" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- GPU Temp -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding HasGpuTemp}" ToolTip.Tip="GPU Core Temperature">
                            <Separator Width="1" Height="14" Background="{DynamicResource AntigravityBorderBrush}" Margin="0,0,6,0" />
                            <materialIcons:MaterialIcon Kind="Thermometer" Width="16" Height="16" Foreground="#FF9800" />
                            <TextBlock Text="{Binding GpuTemperatureC, StringFormat='{}{0}°C'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: RTX Tensor Engine Badge & Diagnostics -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button
                            Command="{Binding CopyHardwareDiagnosticsCommand}"
                            Padding="6,2"
                            CornerRadius="8"
                            Background="#0FFFFFFF"
                            BorderBrush="{DynamicResource AntigravityBorderBrush}"
                            BorderThickness="1"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="Copy Complete Hardware &amp; Module Diagnostics Report to Clipboard">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource AntigravityMutedBrush}" />
                                <TextBlock Text="Diagnostics" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AntigravityMutedBrush}" />
                            </StackPanel>
                        </Button>

                        <Border
                            IsVisible="{Binding HasRtx}"
                            Background="#1A10B981"
                            BorderBrush="#4010B981"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            ToolTip.Tip="Hardware Tensor Cores Detected &amp; Ready for Ultra-Fast Super-Resolution">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Kind="LightningBolt" Width="12" Height="12" Foreground="#10B981" />
                                <TextBlock Text="RTX Tensor Cores" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
</UserControl>

