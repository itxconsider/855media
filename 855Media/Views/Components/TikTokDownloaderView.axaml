<UserControl
    x:Class="_855Media.Views.Components.TikTokDownloaderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:_855Media.ViewModels.Components"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:DataType="components:TikTokDownloaderViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="880"
            Margin="48,44,48,24"
            HorizontalAlignment="Center"
            Spacing="24">

            <!-- Title & Branding -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Border
                    Width="60"
                    Height="60"
                    HorizontalAlignment="Center"
                    Background="#00F2FE"
                    CornerRadius="16">
                    <materialIcons:MaterialIcon
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="#111111"
                        Kind="Music" />
                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AntigravityTextBrush}"
                    Text="{Binding LocalizationManager.TikTokPromptTitle}" />
            </StackPanel>

            <!-- Query Box -->
            <StackPanel HorizontalAlignment="Center" Spacing="12">
                <Border
                    Width="680"
                    Height="48"
                    ClipToBounds="True"
                    Background="{DynamicResource AntigravityPanelBrush}"
                    BorderBrush="#00F2FE"
                    BorderThickness="1"
                    BoxShadow="0 4 16 0 #1A00F2FE"
                    CornerRadius="24">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox
                            Grid.Column="0"
                            Padding="20,0,12,0"
                            VerticalContentAlignment="Center"
                            AcceptsReturn="False"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="15"
                            Foreground="{DynamicResource AntigravityTextBrush}"
                            Text="{Binding Query}"
                            Theme="{DynamicResource SoloTextBox}"
                            Watermark="{Binding LocalizationManager.TikTokWatermark}" />

                        <Button
                            Grid.Column="1"
                            Width="64"
                            VerticalAlignment="Stretch"
                            Background="#00F2FE"
                            Command="{Binding ProcessQueryCommand}"
                            CornerRadius="0,24,24,0"
                            Foreground="#111111"
                            IsDefault="True"
                            Theme="{DynamicResource MaterialFlatButton}">
                            <materialIcons:MaterialIcon Width="22" Height="22" Kind="Download" />
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- TikTok Features Overview Cards -->
            <UniformGrid Columns="3" Width="720" Margin="0,16,0,0">
                <Border Margin="6" Padding="16" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <materialIcons:MaterialIcon Kind="Video" Width="24" Height="24" Foreground="#00F2FE" />
                        <TextBlock Text="No Watermark" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AntigravityTextBrush}" />
                        <TextBlock Text="Clean video downloads without TikTok watermark overlays." FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="16" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <materialIcons:MaterialIcon Kind="ImageMultiple" Width="24" Height="24" Foreground="#00F2FE" />
                        <TextBlock Text="Slideshow &amp; Photo Posts" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AntigravityTextBrush}" />
                        <TextBlock Text="Download full photo slideshows and multi-image posts." FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="16" Background="{DynamicResource AntigravityPanelBrush}" BorderBrush="{DynamicResource AntigravityBorderBrush}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Spacing="8">
                        <materialIcons:MaterialIcon Kind="MusicNote" Width="24" Height="24" Foreground="#00F2FE" />
                        <TextBlock Text="Audio Extraction" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AntigravityTextBrush}" />
                        <TextBlock Text="Extract original soundtrack audio in high quality." FontSize="12" Foreground="{DynamicResource AntigravityMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

