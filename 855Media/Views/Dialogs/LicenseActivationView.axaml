<UserControl
    x:Class="_855Media.Views.Dialogs.LicenseActivationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dialogs="clr-namespace:_855Media.ViewModels.Dialogs"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    Width="560"
    x:DataType="dialogs:LicenseActivationViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <DockPanel Grid.Row="0" Margin="20,16,20,12">
            <materialIcons:MaterialIcon
                Width="28"
                Height="28"
                Margin="0,0,12,0"
                Foreground="#0091EA"
                Kind="KeyVariant" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold"
                Text="855Media License &amp; Activation" />
        </DockPanel>

        <!--  Body  -->
        <Border
            Grid.Row="1"
            Padding="20,12"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            BorderThickness="0,1">
            <StackPanel Spacing="16">
                <!--  Status Card  -->
                <Border
                    Padding="14"
                    Background="{DynamicResource MaterialCardBackgroundBrush}"
                    BorderBrush="{DynamicResource MaterialDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <TextBlock
                                FontWeight="Bold"
                                Text="Current Status:"
                                VerticalAlignment="Center" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Background="#1877F2"
                                CornerRadius="12">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="{Binding StatusBadgeText}" />
                            </Border>
                        </DockPanel>
                        <TextBlock
                            FontSize="12"
                            Opacity="0.85"
                            Text="{Binding LicenseDetailsText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  License Input  -->
                <StackPanel Spacing="6">
                    <DockPanel>
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="License Key or Token:"
                            VerticalAlignment="Center" />
                        <Button
                            Command="{Binding BrowseLicenseFileCommand}"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right"
                            Theme="{DynamicResource MaterialFlatButton}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <materialIcons:MaterialIcon Width="16" Height="16" Kind="FolderOpen" />
                                <TextBlock FontSize="12" Text="Load File (.lic)..." />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                    <TextBox
                        Height="75"
                        AcceptsReturn="True"
                        Text="{Binding LicenseKeyInput}"
                        TextWrapping="Wrap"
                        Watermark="Paste your license key or signed .lic token here..." />
                </StackPanel>

                <!--  Device ID for Offline Key Generation  -->
                <Border
                    Padding="10,8"
                    Background="{DynamicResource MaterialBodyLightBrush}"
                    CornerRadius="6">
                    <DockPanel>
                        <Button
                            Command="{Binding CopyMachineFingerprintCommand}"
                            DockPanel.Dock="Right"
                            Theme="{DynamicResource MaterialFlatButton}"
                            ToolTip.Tip="Copy Device ID">
                            <materialIcons:MaterialIcon Width="16" Height="16" Kind="ContentCopy" />
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontSize="10"
                                Opacity="0.65"
                                Text="Your Unique Device ID (for offline license binding):" />
                            <TextBlock
                                FontFamily="Consolas, monospace"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="{Binding MachineFingerprint}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  Status/Error Message  -->
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#00C853"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  Action Buttons  -->
        <DockPanel Grid.Row="2" Margin="16,12">
            <!--  Buy License Link  -->
            <Button
                Command="{Binding OpenPurchasePageCommand}"
                DockPanel.Dock="Left"
                Theme="{DynamicResource MaterialFlatButton}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <materialIcons:MaterialIcon Width="16" Height="16" Kind="OpenInNew" />
                    <TextBlock Text="Buy License" />
                </StackPanel>
            </Button>

            <!--  Deactivate Button (only visible if active)  -->
            <Button
                Margin="8,0,0,0"
                Command="{Binding DeactivateCommand}"
                DockPanel.Dock="Left"
                IsVisible="{Binding IsActivated}"
                Theme="{DynamicResource MaterialFlatButton}">
                <TextBlock Foreground="#FF5252" Text="Deactivate" />
            </Button>

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <!--  Close  -->
                <Button
                    Command="{Binding CloseDialogCommand}"
                    IsCancel="True"
                    Theme="{DynamicResource MaterialOutlineButton}">
                    <TextBlock Text="Close" />
                </Button>

                <!--  Activate Button  -->
                <Button
                    Command="{Binding ActivateCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    Theme="{DynamicResource MaterialButton}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Width="16" Height="16" Kind="Check" />
                        <TextBlock Text="Activate" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
