<UserControl
    x:Class="_855Media.Views.Dialogs.DownloadMultipleSetupView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
    xmlns:converters="clr-namespace:_855Media.Converters"
    xmlns:dialogs="clr-namespace:_855Media.ViewModels.Dialogs"
    xmlns:materialAssists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    x:Name="UserControl"
    Width="1080"
    MinWidth="552"
    MaxWidth="1080"
    x:DataType="dialogs:DownloadMultipleSetupViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
        <!--  Title & Profile Header  -->
        <StackPanel Grid.Row="0" Margin="16,16,16,8" Spacing="10">
            <TextBlock
                FontSize="19"
                Text="{Binding Title}"
                TextTrimming="CharacterEllipsis">
                <TextBlock.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="{Binding CopyTitleCommand}" Header="{Binding LocalizationManager.CopyMenuItem}" />
                    </ContextMenu>
                </TextBlock.ContextMenu>
            </TextBlock>

            <!-- Creator / Channel Profile Header -->
            <Border
                IsVisible="{Binding HasProfilePicture}"
                Padding="12,8"
                Background="{DynamicResource AntigravityElevatedBrush}"
                BorderBrush="{DynamicResource AntigravityBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        CornerRadius="18"
                        ClipToBounds="True"
                        Background="#2A2A32"
                        Margin="0,0,12,0">
                        <Image asyncImageLoader:ImageLoader.Source="{Binding ProfilePictureUrl}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AuthorName, FallbackValue='Creator Profile'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AntigravityTextBrush}" />
                        <TextBlock Text="Creator / Channel Profile Detected" FontSize="11" Foreground="{DynamicResource AntigravityMutedBrush}" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        Background="#1E10B981"
                        BorderBrush="#4010B981"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="8,3"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon Kind="AccountCheck" Width="14" Height="14" Foreground="#10B981" />
                            <TextBlock Text="Avatar Ready" FontSize="11" FontWeight="SemiBold" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>

        <!--  Selection filter  -->
        <Grid
            Grid.Row="1"
            Margin="16,0,16,16"
            ColumnDefinitions="*,*,Auto">
            <ComboBox
                Grid.Column="0"
                Margin="0,0,8,0"
                materialAssists:ComboBoxAssist.Label="{Binding LocalizationManager.VideoTypeLabel}"
                ItemsSource="{Binding AvailableVideoTypeFilters}"
                SelectedItem="{Binding SelectedVideoTypeFilter}"
                Theme="{DynamicResource MaterialFilledComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <ComboBox
                Grid.Column="1"
                Margin="0,0,8,0"
                materialAssists:ComboBoxAssist.Label="Popularity"
                ItemsSource="{Binding AvailableVideoPopularityFilters}"
                SelectedItem="{Binding SelectedVideoPopularityFilter}"
                Theme="{DynamicResource MaterialFilledComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static converters:EnumDisplayNameConverter.Instance}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Button
                    Padding="8"
                    Command="{Binding ShowListViewCommand}"
                    IsEnabled="{Binding !IsListView}"
                    Theme="{DynamicResource MaterialFlatButton}"
                    ToolTip.Tip="{Binding LocalizationManager.ListViewTooltip}">
                    <materialIcons:MaterialIcon
                        Width="24"
                        Height="24"
                        Kind="ViewList" />
                </Button>
                <Button
                    Padding="8"
                    Command="{Binding ShowGridViewCommand}"
                    IsEnabled="{Binding !IsGridView}"
                    Theme="{DynamicResource MaterialFlatButton}"
                    ToolTip.Tip="{Binding LocalizationManager.GridViewTooltip}">
                    <materialIcons:MaterialIcon
                        Width="24"
                        Height="24"
                        Kind="ViewGrid" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  Quick selection  -->
        <StackPanel
            Grid.Row="2"
            Margin="16,0,16,8"
            Orientation="Horizontal"
            Spacing="8">
            <TextBlock VerticalAlignment="Center" Text="Quick select:" />
            <Button
                Command="{Binding SelectTop5Command}"
                Content="Top 5"
                Theme="{DynamicResource MaterialOutlineButton}" />
            <Button
                Command="{Binding SelectTop10Command}"
                Content="Top 10"
                Theme="{DynamicResource MaterialOutlineButton}" />
            <Button
                Command="{Binding SelectTop20Command}"
                Content="Top 20"
                Theme="{DynamicResource MaterialOutlineButton}" />
        </StackPanel>

        <!--  Videos  -->
        <Border
            Grid.Row="3"
            BorderBrush="{DynamicResource MaterialDividerBrush}"
            BorderThickness="0,1">
            <ListBox
                Classes.grid="{Binding IsGridView}"
                ItemsSource="{Binding AvailableVideos}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectedItems="{Binding SelectedVideos}"
                SelectionMode="Multiple,Toggle">
                <ListBox.Styles>
                    <Style Selector="ListBox">
                        <Style Selector="^ ListBoxItem">
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                        <Style Selector="^.grid">
                            <Setter Property="ItemsPanel">
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="^.grid ListBoxItem">
                            <Setter Property="Width" Value="176" />
                            <Setter Property="MinHeight" Value="184" />
                        </Style>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <!--  List item  -->
                            <Grid
                                Margin="0,0,8,0"
                                ColumnDefinitions="Auto,*,Auto"
                                IsVisible="{Binding $parent[UserControl].((dialogs:DownloadMultipleSetupViewModel)DataContext).IsListView}">
                                <!--  Thumbnail  -->
                                <Image
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    asyncImageLoader:ImageLoader.Source="{Binding Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />

                                <!--  Info  -->
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Orientation="Vertical"
                                    Spacing="8">
                                    <!--  Title  -->
                                    <TextBlock
                                        FontSize="16"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Title}" />

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!--  Author  -->
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon
                                                Width="16"
                                                Height="16"
                                                BorderThickness="1"
                                                Kind="UserOutline" />
                                            <TextBlock
                                                FontWeight="Light"
                                                Text="{Binding AuthorTitle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--  Duration  -->
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon
                                                Width="16"
                                                Height="16"
                                                BorderThickness="1"
                                                Kind="ClockOutline" />
                                            <TextBlock
                                                FontWeight="Light"
                                                Text="{Binding Duration, TargetNullValue=Live}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!--  Checkmark  -->
                                <materialIcons:MaterialIcon
                                    Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Margin="8,0,0,0"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}"
                                    Kind="Check" />
                            </Grid>

                            <!--  Grid item  -->
                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                IsVisible="{Binding $parent[UserControl].((dialogs:DownloadMultipleSetupViewModel)DataContext).IsGridView}">
                                <Border
                                    Grid.Row="0"
                                    Width="160"
                                    Height="90"
                                    ClipToBounds="True"
                                    CornerRadius="4">
                                    <Image
                                        Stretch="UniformToFill"
                                        asyncImageLoader:ImageLoader.Source="{Binding Converter={x:Static converters:VideoToLowestQualityThumbnailUrlStringConverter.Instance}}" />
                                </Border>

                                <!--  Checkmark  -->
                                <Border
                                    Grid.Row="0"
                                    Width="28"
                                    Height="28"
                                    Margin="4"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource MaterialSecondaryMidBrush}"
                                    CornerRadius="14"
                                    IsVisible="{Binding $parent[ListBoxItem].IsSelected, Mode=OneWay}">
                                    <materialIcons:MaterialIcon
                                        Width="20"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource MaterialSecondaryMidForegroundBrush}"
                                        Kind="Check" />
                                </Border>

                                <!--  Title  -->
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    FontSize="14"
                                    MaxLines="2"
                                    Text="{Binding Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    ToolTip.Tip="{Binding Title}" />

                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,6,0,0"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <!--  Author  -->
                                    <StackPanel
                                        MinWidth="0"
                                        Orientation="Horizontal"
                                        Spacing="3">
                                        <materialIcons:MaterialIcon
                                            Width="16"
                                            Height="16"
                                            BorderThickness="1"
                                            Kind="UserOutline" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Light"
                                            Text="{Binding AuthorTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  Duration  -->
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <materialIcons:MaterialIcon
                                            Width="16"
                                            Height="16"
                                            BorderThickness="1"
                                            Kind="ClockOutline" />
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="Light"
                                            Text="{Binding Duration, TargetNullValue=Live}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--  Preferences  -->
        <StackPanel
            Grid.Row="4"
            Margin="8,4">
            <UniformGrid Columns="2">
                <!--  Container preference  -->
                <ComboBox
                    Margin="8"
                    materialAssists:ComboBoxAssist.Label="{Binding LocalizationManager.ContainerLabel}"
                    ItemsSource="{Binding AvailableContainers}"
                    SelectedItem="{Binding SelectedContainer}"
                    Theme="{DynamicResource MaterialFilledComboBox}" />

                <!--  Video quality preference  -->
                <ComboBox
                    Margin="8"
                    materialAssists:ComboBoxAssist.Label="{Binding LocalizationManager.VideoQualityLabel}"
                    IsEnabled="{Binding !SelectedContainer.IsAudioOnly}"
                    ItemsSource="{Binding AvailableVideoQualityPreferences}"
                    SelectedItem="{Binding SelectedVideoQualityPreference}"
                    Theme="{DynamicResource MaterialFilledComboBox}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static converters:VideoQualityPreferenceToStringConverter.Instance}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </UniformGrid>

            <!--  Translate captions to English  -->
            <CheckBox
                Margin="8,4,8,4"
                Content="{Binding LocalizationManager.TranslateCaptionsToEnglishLabel}"
                IsChecked="{Binding ShouldTranslateCaptionsToEnglish}"
                IsEnabled="{Binding !SelectedContainer.IsAudioOnly}"
                ToolTip.Tip="{Binding LocalizationManager.TranslateCaptionsToEnglishTooltip}" />

            <!--  Translate title & caption to English  -->
            <CheckBox
                Margin="8,0,8,8"
                Content="{Binding LocalizationManager.TranslateTitleToEnglishLabel}"
                IsChecked="{Binding ShouldTranslateTitleToEnglish}"
                ToolTip.Tip="{Binding LocalizationManager.TranslateTitleToEnglishTooltip}" />

            <!--  Download profile picture (Avatar)  -->
            <CheckBox
                Margin="8,0,8,8"
                Content="Download Creator / Channel Profile Picture (Avatar)"
                IsVisible="{Binding HasProfilePicture}"
                IsChecked="{Binding ShouldDownloadProfilePicture}"
                ToolTip.Tip="Saves the channel or creator's high-resolution profile picture (avatar.jpg) to the destination folder." />
        </StackPanel>

        <!--  Buttons  -->
        <UniformGrid
            Grid.Row="5"
            Margin="8"
            Columns="2">
            <!--  Download  -->
            <Button
                Margin="8"
                Command="{Binding ConfirmCommand}"
                IsDefault="True"
                Theme="{DynamicResource MaterialOutlineButton}">
                <Button.Content>
                    <TextBlock>
                        <Run Text="{Binding LocalizationManager.DownloadButton}" />
                        <Run Text="(" /><Run Text="{Binding SelectedVideos.Count, FallbackValue=0, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>
                </Button.Content>
            </Button>

            <!--  Cancel  -->
            <Button
                Margin="8"
                Command="{Binding CloseCommand}"
                Content="{Binding LocalizationManager.CancelButton}"
                IsCancel="True"
                Theme="{DynamicResource MaterialOutlineButton}" />
        </UniformGrid>
    </Grid>
</UserControl>

