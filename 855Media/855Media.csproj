<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>855Media</AssemblyName>
    <Product>855Media</Product>
    <ApplicationIcon>../favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Trimmed builds break support for Windows 10 for some reason -->
    <!-- https://github.com/Tyrrrz/MediaTag/issues/496 -->
    <PublishTrimmed>false</PublishTrimmed>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <PublishMacOSBundle>false</PublishMacOSBundle>
  </PropertyGroup>

  <PropertyGroup>
    <EncryptionSalt>HimalayanPinkSalt</EncryptionSalt>
  </PropertyGroup>

  <ItemGroup>
    <Content
      Include="../tools/atx/bin/atx-agent;../tools/atx/bin/ADBKeyboard.apk;../tools/atx/bin/LICENSE;../tools/atx/bin/README.md"
      Link="tools/atx/bin/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <ItemGroup>
    <Content
      Include="../tools/ffmpeg/ffprobe.exe;../tools/ffmpeg/LICENSE.txt;../tools/ffmpeg/README.txt"
      Link="tools/ffmpeg/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Target Name="ValidateFFprobeTool" BeforeTargets="Publish">
    <Error
      Condition="!Exists('$(ProjectDir)../tools/ffmpeg/ffprobe.exe')"
      Text="Missing tools/ffmpeg/ffprobe.exe. Restore FFprobe before publishing a fresh-PC package."
    />
  </Target>
  <ItemGroup>
    <Content
      Include="../tools/885helper/885Helper.apk;../tools/885helper/README.md"
      Link="tools/885helper/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>
  <Target Name="Validate885Helper" BeforeTargets="Publish">
    <Error
      Condition="!Exists('$(ProjectDir)../tools/885helper/885Helper.apk')"
      Text="Build android/885Helper/build.ps1 before publishing; 885Helper.apk is required."
    />
  </Target>
  <Target Name="ValidateAndroidSetupTools" BeforeTargets="Publish">
    <Error
      Condition="!Exists('$(ProjectDir)../tools/atx/bin/atx-agent')"
      Text="Missing atx-agent. Restore tools/atx/bin/atx-agent before publishing; a new-PC package must include Android UI setup tools."
    />
    <Error
      Condition="!Exists('$(ProjectDir)../tools/atx/bin/ADBKeyboard.apk')"
      Text="Missing ADBKeyboard.apk. Restore tools/atx/bin/ADBKeyboard.apk before publishing."
    />
  </Target>

  <ItemGroup>
    <!-- Expose this property in code -->
    <ProjectProperty Include="EncryptionSalt" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../favicon.ico" Link="favicon.ico" />
    <EmbeddedResource Include="Resources/facebook-scraper-bridge.js" />
    <EmbeddedResource Include="Resources/facebook-photo-detail.js" />
    <EmbeddedResource Include="Resources/facebook-photo-caption.js" />
    <Content
      Include="Resources/facebook-layouts.default.json"
      Link="layouts/facebook-layouts.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="../tools/whisper/**/*"
      Link="tools/whisper/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../tools/voxcpm_tts.py"
      Link="tools/voxcpm_tts.py"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../tools/rvc/infer_cli.py;../tools/rvc/README.md"
      Link="tools/rvc/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../tools/meta_dubbing/worker.py;../tools/meta_dubbing/README.md"
      Link="tools/meta_dubbing/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="AsyncImageLoader.Avalonia" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Cogwheel" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Deorcify" PrivateAssets="all" />
    <PackageReference Include="DialogHost.Avalonia" />
    <PackageReference Include="Gress" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Avalonia.DataGrid" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Onova" />
    <PackageReference Include="PowerKit" />
    <PackageReference Include="ThisAssembly.Project" PrivateAssets="all" />
    <PackageReference Include="WebView.Avalonia" />
    <PackageReference Include="WebView.Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../855Media.Core/855Media.Core.csproj" />
  </ItemGroup>

  <!-- Avalonia.WebView is completely incompatible with trimming -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Avalonia.WebView" />
    <TrimmerRootAssembly Include="Avalonia.WebView.Desktop" />
    <TrimmerRootAssembly Include="Avalonia.WebView.Linux" />
    <TrimmerRootAssembly Include="Avalonia.WebView.MacCatalyst" />
    <TrimmerRootAssembly Include="Avalonia.WebView.Windows" />
    <TrimmerRootAssembly Include="AvaloniaWebView.Shared" />
    <TrimmerRootAssembly Include="Linux.WebView.Core" />
    <TrimmerRootAssembly Include="Microsoft.Web.WebView2.Core" />
    <TrimmerRootAssembly Include="WebView.Avalonia" />
    <TrimmerRootAssembly Include="WebView.Core" />
  </ItemGroup>

  <!-- Publish macOS bundle -->
  <Target Name="PublishMacOSBundle" AfterTargets="Publish" Condition="$(PublishMacOSBundle)">
    <Exec
      Command="dotnet run --file &quot;$(ProjectDir)PublishMacOSBundle.csx&quot; -- --publish-dir &quot;$(PublishDir.TrimEnd('\').TrimEnd('/'))&quot; --icons-file &quot;$(ProjectDir)../favicon.icns&quot; --full-version $(Version) --short-version $(AssemblyVersion)"
      LogStandardErrorAsError="true"
    />
  </Target>
</Project>
